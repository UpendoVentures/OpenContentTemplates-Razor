    function showError(options) {
        options = options || {};

        var heading = root.querySelector('[data-error-heading]');
        var text = root.querySelector('[data-error-text]');
        var technical = root.querySelector('[data-error-technical]');
        var retryButton = root.querySelector('[data-retry-button]');
        var supportLink = root.querySelector('[data-error-support-link]');

        if (heading) {
            heading.textContent = options.heading || defaultErrorHeading || 'Membership details are temporarily unavailable.';
        }

        if (text) {
            text.textContent = options.message || 'Please try again later or contact support if the problem persists.';
        }

        if (technical) {
            if (options.technicalMessage) {
                technical.textContent = options.technicalMessage;
                technical.hidden = false;
            } else {
                technical.textContent = '';
                technical.hidden = true;
            }
        }

        if (retryButton) {
            retryButton.hidden = options.hideRetry === true;
        }

        if (supportLink) {
            supportLink.hidden = !hasValue(normalizeSupportHref(supportAddress));
        }

        showState('error');
    }

    function showServiceUnavailableError(statusCode) {
        var message = 'Membership billing tools are temporarily unavailable. Your website account is still accessible, but billing details cannot be loaded right now.';

        if (statusCode === 404) {
            message = 'Membership billing tools are not available on this site yet. Your website account is still accessible, but billing details cannot be loaded until the supporting service is installed.';
        } else if (statusCode === 401 || statusCode === 403) {
            message = 'Please sign in with the member account that is connected to your membership billing record.';
        } else if (statusCode >= 500) {
            message = 'Membership billing tools are temporarily unavailable. Please try again later or contact support if the issue continues.';
        }

        showError({
            heading: 'Membership billing is temporarily unavailable.',
            message: message,
            technicalMessage: statusCode ? 'Status code: ' + statusCode : '',
            hideRetry: statusCode === 404
        });
    }

    function showActionWarning(message) {
        var alert = root.querySelector('[data-status-alert]');
        var heading = root.querySelector('[data-status-alert-heading]');
        var text = root.querySelector('[data-status-alert-text]');

        if (!alert || !heading || !text) {
            showError({
                heading: 'Billing action unavailable.',
                message: message || 'We could not open the secure billing portal. Please try again later.'
            });
            return;
        }

        alert.className = 'upendo-membership-dashboard__status-alert upendo-membership-dashboard__status-alert-danger mb-4';
        heading.textContent = 'Billing action unavailable';
        text.textContent = message || 'We could not open the secure billing portal. Please try again later or contact support.';
        alert.hidden = false;

        alert.scrollIntoView({
            behavior: 'smooth',
            block: 'nearest'
        });
    }

    function getServicesFramework() {
        try {
            if (window.jQuery && window.jQuery.ServicesFramework) {
                return window.jQuery.ServicesFramework(moduleId);
            }

            if (window.$ && window.$.ServicesFramework) {
                return window.$.ServicesFramework(moduleId);
            }
        } catch (ex) {
            return null;
        }

        return null;
    }

    function getBaseUrl() {
        var sf = getServicesFramework();

        try {
            if (sf && sf.getServiceRoot) {
                return sf.getServiceRoot('OpenContentHelper') + 'MembershipDashboard/';
            }
        } catch (ex) {
            // Fall through to the platform route below.
        }

        return '/DesktopModules/OpenContentHelper/API/MembershipDashboard/';
    }

    function getHeaders() {
        var headers = {
            'Accept': 'application/json',
            'Content-Type': 'application/json'
        };

        var sf = getServicesFramework();

        if (sf) {
            try {
                if (sf.getAntiForgeryValue) {
                    headers.RequestVerificationToken = sf.getAntiForgeryValue();
                }

                headers.ModuleId = moduleId;
                headers.TabId = tabId;
            } catch (ex) {
                // Missing framework metadata should not prevent a graceful failure.
            }
        }

        return headers;
    }

    function fetchJson(url, options) {
        if (!window.fetch || !window.Promise) {
            return {
                then: function () {
                    return this;
                },
                catch: function (callback) {
                    callback({
                        status: 0,
                        message: 'This browser does not support the required request features.'
                    });
                }
            };
        }

        options = options || {};
        options.credentials = options.credentials || 'same-origin';
        options.headers = options.headers || getHeaders();

        return window.fetch(url, options).then(function (response) {
            var contentType = response.headers ? response.headers.get('content-type') : '';

            if (!response.ok) {
                var error = new Error('Request failed.');
                error.status = response.status;
                error.statusText = response.statusText || '';
                throw error;
            }

            if (!contentType || contentType.indexOf('application/json') === -1) {
                return response.text().then(function (bodyText) {
                    if (!bodyText) {
                        return {};
                    }

                    try {
                        return JSON.parse(bodyText);
                    } catch (ex) {
                        var parseError = new Error('The service returned an invalid response.');
                        parseError.status = response.status;
                        throw parseError;
                    }
                });
            }

            return response.json();
        });
    }

    function setBadge(element, status) {
        if (!element) {
            return;
        }

        var normalized = safeTrim(status).toLowerCase();

        element.className = 'badge upendo-membership-dashboard__status-badge';

        if (normalized === 'active' || normalized === 'current' || normalized === 'paid') {
            element.className += ' upendo-membership-dashboard__status-badge-success';
        } else if (normalized === 'past_due' || normalized === 'past due' || normalized === 'payment needed' || normalized === 'unpaid') {
            element.className += ' upendo-membership-dashboard__status-badge-warning';
        } else if (normalized === 'canceled' || normalized === 'cancelled' || normalized === 'incomplete_expired') {
            element.className += ' upendo-membership-dashboard__status-badge-danger';
        } else {
            element.className += ' upendo-membership-dashboard__status-badge-info';
        }
    }

        function getMembershipHeroEffectClass(data) {
        var localMembershipStatus = getValue(data, 'localMembershipStatus', 'LocalMembershipStatus', '');
        var stripeStatus = getValue(data, 'stripeStatus', 'StripeStatus', '');
        var accountStatusDisplay = getValue(data, 'accountStatusDisplay', 'AccountStatusDisplay', '');
        var latestInvoiceStatusDisplay = getValue(data, 'latestInvoiceStatusDisplay', 'LatestInvoiceStatusDisplay', '');
        var requiresPaymentAction = getBooleanValue(data, 'requiresPaymentAction', 'RequiresPaymentAction');
        var cancelAtPeriodEnd = getBooleanValue(data, 'cancelAtPeriodEnd', 'CancelAtPeriodEnd');

        var statusText = safeTrim(
            localMembershipStatus + ' ' +
            stripeStatus + ' ' +
            accountStatusDisplay + ' ' +
            latestInvoiceStatusDisplay
        ).toLowerCase();

        /*
            Priority matters:
            1. Danger states should win.
            2. Grace / warning states come next.
            3. Active/current states get the shine only when no warning flags exist.
        */

        if (
            requiresPaymentAction ||
            /canceled|cancelled|expired|overdue|unpaid|incomplete_expired|incomplete/.test(statusText)
        ) {
            return 'upendo-membership-dashboard__hero-card--effect-danger';
        }

        if (
            cancelAtPeriodEnd ||
            /grace|pastdue|past_due|past due|payment needed|payment_required|payment required/.test(statusText)
        ) {
            return 'upendo-membership-dashboard__hero-card--effect-warning';
        }

        if (/active|current|paid|trialing/.test(statusText)) {
            return 'upendo-membership-dashboard__hero-card--effect-shine';
        }

        return '';
    }

    function clearMembershipHeroEffectInterval() {
        if (membershipHeroEffectInterval) {
            window.clearInterval(membershipHeroEffectInterval);
            membershipHeroEffectInterval = null;
        }
    }

    function clearMembershipHeroEffectClasses(heroCard) {
        if (!heroCard) {
            return;
        }

        heroCard.className = heroCard.className
            .replace(/\s?upendo-membership-dashboard__hero-card--effect-shine/g, '')
            .replace(/\s?upendo-membership-dashboard__hero-card--effect-warning/g, '')
            .replace(/\s?upendo-membership-dashboard__hero-card--effect-danger/g, '')
            .replace(/\s?upendo-membership-dashboard__hero-card--effect-complete/g, '');
    }

    function playMembershipHeroEffect(effectClass) {
        var heroCard = root.querySelector('[data-membership-hero-card]');

        if (!heroCard || !effectClass) {
            return;
        }

        clearMembershipHeroEffectClasses(heroCard);

        /*
            Force the browser to recognize the class change even if the dashboard
            is re-rendered quickly after the AJAX response.
        */
        void heroCard.offsetWidth;

        heroCard.className += ' ' + effectClass;

        window.setTimeout(function () {
            if (!heroCard) {
                return;
            }

            heroCard.className = heroCard.className
                .replace(/\s?upendo-membership-dashboard__hero-card--effect-shine/g, '')
                .replace(/\s?upendo-membership-dashboard__hero-card--effect-warning/g, '')
                .replace(/\s?upendo-membership-dashboard__hero-card--effect-danger/g, '');

            heroCard.className += ' upendo-membership-dashboard__hero-card--effect-complete';
        }, 2200);
    }

    function runMembershipHeroEffect(data) {
        if (!data) {
            clearMembershipHeroEffectInterval();
            return;
        }

        var effectClass = getMembershipHeroEffectClass(data);

        clearMembershipHeroEffectInterval();

        if (!effectClass) {
            return;
        }

        /*
            Always play the first effect immediately after the dashboard loads.
        */
        playMembershipHeroEffect(effectClass);

        /*
            Only the positive/active shine repeats.
            Warning and danger pulses remain one-time signals so they do not feel alarming or annoying.
        */
        if (effectClass === 'upendo-membership-dashboard__hero-card--effect-shine') {
            membershipHeroEffectInterval = window.setInterval(function () {
                playMembershipHeroEffect(effectClass);
            }, 30000);
        }
    }

    function configureStatusAlert(data) {
        var alert = root.querySelector('[data-status-alert]');
        var heading = root.querySelector('[data-status-alert-heading]');
        var text = root.querySelector('[data-status-alert-text]');

        if (!alert || !heading || !text) {
            return;
        }

        var localMembershipStatus = getValue(data, 'localMembershipStatus', 'LocalMembershipStatus', '');
        var stripeStatus = getValue(data, 'stripeStatus', 'StripeStatus', '');
        var requiresPaymentAction = getBooleanValue(data, 'requiresPaymentAction', 'RequiresPaymentAction');
        var cancelAtPeriodEnd = getBooleanValue(data, 'cancelAtPeriodEnd', 'CancelAtPeriodEnd');
        var nextRenewalDisplay = getValue(data, 'nextRenewalDisplay', 'NextRenewalDisplay', '');

        alert.className = 'upendo-membership-dashboard__status-alert mb-4';

        if (requiresPaymentAction) {
            alert.className += ' upendo-membership-dashboard__status-alert--danger';
            heading.textContent = 'Payment attention required';
            text.textContent = 'Your membership is active, but Stripe reports that payment action is required.';
            setHidden(alert, false);
            return;
        }

        if (cancelAtPeriodEnd) {
            alert.className += ' upendo-membership-dashboard__status-alert--warning';
            heading.textContent = 'Membership cancellation scheduled';
            text.textContent = nextRenewalDisplay
                ? 'Your membership will remain active until ' + nextRenewalDisplay + '.'
                : 'Your membership will remain active until the current billing period ends.';
            setHidden(alert, false);
            return;
        }

        if (/pastdue|past_due|grace/i.test(localMembershipStatus + ' ' + stripeStatus)) {
            alert.className += ' upendo-membership-dashboard__status-alert--warning';
            heading.textContent = 'Payment grace period';
            text.textContent = 'Your membership is in a payment grace period. Please update your billing details to avoid interruption.';
            setHidden(alert, false);
            return;
        }

        if (/canceled|expired|unpaid/i.test(localMembershipStatus + ' ' + stripeStatus)) {
            alert.className += ' upendo-membership-dashboard__status-alert--danger';
            heading.textContent = 'Membership inactive';
            text.textContent = 'Your membership is not currently active. Please renew or contact support for help.';
            setHidden(alert, false);
            return;
        }

        setHidden(alert, true);
    }

    function renderInvoices(invoices) {
        invoices = Object.prototype.toString.call(invoices) === '[object Array]'
            ? invoices
            : [];

        if (!invoiceBody || !invoiceEmpty) {
            return;
        }

        invoiceBody.innerHTML = '';

        if (!invoices.length) {
            setHidden(invoiceEmpty, false);
            return;
        }

        setHidden(invoiceEmpty, true);

        invoices.forEach(function (invoice) {
            var invoiceId = getValue(invoice, 'invoiceId', 'InvoiceId', '');
            var invoiceNumber = getValue(invoice, 'invoiceNumber', 'InvoiceNumber', '');
            var description = getValue(invoice, 'description', 'Description', '');
            var amountDisplay = getValue(invoice, 'amountDisplay', 'AmountDisplay', '');
            var status = getValue(invoice, 'status', 'Status', '');
            var statusDisplay = getValue(invoice, 'statusDisplay', 'StatusDisplay', '');
            var createdDisplay = getValue(invoice, 'invoiceDateDisplay', 'InvoiceDateDisplay', '');
            var hostedInvoiceUrl = getValue(invoice, 'hostedInvoiceUrl', 'HostedInvoiceUrl', '');
            var invoicePdfUrl = getValue(invoice, 'invoicePdfUrl', 'InvoicePdfUrl', '');

            var row = document.createElement('tr');

            var dateCell = document.createElement('td');
            dateCell.textContent = createdDisplay || 'N/A';
            row.appendChild(dateCell);

            var numberCell = document.createElement('td');
            numberCell.textContent = invoiceNumber || invoiceId || 'N/A';
            row.appendChild(numberCell);

            var descriptionCell = document.createElement('td');
            descriptionCell.textContent = description || 'Membership invoice';
            row.appendChild(descriptionCell);

            var amountCell = document.createElement('td');
            amountCell.textContent = amountDisplay || 'N/A';
            row.appendChild(amountCell);

            var statusCell = document.createElement('td');
            var badge = document.createElement('span');
            badge.textContent = statusDisplay || status || 'N/A';
            badge.className = 'badge upendo-membership-dashboard__status-badge';
            setBadge(badge, status);
            statusCell.appendChild(badge);
            row.appendChild(statusCell);

            var actionsCell = document.createElement('td');
            actionsCell.className = 'upendo-membership-dashboard__invoice-actions';

            if (hostedInvoiceUrl) {
                var viewLink = document.createElement('a');
                viewLink.href = hostedInvoiceUrl;
                viewLink.className = 'upendo-membership-dashboard__icon-link';
                viewLink.setAttribute('aria-label', 'View invoice ' + (invoiceNumber || invoiceId || ''));
                viewLink.title = 'View invoice';
                viewLink.target = '_blank';
                viewLink.rel = 'noopener noreferrer';
                viewLink.innerHTML = '<i class="far fa-eye" aria-hidden="true"></i>';
                actionsCell.appendChild(viewLink);
            }

            if (invoicePdfUrl) {
                var pdfLink = document.createElement('a');
                pdfLink.href = invoicePdfUrl;
                pdfLink.className = 'upendo-membership-dashboard__icon-link';
                pdfLink.setAttribute('aria-label', 'Download invoice PDF ' + (invoiceNumber || invoiceId || ''));
                pdfLink.title = 'Download PDF';
                pdfLink.target = '_blank';
                pdfLink.rel = 'noopener noreferrer';
                pdfLink.innerHTML = '<i class="far fa-file-pdf" aria-hidden="true"></i>';
                actionsCell.appendChild(pdfLink);
            }

            row.appendChild(actionsCell);
            invoiceBody.appendChild(row);
        });
    }

    function renderDashboard(data) {
        try {
            if (window.console && window.console.info) {
                window.console.info('Membership dashboard response parsed:', data);
            }

            var hasMembershipAccount = getBooleanValue(data, 'hasMembershipAccount', 'HasMembershipAccount');

            if (!data || !hasMembershipAccount) {
                showState('empty');
                return;
            }

            var lastUpdatedDisplay = getValue(data, 'lastUpdatedDisplay', 'LastUpdatedDisplay', '');
            var localMembershipStatus = getValue(data, 'localMembershipStatus', 'LocalMembershipStatus', '');
            var localMembershipStatusDisplay = getValue(data, 'localMembershipStatusDisplay', 'LocalMembershipStatusDisplay', '');
            var stripeStatus = getValue(data, 'stripeStatus', 'StripeStatus', '');
            var stripeStatusDisplay = getValue(data, 'stripeStatusDisplay', 'StripeStatusDisplay', '');
            var memberSinceDisplay = getValue(data, 'memberSinceDisplay', 'MemberSinceDisplay', '');
            var planName = getValue(data, 'planName', 'PlanName', '');
            var nextRenewalDisplay = getValue(data, 'nextRenewalDisplay', 'NextRenewalDisplay', '');
            var billingIntervalDisplay = getValue(data, 'billingIntervalDisplay', 'BillingIntervalDisplay', '');
            var membershipFeeDisplay = getValue(data, 'membershipFeeDisplay', 'MembershipFeeDisplay', '');
            var accountStatusDisplay = getValue(data, 'accountStatusDisplay', 'AccountStatusDisplay', '');
            var latestInvoiceStatusDisplay = getValue(data, 'latestInvoiceStatusDisplay', 'LatestInvoiceStatusDisplay', '');
            var paymentMethodDisplay = getValue(data, 'paymentMethodDisplay', 'PaymentMethodDisplay', '');
            var nextAutoBillDisplay = getValue(data, 'nextAutoBillDisplay', 'NextAutoBillDisplay', '');
            var requiresPaymentAction = getBooleanValue(data, 'requiresPaymentAction', 'RequiresPaymentAction');
            var cancelAtPeriodEnd = getBooleanValue(data, 'cancelAtPeriodEnd', 'CancelAtPeriodEnd');
            var invoices = getArrayValue(data, 'invoices', 'Invoices');

            setText('[data-last-updated]', lastUpdatedDisplay);

            var lastUpdatedWrap = root.querySelector('[data-last-updated-wrap]');
            setHidden(lastUpdatedWrap, !lastUpdatedDisplay);

            var statusBadge = root.querySelector('[data-status-badge]');
            if (statusBadge) {
                statusBadge.textContent = localMembershipStatusDisplay || stripeStatusDisplay || 'Unknown';
                setBadge(statusBadge, localMembershipStatus || stripeStatus);
            }

            var memberSinceWrap = root.querySelector('[data-member-since-wrap]');
            setText('[data-member-since]', memberSinceDisplay);
            setHidden(memberSinceWrap, !memberSinceDisplay);

            setText('[data-plan-name]', toDisplayName(planName));
            setText('[data-next-renewal]', nextRenewalDisplay);
            setText('[data-billing-interval]', billingIntervalDisplay);
            setText('[data-membership-fee]', membershipFeeDisplay);
            setText('[data-account-status]', accountStatusDisplay);
            setText('[data-latest-invoice-status]', latestInvoiceStatusDisplay);
            setText('[data-payment-method]', paymentMethodDisplay);
            setText('[data-next-auto-bill]', nextAutoBillDisplay);

            var footerText = 'Your membership status and billing information are current.';

            if (requiresPaymentAction) {
                footerText = 'Your membership requires payment attention.';
            } else if (cancelAtPeriodEnd) {
                footerText = 'Your membership is active until the current period ends.';
            }

            setOptionalText('[data-hero-footer-text]', footerText);

            configureStatusAlert({
                localMembershipStatus: localMembershipStatus,
                LocalMembershipStatus: localMembershipStatus,
                stripeStatus: stripeStatus,
                StripeStatus: stripeStatus,
                requiresPaymentAction: requiresPaymentAction,
                RequiresPaymentAction: requiresPaymentAction,
                cancelAtPeriodEnd: cancelAtPeriodEnd,
                CancelAtPeriodEnd: cancelAtPeriodEnd,
                nextRenewalDisplay: nextRenewalDisplay,
                NextRenewalDisplay: nextRenewalDisplay
            });

            renderInvoices(invoices);

            showState('loaded');
            runMembershipHeroEffect(data);

            if (window.console && window.console.info) {
                window.console.info('Membership dashboard rendered successfully.');
            }
        } catch (ex) {
            logTemplateError(ex, 'renderDashboard');

            showError({
                heading: 'Membership details could not be displayed.',
                message: 'The membership data was loaded, but the dashboard could not finish rendering.',
                technicalMessage: ex && ex.message ? ex.message : 'Unknown render error'
            });
        }
    }

    function loadDashboard() {
        runSafely('loadDashboard:start', function () {
            showState('loading');

            fetchJson(getBaseUrl() + 'GetMyDashboard?portalId=' + encodeURIComponent(portalId), {
                method: 'GET'
            })
            .then(function (data) {
                runSafely('loadDashboard:renderDashboard', function () {
                    renderDashboard(data);
                });
            })
            .catch(function (error) {
                runSafely('loadDashboard:catch', function () {
                    var status = error && error.status ? error.status : 0;

                    if (status === 401 || status === 403 || status === 404 || status >= 500 || status === 0) {
                        showServiceUnavailableError(status);
                        return;
                    }

                    showError({
                        heading: 'Membership details are temporarily unavailable.',
                        message: 'We could not load your membership billing details. Please try again later or contact support if the issue continues.',
                        technicalMessage: status ? 'Status code: ' + status : ''
                    });
                });
            });
        });
    }

    function getPortalUrl(data) {
        return getValue(data, 'portalUrl', 'PortalUrl', '');
    }

    function setPortalButtonsBusy(isBusy) {
        safeQueryAll('[data-portal-action], [data-cancel-membership-button]').forEach(function (button) {
            if (!button) {
                return;
            }

            button.disabled = !!isBusy;
            button.setAttribute('aria-busy', isBusy ? 'true' : 'false');
        });
    }

    function normalizePortalAction(actionName) {
        var normalized = safeTrim(actionName).toLowerCase();

        /*
            The service currently supports:
            - payment_method_update
            - subscription_update
            - subscription_cancel

            Empty, manage, renew, or unknown values should open the default Stripe
            customer portal session.
        */
        if (normalized === 'payment_method_update' ||
            normalized === 'subscription_update' ||
            normalized === 'subscription_cancel') {
            return normalized;
        }

        return 'manage';
    }

    function openStripePortal(actionName) {
        runSafely('openStripePortal:start', function () {
            setPortalButtonsBusy(true);

            fetchJson(getBaseUrl() + 'CreateBillingPortalSession', {
                method: 'POST',
                body: JSON.stringify({
                    portalId: parseInt(portalId, 10),
                    returnUrl: window.location.href,
                    flowType: normalizePortalAction(actionName)
                })
            })
            .then(function (data) {
                runSafely('openStripePortal:success', function () {
                    var portalUrl = getPortalUrl(data);

                    if (portalUrl) {
                        window.location.href = portalUrl;
                        return;
                    }

                    setPortalButtonsBusy(false);
                    showActionWarning('The secure billing portal did not return a destination URL. Please try again later.');
                });
            })
            .catch(function (error) {
                runSafely('openStripePortal:catch', function () {
                    setPortalButtonsBusy(false);

                    var status = error && error.status ? error.status : 0;
                    var message = 'We could not open the secure billing portal. Please try again later or contact support.';

                    if (status === 400) {
                        if (normalizePortalAction(actionName) === 'subscription_update') {
                            message = 'Stripe plan changes are not fully enabled yet. Opening the secure billing portal when available, or contact member support to change your plan.';
                        } else if (normalizePortalAction(actionName) === 'subscription_cancel') {
                            message = 'Stripe cancellation options are not fully enabled yet. Please contact member support if you need to cancel your membership.';
                        } else {
                            message = 'Stripe could not create a billing portal session for this membership account. Please contact support if this continues.';
                        }
                    } else if (status === 404) {
                        message = 'The secure billing portal service is not available on this site yet.';
                    } else if (status === 401 || status === 403) {
                        message = 'Please sign in with the member account that is connected to your membership billing record.';
                    } else if (status >= 500) {
                        message = 'The secure billing portal is temporarily unavailable.';
                    }

                    showActionWarning(message);
                });
            });
        });
    }

    function showConfirm(actionName) {
        pendingConfirmAction = actionName || 'manage';
        setHidden(confirmBackdrop, false);
        setHidden(confirmModal, false);

        var continueButton = root.querySelector('[data-confirm-continue]');
        if (continueButton) {
            continueButton.focus();
        }
    }

    function hideConfirm() {
        setHidden(confirmBackdrop, true);
        setHidden(confirmModal, true);
    }

    if (root.addEventListener) {
        root.addEventListener('click', function (event) {
            runSafely('root:click', function () {
                event = event || window.event;

                var target = event.target || event.srcElement;
                var portalButton = safeClosest(target, '[data-portal-action]');

                if (portalButton) {
                    if (event.preventDefault) {
                        event.preventDefault();
                    }

                    openStripePortal(portalButton.getAttribute('data-portal-action'));
                    return;
                }

                var cancelButton = safeClosest(target, '[data-cancel-membership-button]');

                if (cancelButton) {
                    if (event.preventDefault) {
                        event.preventDefault();
                    }

                    showConfirm('subscription_cancel');
                    return;
                }

                if (safeClosest(target, '[data-confirm-cancel]')) {
                    if (event.preventDefault) {
                        event.preventDefault();
                    }

                    hideConfirm();
                    return;
                }

                if (safeClosest(target, '[data-confirm-continue]')) {
                    if (event.preventDefault) {
                        event.preventDefault();
                    }

                    hideConfirm();
                    openStripePortal(pendingConfirmAction);
                    return;
                }

                if (safeClosest(target, '[data-retry-button]')) {
                    if (event.preventDefault) {
                        event.preventDefault();
                    }

                    loadDashboard();
                }
            });
        });
    }

    if (document.addEventListener) {
        document.addEventListener('keydown', function (event) {
            runSafely('document:keydown', function () {
                event = event || window.event;

                var key = event.key || event.keyCode;

                if ((key === 'Escape' || key === 'Esc' || key === 27) && confirmModal && !confirmModal.hidden) {
                    hideConfirm();
                }
            });
        });
    }

    function startDashboard() {
        runSafely('startDashboard', function () {
            configureStaticLinks();

            /*
                Do not skip admin/edit mode.
                Do not hide symptoms.
                Do not special-case the page mode.

                This simply waits until the page has finished its initial load cycle before
                this template starts its own API request. The request still runs in every mode.
            */
            var beginLoad = function () {
                runSafely('startDashboard:loadDashboard', function () {
                    loadDashboard();
                });
            };

            if (document.readyState === 'complete') {
                window.setTimeout(beginLoad, 1);
            } else if (window.addEventListener) {
                window.addEventListener('load', function () {
                    window.setTimeout(beginLoad, 1);
                });
            } else {
                window.setTimeout(beginLoad, 250);
            }
        });
    }

    startDashboard();
})();
</script>