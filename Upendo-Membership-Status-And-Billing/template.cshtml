@using System
@using System.Web
@using Upendo.Libraries.RunsOnUpendoCore.Helpers
@inherits Satrabel.OpenContent.Components.OpenContentWebPage

@{
    TemplateHelper.HideAdminBorder(Model.Context.ModuleId, Model.Context.TabId);
    RegisterStyleSheet("template.css");

    var moduleId = Model.Context.ModuleId;
    var tabId = Model.Context.TabId;
    var portalId = Model.Context.PortalId;

    var moduleAnchor = Model.ModuleAnchor != null ? Convert.ToString(Model.ModuleAnchor) : string.Empty;

    var heading = Model.Heading != null ? Convert.ToString(Model.Heading) : "My Membership";
    var lead = Model.Lead != null ? Convert.ToString(Model.Lead) : string.Empty;
    var loadingMessage = Model.LoadingMessage != null ? Convert.ToString(Model.LoadingMessage) : "Loading your membership details...";
    var emptyHeading = Model.EmptyHeading != null ? Convert.ToString(Model.EmptyHeading) : "No membership billing account found.";
    var emptyText = Model.EmptyText != null ? Convert.ToString(Model.EmptyText) : "<p>Membership billing details will appear here once your account is linked.</p>";
    var errorHeading = Model.ErrorHeading != null ? Convert.ToString(Model.ErrorHeading) : "We couldn't load your billing details.";
    var errorText = Model.ErrorText != null ? Convert.ToString(Model.ErrorText) : "<p>Please refresh the page or contact support if the problem persists.</p>";

    var contactMemberSupportAddress = Model.Settings.ContactMemberSupportAddress != null
        ? Convert.ToString(Model.Settings.ContactMemberSupportAddress)
        : string.Empty;

    var viewAllBenefitsUrl = Model.Settings.ViewAllBenefitsUrl != null
        ? Convert.ToString(Model.Settings.ViewAllBenefitsUrl)
        : string.Empty;

    var backgroundColorClass = Model.Settings.BackgroundColorClass != null
        ? Convert.ToString(Model.Settings.BackgroundColorClass)
        : string.Empty;

    var marginTop = Model.Settings.MarginTop != null
        ? Convert.ToString(Model.Settings.MarginTop)
        : string.Empty;

    var marginBottom = Model.Settings.MarginBottom != null
        ? Convert.ToString(Model.Settings.MarginBottom)
        : string.Empty;

    var paddingTop = Model.Settings.PaddingTop != null
        ? Convert.ToString(Model.Settings.PaddingTop)
        : string.Empty;

    var paddingBottom = Model.Settings.PaddingBottom != null
        ? Convert.ToString(Model.Settings.PaddingBottom)
        : string.Empty;

    var sectionClasses = "upendo-membership-dashboard w-100";

    if (!string.IsNullOrWhiteSpace(backgroundColorClass))
    {
        sectionClasses += " " + backgroundColorClass;
    }

    if (!string.IsNullOrWhiteSpace(marginTop))
    {
        sectionClasses += " " + marginTop;
    }

    if (!string.IsNullOrWhiteSpace(marginBottom))
    {
        sectionClasses += " " + marginBottom;
    }

    if (!string.IsNullOrWhiteSpace(paddingTop))
    {
        sectionClasses += " " + paddingTop;
    }

    if (!string.IsNullOrWhiteSpace(paddingBottom))
    {
        sectionClasses += " " + paddingBottom;
    }

    var rootId = "upendoMembershipDashboard" + moduleId.ToString();
}

@if (!string.IsNullOrWhiteSpace(moduleAnchor))
{
    <div id="@moduleAnchor"></div>
}

<section id="@rootId"
         class="@sectionClasses"
         data-module-id="@moduleId"
         data-tab-id="@tabId"
         data-portal-id="@portalId"
         data-support-address="@contactMemberSupportAddress"
         data-benefits-url="@viewAllBenefitsUrl"
         aria-labelledby="@rootId-heading">

    <div class="container-fluid">
        <div class="upendo-membership-dashboard__inner mx-auto">

            <div class="d-flex flex-column flex-lg-row align-items-start align-items-lg-center justify-content-between gap-3 mb-4">
                <div>
                    <h2 id="@rootId-heading" class="upendo-membership-dashboard__heading mb-1">
                        @Html.Raw(heading)
                    </h2>

                    @if (!string.IsNullOrWhiteSpace(lead))
                    {
                        <div class="upendo-membership-dashboard__lead">
                            @Html.Raw(lead)
                        </div>
                    }

                    <div class="upendo-membership-dashboard__trust-line d-flex flex-wrap gap-3 mt-3" data-membership-trust-line hidden>
                        <span>
                            <i class="fas fa-shield-alt me-1" aria-hidden="true"></i>
                            Payment details are managed securely through Stripe.
                        </span>
                        <span data-last-updated-wrap hidden>
                            <i class="fas fa-sync-alt me-1" aria-hidden="true"></i>
                            <em>Last updated <span data-last-updated></span></em>
                        </span>
                    </div>
                </div>

                <div class="upendo-membership-dashboard__header-actions flex-wrap gap-2" data-header-actions hidden>
                    <button type="button"
                            class="btn btn-outline-dark upendo-membership-dashboard__portal-button"
                            data-portal-action="manage"
                            aria-label="Manage billing securely through Stripe">
                        <i class="fas fa-receipt me-2" aria-hidden="true"></i>
                        Manage Billing
                    </button>

                    <button type="button"
                            class="btn btn-primary upendo-membership-dashboard__portal-button"
                            data-portal-action="renew"
                            aria-label="Renew membership securely through Stripe">
                        Renew Now
                    </button>
                </div>
            </div>

            <div class="upendo-membership-dashboard__loading" data-loading-state role="status" aria-live="polite">
                <div class="row g-4">
                    <div class="col-12 col-lg-8">
                        <div class="upendo-membership-dashboard__card upendo-membership-dashboard__skeleton-card">
                            <span class="upendo-membership-dashboard__skeleton w-25"></span>
                            <span class="upendo-membership-dashboard__skeleton w-75"></span>
                            <span class="upendo-membership-dashboard__skeleton w-50"></span>
                            <div class="row g-3 mt-3">
                                <div class="col-12 col-md-6">
                                    <span class="upendo-membership-dashboard__skeleton upendo-membership-dashboard__skeleton-block"></span>
                                </div>
                                <div class="col-12 col-md-6">
                                    <span class="upendo-membership-dashboard__skeleton upendo-membership-dashboard__skeleton-block"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-4">
                        <div class="upendo-membership-dashboard__card upendo-membership-dashboard__skeleton-card">
                            <span class="upendo-membership-dashboard__skeleton w-50"></span>
                            <span class="upendo-membership-dashboard__skeleton w-75"></span>
                            <span class="upendo-membership-dashboard__skeleton upendo-membership-dashboard__skeleton-block"></span>
                        </div>
                    </div>
                </div>
                <span class="visually-hidden">@Html.Raw(loadingMessage)</span>
            </div>

            <div class="upendo-membership-dashboard__error alert alert-warning d-flex flex-column flex-lg-row align-items-start align-items-lg-center justify-content-between gap-3"
                data-error-state
                hidden
                role="alert"
                aria-live="polite">
                <div class="d-flex gap-3">
                    <span class="upendo-membership-dashboard__alert-icon" aria-hidden="true">
                        <i class="fas fa-exclamation-triangle"></i>
                    </span>

                    <div>
                        <strong class="d-block" data-error-heading>
                            @Html.Raw(errorHeading)
                        </strong>

                        <div data-error-text>
                            @Html.Raw(errorText)
                        </div>

                        <div class="upendo-membership-dashboard__error-technical small mt-2"
                            data-error-technical
                            hidden></div>
                    </div>
                </div>

                <div class="d-flex flex-column flex-sm-row gap-2">
                    <a class="btn btn-outline-dark"
                    href="@contactMemberSupportAddress"
                    data-error-support-link
                    hidden>
                        <i class="fas fa-headset me-2" aria-hidden="true"></i>
                        Contact Support
                    </a>

                    <button type="button"
                            class="btn btn-outline-danger"
                            data-retry-button>
                        Try Again
                    </button>
                </div>
            </div>

            <div class="upendo-membership-dashboard__empty text-center" data-empty-state hidden>
                <div class="upendo-membership-dashboard__card py-5">
                    <span class="upendo-membership-dashboard__empty-icon mb-3" aria-hidden="true">
                        <i class="fas fa-history"></i>
                    </span>
                    <h3 class="h4">@Html.Raw(emptyHeading)</h3>
                    <div class="upendo-membership-dashboard__empty-text mx-auto">
                        @Html.Raw(emptyText)
                    </div>
                    <div class="mt-4">
                        <a class="btn btn-primary" href="@viewAllBenefitsUrl">
                            View Membership Benefits
                        </a>
                    </div>
                </div>
            </div>

            <div data-loaded-state hidden>
                <div class="upendo-membership-dashboard__status-alert mb-4" data-status-alert hidden>
                    <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-3">
                        <div class="d-flex gap-3">
                            <span class="upendo-membership-dashboard__status-alert-icon" aria-hidden="true">
                                <i class="fas fa-info-circle"></i>
                            </span>
                            <div>
                                <h3 class="h5 mb-1" data-status-alert-heading></h3>
                                <div data-status-alert-text></div>
                            </div>
                        </div>
                        <a class="btn btn-link fw-semibold text-decoration-none" href="@contactMemberSupportAddress" data-support-link>
                            <i class="far fa-envelope me-1" aria-hidden="true"></i>
                            Contact Support
                        </a>
                    </div>
                </div>

                <div class="row g-4 align-items-stretch">
                    <div class="col-12 col-xl-8">
                        <article class="upendo-membership-dashboard__hero-card h-100" data-membership-hero-card>
                            <div class="upendo-membership-dashboard__hero-body">
                                <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                                    <span class="badge upendo-membership-dashboard__status-badge" data-status-badge></span>
                                    <span class="upendo-membership-dashboard__small" data-member-since-wrap hidden>
                                        Member since <strong data-member-since></strong>
                                    </span>
                                </div>

                                <h3 class="upendo-membership-dashboard__plan-name mb-4" data-plan-name></h3>

                                <div class="row g-4">
                                    <div class="col-12 col-md-4">
                                        <span class="upendo-membership-dashboard__label">Next Renewal</span>
                                        <strong class="upendo-membership-dashboard__value" data-next-renewal></strong>
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <span class="upendo-membership-dashboard__label">Billing Interval</span>
                                        <strong class="upendo-membership-dashboard__value" data-billing-interval></strong>
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <span class="upendo-membership-dashboard__label">Membership Fee</span>
                                        <strong class="upendo-membership-dashboard__value" data-membership-fee></strong>
                                    </div>
                                </div>
                            </div>

                            <div class="upendo-membership-dashboard__hero-footer" data-hero-footer>
                                <i class="fas fa-info-circle me-2" aria-hidden="true"></i>
                                <span data-hero-footer-text></span>
                            </div>
                        </article>
                    </div>

                    <div class="col-12 col-xl-4">
                        <aside class="upendo-membership-dashboard__card h-100" aria-label="Billing health">
                            <div class="d-flex align-items-center justify-content-between mb-4">
                                <h3 class="h4 mb-0">Billing Health</h3>
                                <span class="upendo-membership-dashboard__stripe-pill">
                                    <i class="fas fa-lock me-1" aria-hidden="true"></i>
                                    Stripe
                                </span>
                            </div>

                            <dl class="upendo-membership-dashboard__billing-list">
                                <div>
                                    <dt>Account Status</dt>
                                    <dd data-account-status></dd>
                                </div>
                                <div>
                                    <dt>Latest Invoice</dt>
                                    <dd data-latest-invoice-status></dd>
                                </div>
                                <div>
                                    <dt>Payment Method</dt>
                                    <dd data-payment-method></dd>
                                </div>
                                <div>
                                    <dt>Next Auto-bill</dt>
                                    <dd data-next-auto-bill></dd>
                                </div>
                            </dl>

                            <button type="button"
                                    class="btn btn-primary w-100 mt-3 upendo-membership-dashboard__portal-button"
                                    data-portal-action="manage"
                                    aria-label="Update payment method securely through Stripe">
                                Update Payment Method
                                <i class="fas fa-arrow-right ms-2" aria-hidden="true"></i>
                            </button>

                            <p class="upendo-membership-dashboard__stripe-note mb-0 mt-2 text-center">
                                Opens secure Stripe portal
                            </p>
                        </aside>
                    </div>
                </div>

                <div class="row g-3 mt-1">
                    <div class="col-12 col-md-6 col-xl-3">
                        <button type="button" class="upendo-membership-dashboard__action-card w-100" data-portal-action="manage">
                            <i class="far fa-calendar-alt" aria-hidden="true"></i>
                            <strong>Manage Billing</strong>
                            <span>Open secure Stripe billing portal</span>
                        </button>
                    </div>
                    <div class="col-12 col-md-6 col-xl-3">
                        <button type="button" class="upendo-membership-dashboard__action-card w-100" data-portal-action="payment_method_update">
                            <i class="far fa-credit-card" aria-hidden="true"></i>
                            <strong>Update Card</strong>
                            <span>Change card for renewals</span>
                        </button>
                    </div>
                    <div class="col-12 col-md-6 col-xl-3">
                        <button type="button"
                            class="upendo-membership-dashboard__action-card w-100"
                            data-portal-action="subscription_update"
                            aria-label="Review membership plan options securely through Stripe">
                        <i class="fas fa-level-up-alt" aria-hidden="true"></i>
                        <strong>Change Plan</strong>
                        <span>Opens available Stripe options</span>
                    </button>
                    </div>
                    <div class="col-12 col-md-6 col-xl-3">
                        <button type="button" class="upendo-membership-dashboard__action-card upendo-membership-dashboard__action-card-danger w-100" data-cancel-membership-button>
                            <i class="far fa-times-circle" aria-hidden="true"></i>
                            <strong>Cancel Membership</strong>
                            <span>Manage cancellation via Stripe</span>
                        </button>
                    </div>
                </div>

                <div class="row g-4 mt-1">
                    <div class="col-12 col-xl-8">
                        <section class="upendo-membership-dashboard__card p-0 overflow-hidden" aria-labelledby="@rootId-invoices-heading">
                            <div class="d-flex align-items-center justify-content-between gap-3 p-4 border-bottom">
                                <h3 id="@rootId-invoices-heading" class="h4 mb-0">Recent Invoices</h3>
                                <a href="#" class="fw-semibold text-decoration-none" data-download-all-link hidden>
                                    Download All
                                </a>
                            </div>

                            <div class="table-responsive">
                                <table class="table upendo-membership-dashboard__invoice-table mb-0">
                                    <caption class="visually-hidden">Recent membership invoices</caption>
                                    <thead>
                                        <tr>
                                            <th scope="col">Date</th>
                                            <th scope="col">Invoice #</th>
                                            <th scope="col">Description</th>
                                            <th scope="col">Amount</th>
                                            <th scope="col">Status</th>
                                            <th scope="col">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody data-invoice-body></tbody>
                                </table>
                            </div>

                            <div class="upendo-membership-dashboard__invoice-empty text-center py-5" data-invoice-empty hidden>
                                <span class="upendo-membership-dashboard__empty-icon mb-3" aria-hidden="true">
                                    <i class="fas fa-history"></i>
                                </span>
                                <h4 class="h5">No invoices found yet.</h4>
                                <p class="mb-0">Invoices will appear here after membership billing begins.</p>
                            </div>
                        </section>
                    </div>

                    <div class="col-12 col-xl-4">
                        <aside class="upendo-membership-dashboard__help-card mb-4">
                            <h3 class="h4">Need help?</h3>
                            <p>Have questions about your membership benefits or billing? Our support team is here to assist you.</p>

                            <a class="btn upendo-membership-dashboard__support-button w-100 mb-3"
                                href="@contactMemberSupportAddress" data-support-link>
                                <i class="fas fa-headset me-2" aria-hidden="true"></i>
                                Contact Member Support
                            </a>

                            <a class="btn btn-outline-light w-100" href="@viewAllBenefitsUrl" data-benefits-link>
                                <i class="far fa-list-alt me-2" aria-hidden="true"></i>
                                View All Benefits
                            </a>
                        </aside>

                        <aside class="upendo-membership-dashboard__security-card">
                            <div class="d-flex gap-3">
                                <span class="upendo-membership-dashboard__security-icon" aria-hidden="true">
                                    <i class="fas fa-shield-alt"></i>
                                </span>
                                <div>
                                    <strong class="d-block text-uppercase">Security First</strong>
                                    <p class="mb-0">Financial details are managed using Stripe's secure billing tools.</p>
                                </div>
                            </div>
                        </aside>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="upendo-membership-dashboard__modal-backdrop" data-confirm-backdrop hidden></div>
    <div class="upendo-membership-dashboard__modal" data-confirm-modal hidden role="dialog" aria-modal="true" aria-labelledby="@rootId-confirm-title">
        <div class="upendo-membership-dashboard__modal-card">
            <div class="d-flex gap-3">
                <span class="upendo-membership-dashboard__modal-icon" aria-hidden="true">
                    <i class="far fa-times-circle"></i>
                </span>
                <div>
                    <h3 id="@rootId-confirm-title" class="h4">Continue to Stripe?</h3>
                    <p>
                        Cancellation and billing changes are managed securely in Stripe. You will leave this page to continue.
                    </p>
                </div>
            </div>

            <div class="d-flex flex-column flex-sm-row justify-content-end gap-2 mt-4">
                <button type="button" class="btn btn-outline-secondary" data-confirm-cancel>
                    Stay Here
                </button>
                <button type="button" class="btn btn-danger" data-confirm-continue>
                    Continue to Stripe
                </button>
            </div>
        </div>
    </div>
</section>

<script>
(function () {
    'use strict';

    var root = document.getElementById('@rootId');
    if (!root) {
        return;
    }
    var membershipHeroEffectInterval = null;

    var moduleId = root.getAttribute('data-module-id') || '';
    var tabId = root.getAttribute('data-tab-id') || '';
    var portalId = root.getAttribute('data-portal-id') || '';
    var supportAddress = root.getAttribute('data-support-address') || '';
    var benefitsUrl = root.getAttribute('data-benefits-url') || '';

    var loadingState = root.querySelector('[data-loading-state]');
    var loadedState = root.querySelector('[data-loaded-state]');
    var emptyState = root.querySelector('[data-empty-state]');
    var errorState = root.querySelector('[data-error-state]');
    var trustLine = root.querySelector('[data-membership-trust-line]');
    var headerActions = root.querySelector('[data-header-actions]');
    var invoiceBody = root.querySelector('[data-invoice-body]');
    var invoiceEmpty = root.querySelector('[data-invoice-empty]');
    var confirmBackdrop = root.querySelector('[data-confirm-backdrop]');
    var confirmModal = root.querySelector('[data-confirm-modal]');
    var pendingConfirmAction = 'manage';

    var defaultErrorHeading = '@HttpUtility.JavaScriptStringEncode(Convert.ToString(errorHeading))';
    var defaultErrorText = '@HttpUtility.JavaScriptStringEncode(Convert.ToString(errorText))';

    function logTemplateError(error, context) {
        try {
            if (window.console && window.console.warn) {
                window.console.warn('Membership dashboard template error' + (context ? ' [' + context + ']' : '') + ':', error);
            }
        } catch (ignore) {
            // Never allow logging failures to escape the template.
        }
    }

    function runSafely(context, callback, fallbackValue) {
        try {
            return callback();
        } catch (error) {
            logTemplateError(error, context);
            return fallbackValue;
        }
    }

    function showContainedTemplateFailure(error, context) {
        logTemplateError(error, context);

        showError({
            heading: 'Membership billing is temporarily unavailable.',
            message: 'The membership billing area could not finish loading, but the rest of the page should continue working.',
            technicalMessage: context ? 'Template area: ' + context : '',
            hideRetry: false
        });
    }

    function safeQuery(selector) {
        return runSafely('query: ' + selector, function () {
            return root.querySelector(selector);
        }, null);
    }

    function safeQueryAll(selector) {
        return runSafely('queryAll: ' + selector, function () {
            return Array.prototype.slice.call(root.querySelectorAll(selector));
        }, []);
    }

    function safeClosest(element, selector) {
        return runSafely('closest: ' + selector, function () {
            if (!element || element.nodeType !== 1) {
                return null;
            }

            if (element.closest) {
                return element.closest(selector);
            }

            var current = element;

            while (current && current !== root && current.nodeType === 1) {
                if (current.matches && current.matches(selector)) {
                    return current;
                }

                current = current.parentElement;
            }

            if (current === root && root.matches && root.matches(selector)) {
                return root;
            }

            return null;
        }, null);
    }

    function safeTrim(value) {
        return value == null ? '' : String(value).replace(/^\s+|\s+$/g, '');
    }

    function toDisplayName(value) {
        var text = safeTrim(value);

        if (!text) {
            return '';
        }

        /*
            Stripe product names sometimes arrive in all caps.
            Only normalize values that are clearly all caps, so intentionally mixed-case
            names are preserved.
        */
        var lettersOnly = text.replace(/[^A-Za-z]+/g, '');
        var hasLetters = lettersOnly.length > 0;
        var isAllCaps = hasLetters && text === text.toUpperCase();

        if (!isAllCaps) {
            return text;
        }

        var keepUpper = {
            'SFO': true,
            'SF': true,
            'CA': true,
            'US': true,
            'USA': true,
            'LLC': true,
            ' LLP': true,
            'INC': true,
            'DBA': true,
            'CEO': true,
            'CFO': true,
            'COO': true,
            'HR': true,
            'IT': true
        };

        return text.toLowerCase().replace(/\b([a-z][a-z0-9'&/-]*)\b/g, function (word) {
            var upperWord = word.toUpperCase();

            if (keepUpper[upperWord]) {
                return upperWord;
            }

            return word.charAt(0).toUpperCase() + word.slice(1);
        });
    }

    function hasValue(value) {
        return safeTrim(value).length > 0;
    }

    function getValue(source, camelName, pascalName, fallbackValue) {
        if (!source) {
            return fallbackValue;
        }

        if (source[camelName] !== undefined && source[camelName] !== null) {
            return source[camelName];
        }

        if (source[pascalName] !== undefined && source[pascalName] !== null) {
            return source[pascalName];
        }

        return fallbackValue;
    }

    function getBooleanValue(source, camelName, pascalName) {
        var value = getValue(source, camelName, pascalName, false);

        if (value === true || value === false) {
            return value;
        }

        if (typeof value === 'string') {
            return value.toLowerCase() === 'true';
        }

        return !!value;
    }

    function getArrayValue(source, camelName, pascalName) {
        var value = getValue(source, camelName, pascalName, []);

        return Object.prototype.toString.call(value) === '[object Array]'
            ? value
            : [];
    }

    function setHidden(element, hidden) {
        if (!element) {
            return;
        }

        hidden = !!hidden;

        element.hidden = hidden;
        element.setAttribute('aria-hidden', hidden ? 'true' : 'false');

        if (hidden) {
            element.style.setProperty('display', 'none', 'important');
        } else {
            element.style.removeProperty('display');
        }
    }

    function setText(selector, value) {
        var element = root.querySelector(selector);
        if (element) {
            element.textContent = hasValue(value) ? value : 'N/A';
        }
    }

    function setOptionalText(selector, value) {
        var element = root.querySelector(selector);
        if (element) {
            element.textContent = hasValue(value) ? value : '';
        }
    }

    function normalizeSupportHref(value) {
        var address = safeTrim(value);

        if (!address) {
            return '';
        }

        if (/^mailto:/i.test(address) || /^https?:\/\//i.test(address) || /^\//.test(address) || /^#/.test(address)) {
            return address;
        }

        if (/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(address)) {
            return 'mailto:' + address;
        }

        return address;
    }

    function configureStaticLinks() {
        runSafely('configureStaticLinks', function () {
            var normalizedSupportHref = normalizeSupportHref(supportAddress);
            var supportLinks = safeQueryAll('[data-support-link], [data-error-support-link]');
            var benefitsLinks = safeQueryAll('[data-benefits-link]');
