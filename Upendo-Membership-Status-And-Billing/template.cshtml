                if (!link) {
                    continue;
                }

                if (hasValue(benefitsUrl)) {
                    link.href = benefitsUrl;
                    link.hidden = false;
                } else {
                    link.hidden = true;
                }
            }
        });
    }

    function showState(stateName) {
