@using System
@using System.Collections
@using System.Collections.Generic
@using System.Text.RegularExpressions
@using Upendo.Libraries.RunsOnUpendoCore.Helpers
@inherits Satrabel.OpenContent.Components.OpenContentWebPage

@functions {
    private static object GetDynamicValue(dynamic source, string propertyName)
    {
        if (source == null || string.IsNullOrWhiteSpace(propertyName))
        {
            return null;
        }

        try
        {
            var dictionary = source as IDictionary<string, object>;
            if (dictionary != null && dictionary.ContainsKey(propertyName))
            {
                return dictionary[propertyName];
            }
        }
        catch
        {
        }

        try
        {
            return source[propertyName];
        }
        catch
        {
        }

        try
        {
            var property = ((object)source).GetType().GetProperty(propertyName);
            return property != null ? property.GetValue(source, null) : null;
        }
        catch
        {
            return null;
        }
    }

    private static string GetDynamicString(dynamic source, string propertyName)
    {
        var value = GetDynamicValue(source, propertyName);
        return value != null ? Convert.ToString(value) : string.Empty;
    }

    private static string GetImageUrl(dynamic image)
    {
        if (image == null)
        {
            return string.Empty;
        }

        if (image is string)
        {
            return Convert.ToString(image);
        }

        var url = GetDynamicString(image, "Url");
        return !string.IsNullOrWhiteSpace(url) ? url : GetDynamicString(image, "url");
    }

    private static string AllowList(string value, string fallback, params string[] allowedValues)
    {
        if (!string.IsNullOrWhiteSpace(value))
        {
            foreach (var allowedValue in allowedValues)
            {
                if (string.Equals(value, allowedValue, StringComparison.OrdinalIgnoreCase))
                {
                    return allowedValue;
                }
            }
        }

        return fallback;
    }

    private static string GetSafeIconClass(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        var iconClass = value.Trim();
        return Regex.IsMatch(iconClass, @"^[A-Za-z0-9_ -]+$") ? iconClass : string.Empty;
    }
}

@{
    TemplateHelper.HideAdminBorder(Model.Context.ModuleId, Model.Context.TabId);
    RegisterStyleSheet("template.css");

    var settings = Model.Settings;
    var moduleAnchor = GetDynamicString(Model, "ModuleAnchor");
    if (!Regex.IsMatch(moduleAnchor ?? string.Empty, @"^[A-Za-z0-9-]+$"))
    {
        moduleAnchor = string.Empty;
    }

    var sectionEyebrow = GetDynamicString(Model, "SectionEyebrow");
    var sectionTitle = GetDynamicString(Model, "SectionTitle");
    var sectionDescription = GetDynamicString(Model, "SectionDescription");
    var sectionFooter = GetDynamicString(Model, "SectionFooter");

    var eyebrowColor = AllowList(
        GetDynamicString(Model, "SectionEyebrowColor"),
        string.Empty,
        "", "text-primary", "text-secondary", "text-success", "text-danger", "text-warning",
        "text-info", "text-light", "text-dark", "text-body", "text-body-secondary", "text-black", "text-white"
    );

    var backgroundColorClass = AllowList(
        GetDynamicString(settings, "BackgroundColorClass"),
        string.Empty,
        "", "bg-primary", "bg-primary-scoped", "bg-secondary", "bg-secondary-scoped", "bg-tertiary",
        "bg-quaternary", "bg-h5", "bg-h6", "bg-success", "bg-danger", "bg-warning", "bg-info",
        "bg-light", "bg-dark", "bg-white", "bg-body", "bg-transparent", "bg-primary-subtle",
        "bg-secondary-subtle", "bg-success-subtle", "bg-danger-subtle", "bg-warning-subtle",
        "bg-info-subtle", "bg-light-subtle", "bg-dark-subtle", "bg-off-white", "bg-warm-white",
        "bg-cream", "bg-soft-beige", "bg-sand", "bg-light-sage", "bg-sage", "bg-pale-green",
        "bg-mist", "bg-soft-gray", "bg-forest-green"
    );

    var cardBackgroundSetting = AllowList(
        GetDynamicString(settings, "CardBackgroundColor"),
        "bg-light",
        "bg-primary", "bg-secondary", "bg-success", "bg-danger", "bg-warning",
        "bg-info", "bg-light", "bg-dark", "bg-black", "bg-white", "bg-body"
    );

    var cardBackgroundClass = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
    {
        { "bg-primary", "oc-fccg-card-primary" },
        { "bg-secondary", "oc-fccg-card-secondary" },
        { "bg-success", "oc-fccg-card-success" },
        { "bg-danger", "oc-fccg-card-danger" },
        { "bg-warning", "oc-fccg-card-warning" },
        { "bg-info", "oc-fccg-card-info" },
        { "bg-light", "oc-fccg-card-light" },
        { "bg-dark", "oc-fccg-card-dark" },
        { "bg-black", "oc-fccg-card-black" },
        { "bg-white", "oc-fccg-card-white" },
        { "bg-body", "oc-fccg-card-body" }
    }[cardBackgroundSetting];

    var iconColorSetting = AllowList(
        GetDynamicString(settings, "IconColor"),
        string.Empty,
        "", "text-primary", "text-secondary", "text-success", "text-danger", "text-warning",
        "text-info", "text-light", "text-dark", "text-body", "text-black", "text-white"
    );

    var iconBackgroundClass = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
    {
        { "", "oc-fccg-icon-default" },
        { "text-primary", "oc-fccg-icon-primary" },
        { "text-secondary", "oc-fccg-icon-secondary" },
        { "text-success", "oc-fccg-icon-success" },
        { "text-danger", "oc-fccg-icon-danger" },
        { "text-warning", "oc-fccg-icon-warning" },
        { "text-info", "oc-fccg-icon-info" },
        { "text-light", "oc-fccg-icon-light" },
        { "text-dark", "oc-fccg-icon-dark" },
        { "text-body", "oc-fccg-icon-body" },
        { "text-black", "oc-fccg-icon-black" },
        { "text-white", "oc-fccg-icon-white" }
    }[iconColorSetting];

    var animationLevel = AllowList(GetDynamicString(settings, "AnimationLevel"), "light", "none", "light", "medium", "high");
    var animationName = animationLevel == "high" ? "zoomIn" : (animationLevel == "medium" ? "fadeInUp" : "fadeIn");
    var animationStep = animationLevel == "high" ? 160 : (animationLevel == "medium" ? 100 : 60);
    var animationClass = animationLevel == "none" ? string.Empty : " appear-animation";

    var marginTop = AllowList(GetDynamicString(settings, "MarginTop"), string.Empty, "", "mt-0", "mt-1", "mt-2", "mt-3", "mt-4", "mt-5", "mt-auto");
    var marginBottom = AllowList(GetDynamicString(settings, "MarginBottom"), string.Empty, "", "mb-0", "mb-1", "mb-2", "mb-3", "mb-4", "mb-5", "mb-auto");
    var paddingTop = AllowList(GetDynamicString(settings, "PaddingTop"), "pt-5", "", "pt-0", "pt-1", "pt-2", "pt-3", "pt-4", "pt-5", "pt-auto");
    var paddingBottom = AllowList(GetDynamicString(settings, "PaddingBottom"), "pb-5", "", "pb-0", "pb-1", "pb-2", "pb-3", "pb-4", "pb-5", "pb-auto");

    var sectionClass = "oc-fccg " + backgroundColorClass + " " + marginTop + " " + marginBottom + " " + paddingTop + " " + paddingBottom;
    var sectionId = "oc-fccg-" + Model.Context.ModuleId;
    var headingId = sectionId + "-heading";
    var rows = new List<dynamic>();
    var rowValues = GetDynamicValue(Model, "SectionRows") as IEnumerable;
    if (rowValues != null)
    {
        foreach (var rowValue in rowValues)
        {
            rows.Add(rowValue);
        }
    }

    var hasContent = !string.IsNullOrWhiteSpace(sectionEyebrow)
        || !string.IsNullOrWhiteSpace(sectionTitle)
        || !string.IsNullOrWhiteSpace(sectionDescription)
        || !string.IsNullOrWhiteSpace(sectionFooter)
        || rows.Count > 0;
}

@if (!string.IsNullOrWhiteSpace(moduleAnchor))
{
    <div id="@moduleAnchor"></div>
}

@if (hasContent)
{
    <section id="@sectionId"
             class="@sectionClass"
             data-animation-level="@animationLevel"
             aria-labelledby="@headingId">
        <div class="container-xxl">
            @if (string.IsNullOrWhiteSpace(sectionTitle))
            {
                <h2 id="@headingId" class="visually-hidden">Featured content</h2>
            }

            @if (!string.IsNullOrWhiteSpace(sectionEyebrow) || !string.IsNullOrWhiteSpace(sectionTitle) || !string.IsNullOrWhiteSpace(sectionDescription))
            {
                <div class="oc-fccg-header text-center mx-auto mb-5 pb-3 mb-5@animationClass" data-appear-animation="@animationName">
                    @if (!string.IsNullOrWhiteSpace(sectionEyebrow))
                    {
                        <div class="oc-fccg-eyebrow @eyebrowColor">@Html.Raw(sectionEyebrow)</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(sectionTitle))
                    {
                        <h2 id="@headingId" class="oc-fccg-title text-notransform">@Html.Raw(sectionTitle)</h2>
                    }
                    @if (!string.IsNullOrWhiteSpace(sectionDescription))
                    {
                        <div class="oc-fccg-description">@Html.Raw(sectionDescription)</div>
                    }
                </div>
            }

            <div class="oc-fccg-rows">
                @for (var rowIndex = 0; rowIndex < rows.Count; rowIndex++)
                {
                    var cards = new List<dynamic>();
                    var cardValues = GetDynamicValue(rows[rowIndex], "ContentCards") as IEnumerable;
                    if (cardValues != null)
                    {
                        foreach (var cardValue in cardValues)
                        {
                            if (cards.Count >= 3)
                            {
                                break;
                            }

                            cards.Add(cardValue);
                        }
                    }

                    if (cards.Count > 0)
                    {
                        var columnClass = cards.Count == 1 ? "col-12" : (cards.Count == 2 ? "col-12 col-lg-6" : "col-12 col-md-6 col-lg-4");
                        var showImages = cards.Count < 3;

                        <div class="row g-4 oc-fccg-row" role="list">
                            @for (var cardIndex = 0; cardIndex < cards.Count; cardIndex++)
                            {
                                var card = cards[cardIndex];
                                var cardTitle = GetDynamicString(card, "Title");
                                var cardDescription = GetDynamicString(card, "Description");
                                var actionText = GetDynamicString(card, "ActionText");
                                var actionLink = GetDynamicString(card, "ActionLink");
                                var imageUrl = GetImageUrl(GetDynamicValue(card, "Image"));
                                var imageAlt = GetDynamicString(card, "ImageAlt");
                                var iconClass = GetSafeIconClass(GetDynamicString(card, "CardIcon"));
                                var hasAction = !string.IsNullOrWhiteSpace(actionText)
                                    && UrlValidationHelper.IsLocalOrExternalHttpUrl(actionLink);
                                var hasImage = showImages && UrlValidationHelper.IsLocalOrExternalHttpUrl(imageUrl);
                                var imagePositionClass = cardIndex == 0 ? "oc-fccg-card-image-left" : "oc-fccg-card-image-right";
                                var cardId = sectionId + "-row-" + rowIndex + "-card-" + cardIndex;
                                var cardDelay = ((rowIndex * 3) + cardIndex) * animationStep;
                                var cardClass = "oc-fccg-card " + cardBackgroundClass + " " + (hasImage ? imagePositionClass : string.Empty);

                                <div class="@columnClass d-flex" role="listitem">
                                    <article class="@cardClass w-100@animationClass"
                                             aria-labelledby="@(cardId + "-title")"
                                             data-appear-animation="@animationName"
                                             data-appear-animation-delay="@cardDelay">
                                        @if (hasImage)
                                        {
                                            <div class="oc-fccg-image-wrap">
                                                <img class="oc-fccg-image" src="@imageUrl" alt="@imageAlt" loading="lazy" decoding="async" />
                                            </div>
                                        }

                                        <div class="oc-fccg-card-content">
                                            <div class="oc-fccg-icon @iconColorSetting @iconBackgroundClass" aria-hidden="true">
                                                @if (!string.IsNullOrWhiteSpace(iconClass))
                                                {
                                                    <i class="@iconClass"></i>
                                                }
                                            </div>
                                            <h3 id="@(cardId + "-title")" class="oc-fccg-card-title text-notransform">@Html.Raw(cardTitle)</h3>
                                            <div class="oc-fccg-card-description">@Html.Raw(cardDescription)</div>
                                            @if (hasAction)
                                            {
                                                <a class="oc-fccg-action text-decoration-none stretched-link" href="@actionLink">
                                                    <span>@Html.Raw(actionText)</span>
                                                    <i class="fas fa-chevron-right" aria-hidden="true"></i>
                                                </a>
                                            }
                                        </div>
                                    </article>
                                </div>
                            }
                        </div>
                    }
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(sectionFooter))
            {
                <footer class="oc-fccg-footer text-center mt-5">@Html.Raw(sectionFooter)</footer>
            }
        </div>
    </section>
}

