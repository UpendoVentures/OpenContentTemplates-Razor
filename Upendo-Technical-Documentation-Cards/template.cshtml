@using System
@using System.Collections.Generic
@using System.Globalization
@using System.IO
@using System.Text.RegularExpressions
@using System.Web
@using Upendo.Libraries.RunsOnUpendoCore.Helpers
@inherits Satrabel.OpenContent.Components.OpenContentWebPage

@functions {
    private static object GetDynamicValue(dynamic source, string propertyName)
    {
        if (source == null || string.IsNullOrWhiteSpace(propertyName))
        {
            return null;
        }

        try
        {
            var dictionary = source as IDictionary<string, object>;
            if (dictionary != null && dictionary.ContainsKey(propertyName))
            {
                return dictionary[propertyName];
            }
        }
        catch { }

        try
        {
            return source[propertyName];
        }
        catch { }

        try
        {
            var property = ((object)source).GetType().GetProperty(propertyName);
            return property != null ? property.GetValue(source, null) : null;
        }
        catch
        {
            return null;
        }
    }

    private static string GetDynamicString(dynamic source, string propertyName)
    {
        var value = GetDynamicValue(source, propertyName);
        return value != null ? Convert.ToString(value) : string.Empty;
    }

    private static bool GetDynamicBool(dynamic source, string propertyName)
    {
        var value = GetDynamicValue(source, propertyName);
        if (value == null)
        {
            return false;
        }

        try
        {
            if (value is bool)
            {
                return (bool)value;
            }

            bool parsed;
            return bool.TryParse(Convert.ToString(value), out parsed) && parsed;
        }
        catch
        {
            return false;
        }
    }

    private static bool IsSafeFileName(string value)
    {
        return !string.IsNullOrWhiteSpace(value)
            && value.IndexOfAny(new[] { '/', '\\', ':', '?', '#', '<', '>', '|' }) < 0
            && Regex.IsMatch(value.Trim(), "^[a-zA-Z0-9_. -]+$")
            && !HasParentTraversal(value);
    }

    private static string CombineUploadFolderAndFileName(string uploadFolder, string fileName)
    {
        if (string.IsNullOrWhiteSpace(uploadFolder) || !IsSafeFileName(fileName))
        {
            return fileName;
        }

        return uploadFolder.TrimEnd('/', '\\') + "/" + fileName.Trim();
    }

    private static string GetFileUrl(dynamic file)
    {
        return GetFileUrl(file, 0);
    }

    private static string GetFileUrl(dynamic file, int depth)
    {
        if (file == null || depth > 2)
        {
            return string.Empty;
        }

        var directValue = file as string;
        if (!string.IsNullOrWhiteSpace(directValue))
        {
            return directValue;
        }

        var urlProperties = new[] { "Url", "FileUrl", "FilePath", "Path", "FullPath", "MediaUrl", "RelativeUrl", "RelativePath", "FileName", "Name", "Value" };
        foreach (var propertyName in urlProperties)
        {
            var value = GetDynamicString(file, propertyName);
            if (!string.IsNullOrWhiteSpace(value))
            {
                return value;
            }
        }

        var nestedProperties = new[] { "file", "File", "files", "Files", "item", "Item" };
        foreach (var propertyName in nestedProperties)
        {
            var nestedValue = GetDynamicValue(file, propertyName);
            var nestedUrl = GetFileUrl(nestedValue, depth + 1);
            if (!string.IsNullOrWhiteSpace(nestedUrl))
            {
                return nestedUrl;
            }
        }

        try
        {
            var enumerable = file as System.Collections.IEnumerable;
            if (enumerable != null && !(file is string))
            {
                foreach (var item in enumerable)
                {
                    var itemUrl = GetFileUrl(item, depth + 1);
                    if (!string.IsNullOrWhiteSpace(itemUrl))
                    {
                        return itemUrl;
                    }
                }
            }
        }
        catch { }

        try
        {
            var fallbackValue = Convert.ToString(file);
            return !string.IsNullOrWhiteSpace(fallbackValue) ? fallbackValue : string.Empty;
        }
        catch
        {
            return string.Empty;
        }
    }

    private static string GetUploadFileUrl(dynamic file, string uploadFolder)
    {
        var fileUrl = GetFileUrl(file);
        return IsSafeFileName(fileUrl) ? CombineUploadFolderAndFileName(uploadFolder, fileUrl) : fileUrl;
    }

    private static string GetObjectTypeName(object value)
    {
        if (value == null)
        {
            return "null";
        }

        try
        {
            return value.GetType().FullName;
        }
        catch
        {
            return "unknown";
        }
    }

    private static bool TryGetLong(object value, out long result)
    {
        result = 0;
        if (value == null)
        {
            return false;
        }

        try
        {
            if (value is long)
            {
                result = (long)value;
                return true;
            }

            if (value is int)
            {
                result = (int)value;
                return true;
            }

            if (value is decimal)
            {
                result = Convert.ToInt64((decimal)value);
                return true;
            }

            if (value is double)
            {
                result = Convert.ToInt64((double)value);
                return true;
            }

            return long.TryParse(Convert.ToString(value), NumberStyles.Integer, CultureInfo.InvariantCulture, out result);
        }
        catch
        {
            result = 0;
            return false;
        }
    }

    private static Type GetLoadedType(string typeName)
    {
        try
        {
            var directType = Type.GetType(typeName);
            if (directType != null)
            {
                return directType;
            }

            foreach (var assembly in AppDomain.CurrentDomain.GetAssemblies())
            {
                var type = assembly.GetType(typeName, false);
                if (type != null)
                {
                    return type;
                }
            }
        }
        catch { }

        return null;
    }

    private static object GetDnnFileManagerInstance()
    {
        try
        {
            var fileManagerType = GetLoadedType("DotNetNuke.Services.FileSystem.FileManager");
            if (fileManagerType == null)
            {
                return null;
            }

            var instanceProperty = fileManagerType.GetProperty("Instance");
            return instanceProperty != null ? instanceProperty.GetValue(null, null) : null;
        }
        catch
        {
            return null;
        }
    }

    private static object GetDnnFolderManagerInstance()
    {
        try
        {
            var folderManagerType = GetLoadedType("DotNetNuke.Services.FileSystem.FolderManager");
            if (folderManagerType == null)
            {
                return null;
            }

            var instanceProperty = folderManagerType.GetProperty("Instance");
            return instanceProperty != null ? instanceProperty.GetValue(null, null) : null;
        }
        catch
        {
            return null;
        }
    }

    private static object GetDnnFileInfo(int fileId)
    {
        if (fileId <= 0)
        {
            return null;
        }

        try
        {
            var fileManager = GetDnnFileManagerInstance();
            if (fileManager == null)
            {
                return null;
            }

            var getFile = fileManager.GetType().GetMethod("GetFile", new[] { typeof(int) });
            return getFile != null ? getFile.Invoke(fileManager, new object[] { fileId }) : null;
        }
        catch
        {
            return null;
        }
    }

    private class DnnPortalFilePath
    {
        public int PortalId { get; set; }
        public string RelativePath { get; set; }
        public string FolderPath { get; set; }
        public string FileName { get; set; }
    }

    private class DnnFileLookupResult
    {
        public object File { get; set; }
        public string Strategy { get; set; }
    }

    private static bool TryGetDnnPortalFilePath(string fileUrl, int currentPortalId, out DnnPortalFilePath filePath)
    {
        filePath = null;
        if (string.IsNullOrWhiteSpace(fileUrl))
        {
            return false;
        }

        var path = fileUrl.Trim().Split(new[] { '?', '#' }, 2)[0];
        if (string.IsNullOrWhiteSpace(path) || path.StartsWith("#") || path.StartsWith("//") || LooksLikePhysicalPath(path))
        {
            return false;
        }

        Uri parsedUri;
        if (Uri.TryCreate(path, UriKind.Absolute, out parsedUri))
        {
            return false;
        }

        try
        {
            path = HttpUtility.UrlDecode(path);
        }
        catch { }

        if (string.IsNullOrWhiteSpace(path) || HasParentTraversal(path))
        {
            return false;
        }

        path = path.Replace('\\', '/');
        if (path.StartsWith("~/"))
        {
            path = path.Substring(1);
        }
        if (!path.StartsWith("/"))
        {
            path = "/" + path;
        }

        int portalId = currentPortalId;
        string relativePath = string.Empty;
        var portalMatch = Regex.Match(path, "^/Portals/([0-9]+)/(.+)$", RegexOptions.IgnoreCase);
        if (portalMatch.Success)
        {
            if (!int.TryParse(portalMatch.Groups[1].Value, NumberStyles.Integer, CultureInfo.InvariantCulture, out portalId))
            {
                return false;
            }

            relativePath = portalMatch.Groups[2].Value;
        }
        else if (path.StartsWith("/Downloads/", StringComparison.OrdinalIgnoreCase))
        {
            relativePath = path.TrimStart('/');
        }
        else
        {
            return false;
        }

        if (string.IsNullOrWhiteSpace(relativePath) || HasParentTraversal(relativePath))
        {
            return false;
        }

        var fileName = Path.GetFileName(relativePath);
        if (!IsSafeFileName(fileName))
        {
            return false;
        }

        var folderPath = relativePath.Substring(0, relativePath.Length - fileName.Length).Trim('/');
        filePath = new DnnPortalFilePath
        {
            PortalId = portalId,
            RelativePath = relativePath.Trim('/'),
            FolderPath = string.IsNullOrWhiteSpace(folderPath) ? string.Empty : folderPath + "/",
            FileName = fileName
        };
        return true;
    }

    private static object InvokeDnnGetFile(object fileManager, System.Reflection.MethodInfo method, object[] values)
    {
        try
        {
            var result = method.Invoke(method.IsStatic ? null : fileManager, values);
            return result;
        }
        catch
        {
            return null;
        }
    }

    private static object InvokeDnnMethod(object target, System.Reflection.MethodInfo method, object[] values)
    {
        try
        {
            return method.Invoke(method.IsStatic ? null : target, values);
        }
        catch
        {
            return null;
        }
    }

    private static DnnFileLookupResult CreateDnnFileLookupResult(object dnnFile, string strategy)
    {
        return new DnnFileLookupResult
        {
            File = dnnFile,
            Strategy = string.IsNullOrWhiteSpace(strategy) ? "none" : strategy
        };
    }

    private static DnnFileLookupResult TryGetDnnFileWithFileManager(DnnPortalFilePath filePath)
    {
        try
        {
            var fileManager = GetDnnFileManagerInstance();
            if (fileManager == null)
            {
                return CreateDnnFileLookupResult(null, "none");
            }

            foreach (var method in fileManager.GetType().GetMethods())
            {
                if (method.Name != "GetFile")
                {
                    continue;
                }

                var parameters = method.GetParameters();
                if (parameters.Length == 2 && parameters[0].ParameterType == typeof(int) && parameters[1].ParameterType == typeof(string))
                {
                    var relativePathValues = new[] { filePath.RelativePath, "/" + filePath.RelativePath, "Portals/" + filePath.PortalId.ToString(CultureInfo.InvariantCulture) + "/" + filePath.RelativePath };
                    foreach (var relativePathValue in relativePathValues)
                    {
                        var result = InvokeDnnGetFile(fileManager, method, new object[] { filePath.PortalId, relativePathValue });
                        if (result != null)
                        {
                            return CreateDnnFileLookupResult(result, "file-manager-relative-path");
                        }
                    }
                }
                else if (parameters.Length == 3 && parameters[0].ParameterType == typeof(int) && parameters[1].ParameterType == typeof(string) && parameters[2].ParameterType == typeof(string))
                {
                    var folderPathValues = new[] { filePath.FolderPath, filePath.FolderPath.TrimEnd('/'), "/" + filePath.FolderPath, "/" + filePath.FolderPath.TrimEnd('/') };
                    foreach (var folderPathValue in folderPathValues)
                    {
                        var result = InvokeDnnGetFile(fileManager, method, new object[] { filePath.PortalId, folderPathValue, filePath.FileName });
                        if (result != null)
                        {
                            return CreateDnnFileLookupResult(result, "file-manager-folder-file-name");
                        }
                    }
                }
            }
        }
        catch { }

        return CreateDnnFileLookupResult(null, "none");
    }

    private static object TryGetDnnFolder(DnnPortalFilePath filePath)
    {
        try
        {
            var folderManager = GetDnnFolderManagerInstance();
            if (folderManager == null)
            {
                return null;
            }

            foreach (var method in folderManager.GetType().GetMethods())
            {
                if (method.Name != "GetFolder")
                {
                    continue;
                }

                var parameters = method.GetParameters();
                if (parameters.Length == 2 && parameters[0].ParameterType == typeof(int) && parameters[1].ParameterType == typeof(string))
                {
                    var folderPathValues = new[] { filePath.FolderPath, filePath.FolderPath.TrimEnd('/'), "/" + filePath.FolderPath, "/" + filePath.FolderPath.TrimEnd('/') };
                    foreach (var folderPathValue in folderPathValues)
                    {
                        var result = InvokeDnnMethod(folderManager, method, new object[] { filePath.PortalId, folderPathValue });
                        if (result != null)
                        {
                            return result;
                        }
                    }
                }
            }
        }
        catch { }

        return null;
    }

    private static object TryGetDnnFileWithFolderManager(DnnPortalFilePath filePath)
    {
        var folder = TryGetDnnFolder(filePath);
        if (folder == null)
        {
            return null;
        }

        try
        {
            var fileManager = GetDnnFileManagerInstance();
            if (fileManager == null)
            {
                return null;
            }

            foreach (var method in fileManager.GetType().GetMethods())
            {
                if (method.Name != "GetFile")
                {
                    continue;
                }

                var parameters = method.GetParameters();
                if (parameters.Length == 2 && parameters[1].ParameterType == typeof(string) && parameters[0].ParameterType.IsInstanceOfType(folder))
                {
                    var result = InvokeDnnGetFile(fileManager, method, new object[] { folder, filePath.FileName });
                    if (result != null)
                    {
                        return result;
                    }
                }
            }
        }
        catch { }

        return null;
    }

    private static object TryGetDnnFileWithFileController(DnnPortalFilePath filePath)
    {
        try
        {
            var fileControllerType = GetLoadedType("DotNetNuke.Services.FileSystem.FileController");
            if (fileControllerType == null)
            {
                return null;
            }

            object fileController = null;
            var instanceProperty = fileControllerType.GetProperty("Instance");
            if (instanceProperty != null)
            {
                fileController = instanceProperty.GetValue(null, null);
            }
            if (fileController == null)
            {
                try
                {
                    fileController = Activator.CreateInstance(fileControllerType);
                }
                catch { }
            }

            foreach (var method in fileControllerType.GetMethods())
            {
                if (method.Name.IndexOf("GetFile", StringComparison.OrdinalIgnoreCase) < 0)
                {
                    continue;
                }

                var parameters = method.GetParameters();
                if (!method.IsStatic && fileController == null)
                {
                    continue;
                }

                var target = method.IsStatic ? null : fileController;
                if (parameters.Length == 2 && parameters[0].ParameterType == typeof(int) && parameters[1].ParameterType == typeof(string))
                {
                    var relativePathValues = new[] { filePath.RelativePath, "/" + filePath.RelativePath, "Portals/" + filePath.PortalId.ToString(CultureInfo.InvariantCulture) + "/" + filePath.RelativePath };
                    foreach (var relativePathValue in relativePathValues)
                    {
                        var result = InvokeDnnMethod(target, method, new object[] { filePath.PortalId, relativePathValue });
                        if (result != null)
                        {
                            return result;
                        }
                    }
                }
                else if (parameters.Length == 2 && parameters[0].ParameterType == typeof(string) && parameters[1].ParameterType == typeof(int))
                {
                    var relativePathValues = new[] { filePath.RelativePath, "/" + filePath.RelativePath, "Portals/" + filePath.PortalId.ToString(CultureInfo.InvariantCulture) + "/" + filePath.RelativePath };
                    foreach (var relativePathValue in relativePathValues)
                    {
                        var result = InvokeDnnMethod(target, method, new object[] { relativePathValue, filePath.PortalId });
                        if (result != null)
                        {
                            return result;
                        }
                    }
                }
                else if (parameters.Length == 3 && parameters[0].ParameterType == typeof(int) && parameters[1].ParameterType == typeof(string) && parameters[2].ParameterType == typeof(string))
                {
                    var result = InvokeDnnMethod(target, method, new object[] { filePath.PortalId, filePath.FolderPath, filePath.FileName });
                    if (result != null)
                    {
                        return result;
                    }
                }
                else if (parameters.Length == 3 && parameters[0].ParameterType == typeof(string) && parameters[1].ParameterType == typeof(string) && parameters[2].ParameterType == typeof(int))
                {
                    var result = InvokeDnnMethod(target, method, new object[] { filePath.FolderPath, filePath.FileName, filePath.PortalId });
                    if (result != null)
                    {
                        return result;
                    }
                }
            }
        }
        catch { }

        return null;
    }

    private static DnnFileLookupResult GetDnnFileLookupByPath(string fileUrl, int portalId)
    {
        DnnPortalFilePath filePath;
        if (!TryGetDnnPortalFilePath(fileUrl, portalId, out filePath))
        {
            return CreateDnnFileLookupResult(null, "none");
        }

        var fileManagerResult = TryGetDnnFileWithFileManager(filePath);
        if (fileManagerResult.File != null)
        {
            return fileManagerResult;
        }

        var folderManagerResult = TryGetDnnFileWithFolderManager(filePath);
        if (folderManagerResult != null)
        {
            return CreateDnnFileLookupResult(folderManagerResult, "folder-manager-file-name");
        }

        var fileControllerResult = TryGetDnnFileWithFileController(filePath);
        if (fileControllerResult != null)
        {
            return CreateDnnFileLookupResult(fileControllerResult, "file-controller");
        }

        return CreateDnnFileLookupResult(null, "none");
    }

    private static object GetDnnFileInfoByPath(string fileUrl, int portalId)
    {
        return GetDnnFileLookupByPath(fileUrl, portalId).File;
    }

    private static long GetDnnFileSizeBytes(object dnnFile)
    {
        if (dnnFile == null || dnnFile is string)
        {
            return 0;
        }

        var dnnSizeProperties = new[] { "Size", "FileSize", "Length", "ContentLength", "Bytes", "ContentSize", "FileSizeBytes" };
        foreach (var propertyName in dnnSizeProperties)
        {
            long dnnSize;
            if (TryGetLong(GetDynamicValue(dnnFile, propertyName), out dnnSize) && dnnSize > 0)
            {
                return dnnSize;
            }
        }

        return 0;
    }

    private static string GetDnnFileUrl(object dnnFile)
    {
        if (dnnFile == null)
        {
            return string.Empty;
        }

        try
        {
            var fileManager = GetDnnFileManagerInstance();
            if (fileManager != null)
            {
                foreach (var method in fileManager.GetType().GetMethods())
                {
                    var parameters = method.GetParameters();
                    if (method.Name == "GetUrl" && parameters.Length == 1 && parameters[0].ParameterType.IsInstanceOfType(dnnFile))
                    {
                        var value = method.Invoke(fileManager, new[] { dnnFile });
                        return value != null ? Convert.ToString(value) : string.Empty;
                    }
                }
            }
        }
        catch { }

        var urlProperties = new[] { "Url", "FileUrl", "RelativeUrl", "RelativePath", "Path" };
        foreach (var propertyName in urlProperties)
        {
            var value = GetDynamicString(dnnFile, propertyName);
            if (!string.IsNullOrWhiteSpace(value))
            {
                return value;
            }
        }

        return string.Empty;
    }

    private static bool TryGetFileId(dynamic file, out int fileId)
    {
        return TryGetFileId(file, out fileId, 0);
    }

    private static bool TryGetFileId(dynamic file, out int fileId, int depth)
    {
        fileId = 0;
        if (file == null || depth > 2)
        {
            return false;
        }

        long numericValue = 0;
        if ((file is string || file is int || file is long || file is decimal || file is double) && TryGetLong(file, out numericValue) && numericValue > 0 && numericValue <= int.MaxValue)
        {
            fileId = Convert.ToInt32(numericValue);
            return true;
        }

        var idProperties = new[] { "FileId", "FileID", "Id", "ID", "fileId", "fileID", "id", "Value" };
        foreach (var propertyName in idProperties)
        {
            if (TryGetLong(GetDynamicValue(file, propertyName), out numericValue) && numericValue > 0 && numericValue <= int.MaxValue)
            {
                fileId = Convert.ToInt32(numericValue);
                return true;
            }
        }

        var nestedProperties = new[] { "file", "File", "files", "Files", "item", "Item" };
        foreach (var propertyName in nestedProperties)
        {
            var nestedValue = GetDynamicValue(file, propertyName);
            if (TryGetFileId(nestedValue, out fileId, depth + 1))
            {
                return true;
            }
        }

        try
        {
            var enumerable = file as System.Collections.IEnumerable;
            if (enumerable != null && !(file is string))
            {
                foreach (var item in enumerable)
                {
                    if (TryGetFileId(item, out fileId, depth + 1))
                    {
                        return true;
                    }
                }
            }
        }
        catch { }

        return false;
    }

    private static bool IsPathUnderRoot(string fullPath, string rootPath)
    {
        if (string.IsNullOrWhiteSpace(fullPath) || string.IsNullOrWhiteSpace(rootPath))
        {
            return false;
        }

        var normalizedRoot = rootPath.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar) + Path.DirectorySeparatorChar;
        return fullPath.StartsWith(normalizedRoot, StringComparison.OrdinalIgnoreCase);
    }

    private static bool HasParentTraversal(string path)
    {
        if (string.IsNullOrWhiteSpace(path))
        {
            return false;
        }

        var segments = path.Split(new[] { '/', '\\' }, StringSplitOptions.RemoveEmptyEntries);
        foreach (var segment in segments)
        {
            if (segment == "..")
            {
                return true;
            }
        }

        return false;
    }

    private static bool LooksLikePhysicalPath(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return false;
        }

        var trimmed = value.Trim();
        return trimmed.StartsWith(@"\\")
            || trimmed.StartsWith("file:", StringComparison.OrdinalIgnoreCase)
            || Regex.IsMatch(trimmed, "^[a-zA-Z]:[\\\\/]")
            || Regex.IsMatch(trimmed, "^[a-zA-Z]:");
    }

    private static string MapExistingFilePath(string virtualPath)
    {
        if (string.IsNullOrWhiteSpace(virtualPath))
        {
            return string.Empty;
        }

        try
        {
            var context = HttpContext.Current;
            if (context == null || context.Server == null)
            {
                return string.Empty;
            }

            var rootPath = Path.GetFullPath(context.Server.MapPath("~/"));
            var physicalPath = Path.GetFullPath(context.Server.MapPath(virtualPath));
            if (!IsPathUnderRoot(physicalPath, rootPath))
            {
                return string.Empty;
            }

            return File.Exists(physicalPath) ? physicalPath : string.Empty;
        }
        catch
        {
            return string.Empty;
        }
    }

    private static string NormalizePortalFilePath(string path, int portalId)
    {
        if (string.IsNullOrWhiteSpace(path))
        {
            return string.Empty;
        }

        var normalizedPath = path.StartsWith("~/") || path.StartsWith("/") ? path : "/" + path;
        if (normalizedPath.StartsWith("~/Portals/", StringComparison.OrdinalIgnoreCase) || normalizedPath.StartsWith("/Portals/", StringComparison.OrdinalIgnoreCase))
        {
            return normalizedPath;
        }

        if (normalizedPath.StartsWith("~/"))
        {
            normalizedPath = normalizedPath.Substring(1);
        }

        if (normalizedPath.StartsWith("/Downloads/", StringComparison.OrdinalIgnoreCase) || normalizedPath.StartsWith("/Images/", StringComparison.OrdinalIgnoreCase) || normalizedPath.StartsWith("/Videos/", StringComparison.OrdinalIgnoreCase) || normalizedPath.StartsWith("/Content/", StringComparison.OrdinalIgnoreCase))
        {
            return "/Portals/" + portalId.ToString(CultureInfo.InvariantCulture) + normalizedPath;
        }

        return string.Empty;
    }

    private static string GetLocalFilePath(string fileUrl, int portalId)
    {
        if (string.IsNullOrWhiteSpace(fileUrl))
        {
            return string.Empty;
        }

        var path = fileUrl.Trim().Split(new[] { '?', '#' }, 2)[0];
        if (string.IsNullOrWhiteSpace(path) || path.StartsWith("#") || path.StartsWith("//"))
        {
            return string.Empty;
        }

        Uri parsedUri;
        if (Uri.TryCreate(path, UriKind.Absolute, out parsedUri))
        {
            return string.Empty;
        }

        try
        {
            path = HttpUtility.UrlDecode(path);
        }
        catch { }

        if (string.IsNullOrWhiteSpace(path) || path.StartsWith(@"\\") || HasParentTraversal(path))
        {
            return string.Empty;
        }

        var normalizedPath = NormalizePortalFilePath(path, portalId);
        if (string.IsNullOrWhiteSpace(normalizedPath))
        {
            return string.Empty;
        }

        var mappedPath = MapExistingFilePath(normalizedPath);
        if (!string.IsNullOrWhiteSpace(mappedPath))
        {
            return mappedPath;
        }

        return string.Empty;
    }

    private static bool HasLocalFile(dynamic file, string fileUrl, int portalId)
    {
        if (!string.IsNullOrWhiteSpace(GetLocalFilePath(fileUrl, portalId)))
        {
            return true;
        }

        int fileId;
        if (TryGetFileId(file, out fileId))
        {
            var dnnUrl = GetDnnFileUrl(GetDnnFileInfo(fileId));
            return !string.IsNullOrWhiteSpace(dnnUrl) && !string.IsNullOrWhiteSpace(GetLocalFilePath(dnnUrl, portalId));
        }

        return false;
    }

    private static bool HasDnnFileByPath(string fileUrl, int portalId)
    {
        return GetDnnFileInfoByPath(fileUrl, portalId) != null;
    }

    private static string GetDnnFileLookupStrategyByPath(string fileUrl, int portalId)
    {
        return GetDnnFileLookupByPath(fileUrl, portalId).Strategy;
    }

    private static long GetLocalFileSizeBytes(string fileUrl, int portalId)
    {
        var localPath = GetLocalFilePath(fileUrl, portalId);
        if (string.IsNullOrWhiteSpace(localPath))
        {
            return 0;
        }

        try
        {
            var localFile = new FileInfo(localPath);
            var localFileSize = localFile.Length;
            var protectedResourcePath = localPath + ".resources";

            if (File.Exists(protectedResourcePath))
            {
                var protectedResourceSize = new FileInfo(protectedResourcePath).Length;
                if (protectedResourceSize > localFileSize)
                {
                    return protectedResourceSize;
                }
            }

            return localFileSize;
        }
        catch
        {
            return 0;
        }
    }

    private static long GetFileSizeBytes(dynamic file, string fileUrl, int portalId)
    {
        return GetFileSizeBytes(file, fileUrl, portalId, 0);
    }

    private static long GetFileSizeBytes(dynamic file, string fileUrl, int portalId, int depth)
    {
        if (file == null || depth > 2)
        {
            return depth == 0 ? GetLocalFileSizeBytes(fileUrl, portalId) : 0;
        }

        if (!(file is string))
        {
            var sizeProperties = new[] { "Size", "FileSize", "Length", "ContentLength", "Bytes", "ContentSize", "FileSizeBytes" };
            foreach (var propertyName in sizeProperties)
            {
                long size;
                if (TryGetLong(GetDynamicValue(file, propertyName), out size) && size > 0)
                {
                    return size;
                }
            }
        }

        int fileId;
        if (TryGetFileId(file, out fileId))
        {
            var dnnFile = GetDnnFileInfo(fileId);
            var dnnSize = GetDnnFileSizeBytes(dnnFile);
            if (dnnSize > 0)
            {
                return dnnSize;
            }
        }

        var dnnPathSize = GetDnnFileSizeBytes(GetDnnFileInfoByPath(fileUrl, portalId));
        if (dnnPathSize > 0)
        {
            return dnnPathSize;
        }

        var nestedProperties = new[] { "file", "File", "files", "Files", "item", "Item" };
        foreach (var propertyName in nestedProperties)
        {
            var nestedValue = GetDynamicValue(file, propertyName);
            long nestedSize = GetFileSizeBytes(nestedValue, fileUrl, portalId, depth + 1);
            if (nestedSize > 0)
            {
                return nestedSize;
            }
        }

        try
        {
            var enumerable = file as System.Collections.IEnumerable;
            if (enumerable != null && !(file is string))
            {
                foreach (var item in enumerable)
                {
                    long itemSize = GetFileSizeBytes(item, fileUrl, portalId, depth + 1);
                    if (itemSize > 0)
                    {
                        return itemSize;
                    }
                }
            }
        }
        catch { }

        return depth == 0 ? GetLocalFileSizeBytes(fileUrl, portalId) : 0;
    }

    private static string ResolveUploadFileUrl(dynamic file, string uploadFolder)
    {
        var fileUrl = GetUploadFileUrl(file, uploadFolder);
        int fileId;
        if (!string.IsNullOrWhiteSpace(fileUrl) && !Regex.IsMatch(fileUrl.Trim(), "^[0-9]+$"))
        {
            return fileUrl;
        }

        if (TryGetFileId(file, out fileId))
        {
            var dnnUrl = GetDnnFileUrl(GetDnnFileInfo(fileId));
            if (!string.IsNullOrWhiteSpace(dnnUrl))
            {
                return dnnUrl;
            }
        }

        return fileUrl;
    }

    private static string FormatFileSize(long bytes)
    {
        if (bytes <= 0)
        {
            return "0 MB";
        }

        if (bytes < 1048576)
        {
            var kilobytes = Math.Floor(bytes / 1024d);
            return kilobytes.ToString("0", CultureInfo.InvariantCulture) + " KB";
        }

        var megabytes = Math.Floor((bytes / 1048576d) * 100d) / 100d;
        return megabytes.ToString("0.##", CultureInfo.InvariantCulture) + " MB";
    }

    private static string GetLegacyFileTypeLabel(string fileMeta)
    {
        if (string.IsNullOrWhiteSpace(fileMeta))
        {
            return string.Empty;
        }

        var separatorIndex = fileMeta.IndexOf("|", StringComparison.Ordinal);
        return separatorIndex > 0 ? fileMeta.Substring(0, separatorIndex).Trim() : string.Empty;
    }

    private static string GetLegacyFileSizeLabel(string fileMeta)
    {
        if (string.IsNullOrWhiteSpace(fileMeta))
        {
            return string.Empty;
        }

        var separatorIndex = fileMeta.IndexOf("|", StringComparison.Ordinal);
        return separatorIndex >= 0 && separatorIndex < fileMeta.Length - 1 ? fileMeta.Substring(separatorIndex + 1).Trim() : string.Empty;
    }

    private static string GetFileExtensionLabel(string fileUrl)
    {
        if (string.IsNullOrWhiteSpace(fileUrl))
        {
            return string.Empty;
        }

        var cleanUrl = fileUrl.Split(new[] { '?', '#' }, 2)[0];
        var lastDot = cleanUrl.LastIndexOf('.');
        if (lastDot < 0 || lastDot == cleanUrl.Length - 1)
        {
            return string.Empty;
        }

        var extension = cleanUrl.Substring(lastDot + 1).Trim();
        return Regex.IsMatch(extension, "^[a-zA-Z0-9]{1,8}$") ? extension.ToUpperInvariant() : string.Empty;
    }

    private static string BuildFileMeta(string fileTypeLabel, string fileSize)
    {
        var size = !string.IsNullOrWhiteSpace(fileSize) ? fileSize : "0 MB";
        return !string.IsNullOrWhiteSpace(fileTypeLabel) ? fileTypeLabel.Trim() + " | " + size : size;
    }

    private static string AllowList(string value, string fallback, ISet<string> allowed)
    {
        var normalized = !string.IsNullOrWhiteSpace(value) ? value.Trim() : fallback;
        return allowed.Contains(normalized) ? normalized : fallback;
    }

    private static string NormalizeFileSource(string value)
    {
        var normalized = !string.IsNullOrWhiteSpace(value) ? value.Trim().ToLowerInvariant() : "url";
        return normalized == "upload" || normalized == "upload file" ? "upload" : "url";
    }

    private static string SanitizeAnchor(string value)
    {
        return !string.IsNullOrWhiteSpace(value) && Regex.IsMatch(value, "^[a-zA-Z0-9\\-]+$")
            ? value.Trim()
            : string.Empty;
    }

    private static string SanitizeIconClass(string value)
    {
        return !string.IsNullOrWhiteSpace(value) && Regex.IsMatch(value.Trim(), "^[a-zA-Z0-9_\\- ]+$")
            ? value.Trim()
            : string.Empty;
    }

    private static string GetSafeUrl(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        var url = value.Trim();
        if (url.StartsWith("#") || (url.StartsWith("/") && !url.StartsWith("//")))
        {
            return url;
        }

        Uri parsed;
        if (!Uri.TryCreate(url, UriKind.Absolute, out parsed))
        {
            return string.Empty;
        }

        var scheme = parsed.Scheme.ToLowerInvariant();
        return scheme == Uri.UriSchemeHttp || scheme == Uri.UriSchemeHttps || scheme == Uri.UriSchemeMailto || scheme == "tel"
            ? url
            : string.Empty;
    }

    private static bool IsEditMode(dynamic context)
    {
        try
        {
            return GetDynamicBool(context, "IsEditMode");
        }
        catch
        {
            return false;
        }
    }

    private static int NormalizeCardsPerRow(string value)
    {
        int cardsPerRow;
        return int.TryParse(value, out cardsPerRow) && cardsPerRow >= 1 && cardsPerRow <= 4
            ? cardsPerRow
            : 3;
    }
}

@{
    TemplateHelper.HideAdminBorder(Model.Context.ModuleId, Model.Context.TabId);
    RegisterStyleSheet("template.css");

    var moduleTitle = Model.ModuleTitle != null ? Convert.ToString(Model.ModuleTitle) : string.Empty;
    var moduleAnchor = SanitizeAnchor(Model.ModuleAnchor != null ? Convert.ToString(Model.ModuleAnchor) : string.Empty);
    var sectionHeading = Model.SectionHeading != null ? Convert.ToString(Model.SectionHeading) : string.Empty;
    var sectionHeadingElementSetting = Model.SectionHeadingElement != null ? Convert.ToString(Model.SectionHeadingElement) : string.Empty;
    var introText = Model.IntroText != null ? Convert.ToString(Model.IntroText) : string.Empty;
    var sectionAriaLabel = Model.SectionAriaLabel != null ? Convert.ToString(Model.SectionAriaLabel) : string.Empty;

    var allowedHeadingElements = new HashSet<string>(StringComparer.OrdinalIgnoreCase) { "h2", "h3", "h4" };
    var allowedContainerWidths = new HashSet<string>(StringComparer.OrdinalIgnoreCase) { "container", "container-sm", "container-md", "container-lg", "container-xl", "container-xxl", "container-fluid" };
    var allowedDefaultViews = new HashSet<string>(StringComparer.OrdinalIgnoreCase) { "grid", "list" };
    var allowedBackgrounds = new HashSet<string>(StringComparer.OrdinalIgnoreCase) { "", "bg-light", "bg-white", "bg-dark", "bg-transparent", "bg-body", "bg-primary", "bg-primary-subtle", "bg-secondary-subtle", "bg-light-subtle", "bg-dark-subtle", "bg-off-white", "bg-warm-white", "bg-cream", "bg-soft-beige", "bg-sand", "bg-light-sage", "bg-sage", "bg-pale-green", "bg-mist", "bg-soft-gray", "bg-forest-green" };
    var allowedSpacing = new HashSet<string>(StringComparer.OrdinalIgnoreCase) { "", "mt-0", "mt-1", "mt-2", "mt-3", "mt-4", "mt-5", "mt-auto", "mb-0", "mb-1", "mb-2", "mb-3", "mb-4", "mb-5", "mb-auto", "pt-0", "pt-1", "pt-2", "pt-3", "pt-4", "pt-5", "pt-auto", "pb-0", "pb-1", "pb-2", "pb-3", "pb-4", "pb-5", "pb-auto" };
    var allowedCardStyles = new HashSet<string>(StringComparer.OrdinalIgnoreCase) { "flat", "outlined", "elevated" };
    var allowedCardCorners = new HashSet<string>(StringComparer.OrdinalIgnoreCase) { "square", "soft" };
    var allowedIconColors = new HashSet<string>(StringComparer.OrdinalIgnoreCase) { "primary", "muted", "dark" };
    var uploadFolder = "/Downloads/TechnicalDocumentation";
    var portalId = Model.Context.PortalId;

    var headingElement = AllowList(sectionHeadingElementSetting, "h2", allowedHeadingElements).ToLowerInvariant();
    var containerWidth = AllowList(GetDynamicString(Model.Settings, "ContainerWidth"), "container-xxl", allowedContainerWidths);
    var cardsPerRow = NormalizeCardsPerRow(GetDynamicString(Model.Settings, "CardsPerRow"));
    var defaultView = AllowList(GetDynamicString(Model.Settings, "DefaultView"), "grid", allowedDefaultViews).ToLowerInvariant();
    var backgroundColorClass = AllowList(GetDynamicString(Model.Settings, "BackgroundColorClass"), "bg-light", allowedBackgrounds);
    var marginTop = AllowList(GetDynamicString(Model.Settings, "MarginTop"), "", allowedSpacing);
    var marginBottom = AllowList(GetDynamicString(Model.Settings, "MarginBottom"), "", allowedSpacing);
    var paddingTop = AllowList(GetDynamicString(Model.Settings, "PaddingTop"), "pt-5", allowedSpacing);
    var paddingBottom = AllowList(GetDynamicString(Model.Settings, "PaddingBottom"), "pb-5", allowedSpacing);
    var cardStyle = AllowList(GetDynamicString(Model.Settings, "CardStyle"), "flat", allowedCardStyles).ToLowerInvariant();
    var cardCorners = AllowList(GetDynamicString(Model.Settings, "CardCorners"), "soft", allowedCardCorners).ToLowerInvariant();
    var iconColor = AllowList(GetDynamicString(Model.Settings, "IconColor"), "primary", allowedIconColors).ToLowerInvariant();
    var documents = new List<dynamic>();
    if (Model.Documents != null)
    {
        foreach (var document in Model.Documents)
        {
            documents.Add(document);
        }
    }

    var hasHeading = !string.IsNullOrWhiteSpace(sectionHeading);
    var hasIntro = !string.IsNullOrWhiteSpace(introText);
    var headingId = "oc-tdc-heading-" + Model.Context.ModuleId;
    var sectionClasses = "oc-technical-docs oc-tdc-cards-" + cardsPerRow + " oc-tdc-view-" + defaultView + " oc-tdc-card-" + cardStyle + " oc-tdc-corners-" + cardCorners + " oc-tdc-icon-" + iconColor;
    if (!string.IsNullOrWhiteSpace(backgroundColorClass)) { sectionClasses += " " + backgroundColorClass; }
    if (!string.IsNullOrWhiteSpace(marginTop)) { sectionClasses += " " + marginTop; }
    if (!string.IsNullOrWhiteSpace(marginBottom)) { sectionClasses += " " + marginBottom; }
    if (!string.IsNullOrWhiteSpace(paddingTop)) { sectionClasses += " " + paddingTop; }
    if (!string.IsNullOrWhiteSpace(paddingBottom)) { sectionClasses += " " + paddingBottom; }

    var fallbackAriaLabel = !string.IsNullOrWhiteSpace(sectionAriaLabel) ? sectionAriaLabel : (!string.IsNullOrWhiteSpace(moduleTitle) ? moduleTitle : "Technical documentation");
    var gridPressed = defaultView == "grid" ? "true" : "false";
    var listPressed = defaultView == "list" ? "true" : "false";
}

@if (hasHeading || hasIntro || documents.Count > 0)
{
    <section class="@sectionClasses"@if (!string.IsNullOrWhiteSpace(moduleAnchor)) { <text> id="@moduleAnchor"</text> }@if (hasHeading) { <text> aria-labelledby="@headingId"</text> } else { <text> aria-label="@fallbackAriaLabel"</text> } data-oc-tdc-module="@Model.Context.ModuleId">
        <div class="@containerWidth">
            <div class="oc-tdc-header">
                <div class="oc-tdc-header-content">
                    @if (hasHeading)
                    {
                        @Html.Raw("<" + headingElement + " id=\"" + headingId + "\" class=\"oc-tdc-heading text-notransform\">")@Html.Raw(sectionHeading)@Html.Raw("</" + headingElement + ">")
                    }
                    @if (hasIntro)
                    {
                        <div class="oc-tdc-intro">@Html.Raw(introText)</div>
                    }
                </div>

                <div class="oc-tdc-view-toggle" aria-label="Document layout view">
                    <button class="oc-tdc-toggle-button" type="button" data-oc-tdc-view="grid" aria-pressed="@gridPressed">
                        <i class="fas fa-th-large oc-tdc-toggle-icon" aria-hidden="true"></i>
                        <span class="visually-hidden">Grid view</span>
                    </button>
                    <button class="oc-tdc-toggle-button" type="button" data-oc-tdc-view="list" aria-pressed="@listPressed">
                        <i class="fas fa-list oc-tdc-toggle-icon" aria-hidden="true"></i>
                        <span class="visually-hidden">List view</span>
                    </button>
                </div>
            </div>

            @if (documents.Count > 0)
            {
                <ul class="oc-tdc-list">
                    @foreach (var document in documents)
                    {
                        var title = GetDynamicString(document, "Title");
                        var description = GetDynamicString(document, "Description");
                        var legacyFileMeta = GetDynamicString(document, "FileMeta");
                        var fileTypeLabel = GetDynamicString(document, "FileTypeLabel");
                        var iconClass = SanitizeIconClass(GetDynamicString(document, "IconClass"));
                        var footerLabel = GetDynamicString(document, "FooterLabel");
                        var ctaText = GetDynamicString(document, "CtaText");
                        var fileSource = NormalizeFileSource(GetDynamicString(document, "FileSource"));
                        var isUploadSource = fileSource == "upload";
                        var uploadFile = GetDynamicValue(document, "UploadFile");
                        var uploadFileUrl = ResolveUploadFileUrl(uploadFile, uploadFolder);
                        var safeUrl = isUploadSource ? GetSafeUrl(uploadFileUrl) : GetSafeUrl(GetDynamicString(document, "Url"));
                        var uploadSizeBytes = isUploadSource ? GetFileSizeBytes(uploadFile, uploadFileUrl, portalId) : 0;
                        var computedSize = isUploadSource ? FormatFileSize(uploadSizeBytes) : "0 MB";
                        var computedTypeLabel = GetFileExtensionLabel(safeUrl);
                        if (string.IsNullOrWhiteSpace(computedTypeLabel))
                        {
                            computedTypeLabel = !string.IsNullOrWhiteSpace(fileTypeLabel) ? fileTypeLabel : GetLegacyFileTypeLabel(legacyFileMeta);
                        }
                        var legacyFileSize = GetLegacyFileSizeLabel(legacyFileMeta);
                        var fileMeta = isUploadSource
                            ? BuildFileMeta(computedTypeLabel, computedSize)
                            : BuildFileMeta(computedTypeLabel, !string.IsNullOrWhiteSpace(legacyFileSize) ? legacyFileSize : "0 MB");
                        var linkTarget = GetDynamicString(document, "LinkTarget");
                        var ctaAriaLabel = GetDynamicString(document, "CtaAriaLabel");
                        var hasCta = !string.IsNullOrWhiteSpace(ctaText) && !string.IsNullOrWhiteSpace(safeUrl);
                        var opensNewWindow = string.Equals(linkTarget, "_blank", StringComparison.OrdinalIgnoreCase);
                        var ctaLabel = !string.IsNullOrWhiteSpace(ctaAriaLabel) ? ctaAriaLabel : ctaText;

                        <li class="oc-tdc-item">
                            <article class="oc-tdc-card">
                                <div class="oc-tdc-card-main">
                                    <div class="oc-tdc-card-top">
                                        @if (!string.IsNullOrWhiteSpace(iconClass))
                                        {
                                            <span class="oc-tdc-icon" aria-hidden="true"><i class="@iconClass"></i></span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(fileMeta))
                                        {
                                            <span class="oc-tdc-file-meta oc-tdc-file-meta-card">@fileMeta</span>
                                        }
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(title))
                                    {
                                        <h3 class="oc-tdc-card-title">@title</h3>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(description))
                                    {
                                        <p class="oc-tdc-card-description">@description</p>
                                    }
                                </div>

                                <div class="oc-tdc-card-footer">
                                    @if (!string.IsNullOrWhiteSpace(fileMeta))
                                    {
                                        <span class="oc-tdc-file-meta oc-tdc-file-meta-list">@fileMeta</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(footerLabel))
                                    {
                                        <span class="oc-tdc-footer-label">@footerLabel</span>
                                    }
                                    @if (hasCta)
                                    {
                                        <a class="oc-tdc-cta" href="@safeUrl" aria-label="@ctaLabel"@if (opensNewWindow) { <text> target="_blank" rel="noopener noreferrer"</text> }>@ctaText</a>
                                    }
                                </div>
                            </article>
                        </li>
                    }
                </ul>
            }
        </div>
    </section>

    <script>
        (function () {
            var section = document.querySelector('[data-oc-tdc-module="@Model.Context.ModuleId"]');
            if (!section) { return; }

            var buttons = section.querySelectorAll('[data-oc-tdc-view]');
            if (!buttons.length) { return; }

            Array.prototype.forEach.call(buttons, function (button) {
                button.addEventListener('click', function () {
                    var view = button.getAttribute('data-oc-tdc-view') === 'list' ? 'list' : 'grid';
                    section.classList.toggle('oc-tdc-view-list', view === 'list');
                    section.classList.toggle('oc-tdc-view-grid', view === 'grid');

                    Array.prototype.forEach.call(buttons, function (toggleButton) {
                        toggleButton.setAttribute('aria-pressed', toggleButton === button ? 'true' : 'false');
                    });
                });
            });
        }());
    </script>
}
