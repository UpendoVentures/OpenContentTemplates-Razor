@using System
@using System.Collections
@using System.Collections.Generic
@using System.Text.RegularExpressions
@using Upendo.Libraries.RunsOnUpendoCore.Helpers
@inherits Satrabel.OpenContent.Components.OpenContentWebPage

@functions {
    private static object GetDynamicValue(dynamic source, string propertyName)
    {
        if (source == null || string.IsNullOrWhiteSpace(propertyName))
        {
            return null;
        }

        try
        {
            var dictionary = source as IDictionary<string, object>;
            if (dictionary != null && dictionary.ContainsKey(propertyName))
            {
                return dictionary[propertyName];
            }
        }
        catch
        {
        }

        try
        {
            return source[propertyName];
        }
        catch
        {
        }

        try
        {
            var property = ((object)source).GetType().GetProperty(propertyName);
            return property != null ? property.GetValue(source, null) : null;
        }
        catch
        {
            return null;
        }
    }

    private static string GetDynamicString(dynamic source, string propertyName)
    {
        var value = GetDynamicValue(source, propertyName);
        return value != null ? Convert.ToString(value) : string.Empty;
    }

    private static string GetImageUrl(dynamic image)
    {
        if (image == null)
        {
            return string.Empty;
        }

        if (image is string)
        {
            return Convert.ToString(image);
        }

        var url = GetDynamicString(image, "Url");
        return !string.IsNullOrWhiteSpace(url) ? url : GetDynamicString(image, "url");
    }

    private static string AllowList(string value, string fallback, params string[] allowedValues)
    {
        if (!string.IsNullOrWhiteSpace(value))
        {
            foreach (var allowedValue in allowedValues)
            {
                if (string.Equals(value, allowedValue, StringComparison.OrdinalIgnoreCase))
                {
                    return allowedValue;
                }
            }
        }

        return fallback;
    }
}

@{
    TemplateHelper.HideAdminBorder(Model.Context.ModuleId, Model.Context.TabId);
    RegisterStyleSheet("template.css");

    var settings = Model.Settings;
    var moduleTitle = GetDynamicString(Model, "ModuleTitle");
    var headingCss = GetDynamicString(Model, "HeadingCss");
    var moduleAnchor = GetDynamicString(Model, "ModuleAnchor");
    if (!Regex.IsMatch(moduleAnchor ?? string.Empty, @"^[A-Za-z0-9-]+$"))
    {
        moduleAnchor = string.Empty;
    }

    var sectionHeading = GetDynamicString(Model, "SectionHeading");
    var introText = GetDynamicString(Model, "IntroText");
    var allowedColors = new[]
    {
        "bg-primary", "bg-primary-scoped", "bg-secondary", "bg-secondary-scoped", "bg-tertiary",
        "bg-quaternary", "bg-h5", "bg-h6", "bg-success", "bg-danger", "bg-warning", "bg-info",
        "bg-light", "bg-dark", "bg-black", "bg-white", "bg-body", "bg-transparent", "bg-primary-subtle",
        "bg-secondary-subtle", "bg-success-subtle", "bg-danger-subtle", "bg-warning-subtle", "bg-info-subtle",
        "bg-light-subtle", "bg-dark-subtle", "bg-off-white", "bg-warm-white", "bg-cream", "bg-soft-beige",
        "bg-sand", "bg-light-sage", "bg-sage", "bg-pale-green", "bg-mist", "bg-soft-gray", "bg-forest-green"
    };
    var sectionColors = new List<string> { "" };
    sectionColors.AddRange(allowedColors);

    var backgroundColorClass = AllowList(GetDynamicString(settings, "BackgroundColorClass"), string.Empty, sectionColors.ToArray());
    var cardBackgroundColorClass = AllowList(GetDynamicString(settings, "CardBackgroundColorClass"), "bg-light", allowedColors);
    var animationLevel = AllowList(GetDynamicString(settings, "AnimationLevel"), "light", "none", "light", "medium", "high");
    var animationName = animationLevel == "high" ? "zoomIn" : (animationLevel == "medium" ? "fadeInUp" : "fadeIn");
    var animationStep = animationLevel == "high" ? 160 : (animationLevel == "medium" ? 100 : 60);
    var animationClass = animationLevel == "none" ? string.Empty : " appear-animation";

    var marginTop = AllowList(GetDynamicString(settings, "MarginTop"), string.Empty, "", "mt-0", "mt-1", "mt-2", "mt-3", "mt-4", "mt-5", "mt-auto");
    var marginBottom = AllowList(GetDynamicString(settings, "MarginBottom"), string.Empty, "", "mb-0", "mb-1", "mb-2", "mb-3", "mb-4", "mb-5", "mb-auto");
    var paddingTop = AllowList(GetDynamicString(settings, "PaddingTop"), "pt-5", "", "pt-0", "pt-1", "pt-2", "pt-3", "pt-4", "pt-5", "pt-auto");
    var paddingBottom = AllowList(GetDynamicString(settings, "PaddingBottom"), "pb-5", "", "pb-0", "pb-1", "pb-2", "pb-3", "pb-4", "pb-5", "pb-auto");

    var allowedEyebrowColors = new[]
    {
        "", "text-primary", "text-primary-scoped", "text-secondary", "text-secondary-scoped",
        "text-tertiary", "text-quaternary", "text-h1", "text-h2", "text-h3", "text-h4",
        "text-h5", "text-h6", "text-body", "text-body-secondary", "text-body-tertiary",
        "text-dark", "text-black", "text-black-50", "text-light", "text-white", "text-white-50",
        "text-muted", "text-success", "text-danger", "text-warning", "text-info", "text-teal"
    };

    var cards = new List<dynamic>();
    var cardValues = GetDynamicValue(Model, "Cards") as IEnumerable;
    if (cardValues != null)
    {
        foreach (var cardValue in cardValues)
        {
            cards.Add(cardValue);
        }
    }

    var sectionId = "oc-service-cards-alt-" + Model.Context.ModuleId;
    var headingId = sectionId + "-heading";
    var ariaLabel = !string.IsNullOrWhiteSpace(moduleTitle) ? moduleTitle : "Service cards";
    var sectionClass = "oc-service-cards-alt-section w-100 " + backgroundColorClass + " " + marginTop + " " + marginBottom + " " + paddingTop + " " + paddingBottom;
    var headerClass = "oc-service-cards-alt-header text-center mx-auto" + animationClass;
    var hasHeader = !string.IsNullOrWhiteSpace(sectionHeading) || !string.IsNullOrWhiteSpace(introText);
}

@if (!string.IsNullOrWhiteSpace(moduleAnchor))
{
    <div id="@moduleAnchor"></div>
}

@if (hasHeader || cards.Count > 0)
{
    <section id="@sectionId"
             class="@sectionClass"
             data-animation-level="@animationLevel"
             aria-label="@ariaLabel">
        <div class="container-xxl">
            @if (hasHeader)
            {
                <div class="@headerClass"
                        data-appear-animation="@(animationLevel == "none" ? null : animationName)">
                    @if (!string.IsNullOrWhiteSpace(sectionHeading))
                    {
                        <h2 id="@headingId" class="oc-service-cards-alt-heading @headingCss">@Html.Raw(sectionHeading)</h2>
                    }
                    @if (!string.IsNullOrWhiteSpace(introText))
                    {
                        <div class="oc-service-cards-alt-intro mx-auto">@Html.Raw(introText)</div>
                    }
                </div>
            }

            @if (cards.Count > 0)
            {
                <div class="row g-4" role="list">
                    @for (var cardIndex = 0; cardIndex < cards.Count; cardIndex++)
                    {
                        var card = cards[cardIndex];
                        var eyebrow = GetDynamicString(card, "Eyebrow");
                        var eyebrowColorClass = AllowList(GetDynamicString(card, "EyebrowColorClass"), "text-teal", allowedEyebrowColors);
                        var cardImage = GetImageUrl(GetDynamicValue(card, "CardImage"));
                        var cardImageAlt = GetDynamicString(card, "CardImageAlt");
                        var title = GetDynamicString(card, "Title");
                        var titleCss = GetDynamicString(card, "TitleCss");
                        var description = GetDynamicString(card, "Description");
                        var link = GetDynamicValue(card, "Link");
                        var linkUrl = GetDynamicString(link, "Url");
                        var hasLink = UrlValidationHelper.IsLocalOrExternalHttpUrl(linkUrl);
                        var cardId = sectionId + "-card-" + cardIndex;
                        var cardDelay = (cardIndex + 1) * animationStep;
                        var linkedClass = hasLink ? " oc-service-cards-alt-card--linked" : string.Empty;
                        var cardClass = "oc-service-cards-alt-card " + cardBackgroundColorClass + linkedClass + animationClass;

                        <div class="col-12 col-md-6 col-lg-4 d-flex" role="listitem">
                            <article class="@cardClass"
                                     aria-labelledby="@(cardId + "-title")"
                                     data-appear-animation="@(animationLevel == "none" ? null : animationName)"
                                     data-appear-animation-delay="@(animationLevel == "none" ? null : Convert.ToString(cardDelay))">
                                <div class="oc-service-cards-alt-image-wrap">
                                    <img class="oc-service-cards-alt-image"
                                         src="@cardImage"
                                         alt="@cardImageAlt"
                                         loading="lazy"
                                         decoding="async" />
                                </div>

                                <div class="oc-service-cards-alt-content">
                                    @if (!string.IsNullOrWhiteSpace(eyebrow))
                                    {
                                        <div class="oc-service-cards-alt-eyebrow @eyebrowColorClass">@eyebrow</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(title))
                                    {
                                        <h3 id="@(cardId + "-title")" class="oc-service-cards-alt-title @titleCss">@Html.Raw(title)</h3>
                                    }
                                    else
                                    {
                                        <h3 id="@(cardId + "-title")" class="visually-hidden">Service card</h3>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(description))
                                    {
                                        <div class="oc-service-cards-alt-description">@Html.Raw(description)</div>
                                    }
                                </div>

                                @if (hasLink)
                                {
                                    <a class="oc-service-cards-alt-link stretched-link"
                                       href="@linkUrl"
                                       aria-labelledby="@(cardId + "-title")"></a>
                                }
                            </article>
                        </div>
                    }
                </div>
            }
        </div>
    </section>
}
