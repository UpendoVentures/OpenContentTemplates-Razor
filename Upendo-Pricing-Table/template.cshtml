@using System
@using System.Collections
@using System.Collections.Generic
@using System.Text.RegularExpressions
@using Upendo.Libraries.RunsOnUpendoCore.Helpers
@inherits Satrabel.OpenContent.Components.OpenContentWebPage

@functions {
    private static object GetDynamicValue(dynamic source, string propertyName)
    {
        if (source == null || string.IsNullOrWhiteSpace(propertyName))
        {
            return null;
        }

        try
        {
            var dictionary = source as IDictionary<string, object>;
            if (dictionary != null && dictionary.ContainsKey(propertyName))
            {
                return dictionary[propertyName];
            }
        }
        catch
        {
        }

        try
        {
            return source[propertyName];
        }
        catch
        {
        }

        try
        {
            var property = ((object)source).GetType().GetProperty(propertyName);
            return property != null ? property.GetValue(source, null) : null;
        }
        catch
        {
            return null;
        }
    }

    private static string GetDynamicString(dynamic source, string propertyName)
    {
        var value = GetDynamicValue(source, propertyName);
        return value != null ? Convert.ToString(value) : string.Empty;
    }

    private static string GetValueString(object value)
    {
        return value != null ? Convert.ToString(value) : string.Empty;
    }

    private static string AllowList(string value, string fallback, params string[] allowedValues)
    {
        if (!string.IsNullOrWhiteSpace(value))
        {
            foreach (var allowedValue in allowedValues)
            {
                if (string.Equals(value, allowedValue, StringComparison.OrdinalIgnoreCase))
                {
                    return allowedValue;
                }
            }
        }

        return fallback;
    }

    private static bool IsDarkBackground(string value)
    {
        var darkBackgrounds = new[]
        {
            "bg-primary", "bg-primary-scoped", "bg-secondary", "bg-secondary-scoped",
            "bg-tertiary", "bg-quaternary", "bg-h5", "bg-h6", "bg-success", "bg-danger",
            "bg-dark", "bg-forest-green"
        };

        foreach (var darkBackground in darkBackgrounds)
        {
            if (string.Equals(value, darkBackground, StringComparison.OrdinalIgnoreCase))
            {
                return true;
            }
        }

        return false;
    }

    private static string GetContrastTextClass(string backgroundClass)
    {
        return IsDarkBackground(backgroundClass) ? "text-white" : "text-dark";
    }

    private static bool IsChecked(string value)
    {
        return string.Equals(value, "true", StringComparison.OrdinalIgnoreCase)
            || string.Equals(value, "1", StringComparison.OrdinalIgnoreCase)
            || string.Equals(value, "yes", StringComparison.OrdinalIgnoreCase);
    }
}

@{
    TemplateHelper.HideAdminBorder(Model.Context.ModuleId, Model.Context.TabId);
    RegisterStyleSheet("template.css");

    var settings = Model.Settings;
    var moduleAnchor = GetDynamicString(Model, "ModuleAnchor");
    if (!Regex.IsMatch(moduleAnchor ?? string.Empty, @"^[A-Za-z0-9-]+$"))
    {
        moduleAnchor = string.Empty;
    }

    var sectionTitle = GetDynamicString(Model, "SectionTitle");
    var sectionEyebrow = GetDynamicString(Model, "SectionEyebrow");
    var sectionEyebrowColor = AllowList(GetDynamicString(Model, "SectionEyebrowColor"), "text-light",
        "text-primary", "text-primary-scoped", "text-secondary", "text-secondary-scoped", "text-tertiary",
        "text-quaternary", "text-h1", "text-h2", "text-h3", "text-h4", "text-h5", "text-h6", "text-body",
        "text-body-secondary", "text-body-tertiary", "text-dark", "text-black", "text-black-50", "text-light",
        "text-white", "text-white-50", "text-muted", "text-success", "text-danger", "text-warning", "text-info",
        "text-teal");
    var sectionDescription = GetDynamicString(Model, "SectionDescription");
    var sectionFooter = GetDynamicString(Model, "SectionFooter");

    var allowedBackgrounds = new[]
    {
        "", "bg-primary", "bg-primary-scoped", "bg-secondary", "bg-secondary-scoped", "bg-tertiary",
        "bg-quaternary", "bg-h5", "bg-h6", "bg-success", "bg-danger", "bg-warning", "bg-info", "bg-light",
        "bg-dark", "bg-white", "bg-body", "bg-transparent", "bg-primary-subtle", "bg-secondary-subtle",
        "bg-success-subtle", "bg-danger-subtle", "bg-warning-subtle", "bg-info-subtle", "bg-light-subtle",
        "bg-dark-subtle", "bg-off-white", "bg-warm-white", "bg-cream", "bg-soft-beige", "bg-sand", "bg-light-sage",
        "bg-sage", "bg-pale-green", "bg-mist", "bg-soft-gray", "bg-forest-green"
    };

    var cardBackgroundColorClass = AllowList(GetDynamicString(settings, "CardBackgroundColorClass"), "bg-light", allowedBackgrounds);
    var animationLevel = AllowList(GetDynamicString(settings, "AnimationLevel"), "light", "none", "light", "medium", "high");
    var animationName = animationLevel == "high" ? "zoomIn" : (animationLevel == "medium" ? "fadeInUp" : "fadeIn");
    var animationStep = animationLevel == "high" ? 180 : (animationLevel == "medium" ? 110 : 60);
    var animationClass = animationLevel == "none" ? string.Empty : " appear-animation";

    var backgroundColorClass = AllowList(GetDynamicString(settings, "BackgroundColorClass"), string.Empty, allowedBackgrounds);
    var sectionContrastClass = IsDarkBackground(backgroundColorClass) ? "oc-pricing-table--dark" : "oc-pricing-table--light";
    var marginTop = AllowList(GetDynamicString(settings, "MarginTop"), string.Empty, "", "mt-0", "mt-1", "mt-2", "mt-3", "mt-4", "mt-5", "mt-auto");
    var marginBottom = AllowList(GetDynamicString(settings, "MarginBottom"), string.Empty, "", "mb-0", "mb-1", "mb-2", "mb-3", "mb-4", "mb-5", "mb-auto");
    var paddingTop = AllowList(GetDynamicString(settings, "PaddingTop"), "pt-5", "", "pt-0", "pt-1", "pt-2", "pt-3", "pt-4", "pt-5", "pt-auto");
    var paddingBottom = AllowList(GetDynamicString(settings, "PaddingBottom"), "pb-5", "", "pb-0", "pb-1", "pb-2", "pb-3", "pb-4", "pb-5", "pb-auto");

    var cards = new List<dynamic>();
    var cardValues = GetDynamicValue(Model, "PricingCards") as IEnumerable;
    if (cardValues != null)
    {
        foreach (var cardValue in cardValues)
        {
            cards.Add(cardValue);
        }
    }

    var sectionId = "oc-pricing-table-" + Model.Context.ModuleId;
    var headingId = sectionId + "-heading";
    var sectionClass = "oc-pricing-table " + sectionContrastClass + " w-100 " + backgroundColorClass + " " + marginTop + " " + marginBottom + " " + paddingTop + " " + paddingBottom;
    var hasHeader = !string.IsNullOrWhiteSpace(sectionTitle) || !string.IsNullOrWhiteSpace(sectionEyebrow) || !string.IsNullOrWhiteSpace(sectionDescription);
    var hasContent = hasHeader || cards.Count > 0 || !string.IsNullOrWhiteSpace(sectionFooter);
}

@if (!string.IsNullOrWhiteSpace(moduleAnchor))
{
    <div id="@moduleAnchor"></div>
}

@if (hasContent)
{
    <section id="@sectionId" class="@sectionClass" data-animation-level="@animationLevel" aria-labelledby="@headingId">
        <div class="container-xxl">
            @if (hasHeader)
            {
                <div class="oc-pricing-table__header@animationClass" data-appear-animation="@(animationLevel == "none" ? null : animationName) pb-5 mb-5">
                    @if (!string.IsNullOrWhiteSpace(sectionEyebrow))
                    {
                        <div class="oc-pricing-table__section-eyebrow @sectionEyebrowColor d-flex justify-content-center">@Html.Raw(sectionEyebrow)</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(sectionTitle))
                    {
                        <h3 id="@headingId" class="oc-pricing-table__section-title col-md-10 offset-md-1 text-center text-capitalize">@Html.Raw(sectionTitle)</h3>
                    }
                    else
                    {
                        <h3 id="@headingId" class="visually-hidden">Pricing options</h3>
                    }
                    @if (!string.IsNullOrWhiteSpace(sectionDescription))
                    {
                        <div class="oc-pricing-table__section-description">@Html.Raw(sectionDescription)</div>
                    }
                </div>
            }
            else
            {
                <h3 id="@headingId" class="visually-hidden">Pricing options</h3>
            }

            @if (cards.Count > 0)
            {
                <div class="row g-4 align-items-stretch" role="list">
                    @for (var cardIndex = 0; cardIndex < cards.Count; cardIndex++)
                    {
                        var card = cards[cardIndex];
                        var solutionTitle = GetDynamicString(card, "SolutionTitle");
                        var solutionEyebrow = GetDynamicString(card, "SolutionEyebrow");
                        var solutionDescription = GetDynamicString(card, "SolutionDescription");
                        var priceBandColorClass = AllowList(GetDynamicString(card, "PriceBandColor"), "bg-light", allowedBackgrounds);
                        var priceText = GetDynamicString(card, "PriceText");
                        var priceEyebrow = GetDynamicString(card, "PriceEyebrow");
                        var matchText = GetDynamicString(card, "SolutionMatchInnerCardText");
                        var matchColorClass = AllowList(GetDynamicString(card, "SolutionMatchInnerCardColor"), "bg-light", allowedBackgrounds);
                        var nextStepText = GetDynamicString(card, "NextStepText");
                        var nextStepValue = GetDynamicValue(card, "NextStepURL");
                        var nextStepUrl = nextStepValue is string ? Convert.ToString(nextStepValue) : GetDynamicString(nextStepValue, "Url");
                        var hasNextStep = !string.IsNullOrWhiteSpace(nextStepText) && UrlValidationHelper.IsLocalOrExternalHttpUrl(nextStepUrl);
                        var isFeatured = IsChecked(GetDynamicString(card, "IsFeatured"));
                        var cardId = sectionId + "-card-" + cardIndex;
                        var titleId = cardId + "-title";
                        var nextStepId = cardId + "-next-step";
                        var cardDelay = (cardIndex + 1) * animationStep;
                        var cardClass = "card oc-pricing-table__card " + cardBackgroundColorClass + (isFeatured ? " oc-pricing-table__card--featured" : string.Empty) + animationClass;
                        var priceContrastClass = GetContrastTextClass(priceBandColorClass);
                        var matchContrastClass = GetContrastTextClass(matchColorClass);
                        var valuePropositions = GetDynamicValue(card, "SolutionValuePropositions") as IEnumerable;

                        <div class="col-12 col-lg-4 d-flex" role="listitem">
                            <article class="@cardClass"
                                     aria-labelledby="@titleId"
                                     data-appear-animation="@(animationLevel == "none" ? null : animationName)"
                                     data-appear-animation-delay="@(animationLevel == "none" ? null : Convert.ToString(cardDelay))">
                                @if (isFeatured)
                                {
                                    <div class="oc-pricing-table__featured-label" aria-label="Most Popular">
                                        <i class="fas fa-star me-1" aria-hidden="true"></i>Most Popular
                                    </div>
                                }

                                <div class="oc-pricing-table__card-body">
                                    @if (!string.IsNullOrWhiteSpace(solutionEyebrow))
                                    {
                                        <div class="oc-pricing-table__solution-eyebrow">@Html.Raw(solutionEyebrow)</div>
                                    }
                                    <h4 id="@titleId" class="oc-pricing-table__solution-title">@Html.Raw(solutionTitle)</h4>
                                    @if (!string.IsNullOrWhiteSpace(solutionDescription))
                                    {
                                        <div class="oc-pricing-table__solution-description">@Html.Raw(solutionDescription)</div>
                                    }

                                    <div class="oc-pricing-table__price-band @priceBandColorClass @priceContrastClass">
                                        @if (!string.IsNullOrWhiteSpace(priceEyebrow))
                                        {
                                            <div class="oc-pricing-table__price-eyebrow">@Html.Raw(priceEyebrow)</div>
                                        }
                                        <div class="oc-pricing-table__price">@Html.Raw(priceText)</div>
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(matchText))
                                    {
                                        <div class="oc-pricing-table__match @matchColorClass @matchContrastClass">@Html.Raw(matchText)</div>
                                    }

                                    @if (valuePropositions != null)
                                    {
                                        <ul class="oc-pricing-table__propositions">
                                            @foreach (var valueProposition in valuePropositions)
                                            {
                                                var propositionText = GetValueString(valueProposition);
                                                if (!string.IsNullOrWhiteSpace(propositionText))
                                                {
                                                    <li><i class="fas fa-check text-success" aria-hidden="true"></i><span>@Html.Raw(propositionText)</span></li>
                                                }
                                            }
                                        </ul>
                                    }
                                </div>

                                @if (hasNextStep)
                                {
                                    <div class="oc-pricing-table__card-footer">
                                        <a class="oc-pricing-table__next-step @priceContrastClass@(isFeatured ? " oc-pricing-table__next-step--featured " + priceBandColorClass : string.Empty) track-cta"
                                           href="@nextStepUrl"
                                           aria-labelledby="@titleId @nextStepId">
                                            <span id="@nextStepId">@Html.Raw(nextStepText)</span>
                                        </a>
                                    </div>
                                }
                            </article>
                        </div>
                    }
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(sectionFooter))
            {
                <div class="oc-pricing-table__footer">@Html.Raw(sectionFooter)</div>
            }
        </div>
    </section>
}
