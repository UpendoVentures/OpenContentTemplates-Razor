{
  "fields": {
    "TitleAlignment": {
      "type": "select",
      "helper": "Controls the alignment of the compact top title only.",
      "optionLabels": ["Left", "Center", "Right"],
      "removeDefaultNone": true
    },
    "ContentAlignment": {
      "type": "select",
      "helper": "Controls the alignment of the hero heading and body.",
      "optionLabels": ["Left", "Center", "Right"],
      "removeDefaultNone": true
    },
    "ContentColumnWidth": {
      "type": "select",
      "helper": "Bootstrap 3 column width for the hero content.",
      "optionLabels": ["6 columns", "7 columns", "8 columns", "9 columns", "10 columns", "12 columns"],
      "removeDefaultNone": true
    },
    "ContentColumnOffset": {
      "type": "select",
      "helper": "Bootstrap 3 column offset for the hero content.",
      "optionLabels": ["None", "0 columns", "1 column", "2 columns", "3 columns"],
      "removeDefaultNone": true
    },
    "HeroTopSpacing": {
      "type": "select",
      "helper": "Top spacing inside the hero content area. The default 7em matches the legacy example without inline padding.",
      "optionLabels": ["None", "3em", "5em", "7em (default)", "9em", "11em"],
      "removeDefaultNone": true
    },
    "HeroMinHeight": {
      "type": "select",
      "helper": "Optional minimum height for the hero section.",
      "optionLabels": ["Theme default", "360px", "480px", "525px", "560px", "640px"],
      "removeDefaultNone": true
    },
    "OverlayEnabled": {
      "type": "checkbox",
      "helper": "Adds a configurable overlay above the background media and below the text."
    },
    "OverlayColor": {
      "type": "select",
      "helper": "Overlay color used when the overlay is enabled.",
      "optionLabels": ["Black", "Slate", "White"],
      "removeDefaultNone": true,
      "dependencies": {
        "OverlayEnabled": [
          true
        ]
      }
    },
    "OverlayOpacity": {
      "type": "select",
      "helper": "Overlay opacity used when the overlay is enabled.",
      "optionLabels": ["None", "15%", "30% (default)", "45%", "60%", "75%"],
      "removeDefaultNone": true,
      "dependencies": {
        "OverlayEnabled": [
          true
        ]
      }
    },
    "TextColorMode": {
      "type": "select",
      "helper": "Light mode adds the legacy section-text-light class and white text. Theme mode leaves colors to the active theme.",
      "optionLabels": ["Light", "Dark", "Theme Default"],
      "removeDefaultNone": true
    },
    "MarginTop": {
      "title": "Margin (top)",
      "type": "select",
      "optionLabels": ["mt-0", "mt-1", "mt-2", "mt-3", "mt-4", "mt-5", "mt-auto"],
      "removeDefaultNone": true
    },
    "MarginBottom": {
      "title": "Margin (bottom)",
      "type": "select",
      "optionLabels": ["mb-0", "mb-1", "mb-2", "mb-3", "mb-4", "mb-5", "mb-auto"],
      "removeDefaultNone": true
    },
    "PaddingTop": {
      "title": "Padding (top)",
      "type": "select",
      "optionLabels": ["pt-0", "pt-1", "pt-2", "pt-3", "pt-4", "pt-5", "pt-auto"],
      "removeDefaultNone": true
    },
    "PaddingBottom": {
      "title": "Padding (bottom)",
      "type": "select",
      "optionLabels": ["pb-0", "pb-1", "pb-2", "pb-3", "pb-4", "pb-5", "pb-auto"],
      "removeDefaultNone": true
    }
  }
}
