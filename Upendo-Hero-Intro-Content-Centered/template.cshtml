@using System
@using Upendo.Libraries.RunsOnUpendoCore.Helpers
@inherits Satrabel.OpenContent.Components.OpenContentWebPage

@{
    TemplateHelper.HideAdminBorder(Model.Context.ModuleId, Model.Context.TabId);
    RegisterStyleSheet("template.css");

    var moduleAnchor = Model.ModuleAnchor != null ? Convert.ToString(Model.ModuleAnchor) : string.Empty;

    var eyebrowText = Model.EyebrowText != null ? Convert.ToString(Model.EyebrowText) : string.Empty;
    var sectionTitle = Model.SectionTitle != null ? Convert.ToString(Model.SectionTitle) : string.Empty;
    var sectionDescription = Model.SectionDescription != null ? Convert.ToString(Model.SectionDescription) : string.Empty;

    var hasSectionTitle = !string.IsNullOrWhiteSpace(sectionTitle);
    var hasSectionDescription = !string.IsNullOrWhiteSpace(sectionDescription);

    var cta1Text = Model.Cta1Text != null ? Convert.ToString(Model.Cta1Text) : string.Empty;
    var cta1Icon = Model.Cta1Icon != null ? Convert.ToString(Model.Cta1Icon) : string.Empty;
    var cta1Url = Model.Cta1Url != null ? Convert.ToString(Model.Cta1Url) : string.Empty;

    var hasEyebrowText = !string.IsNullOrWhiteSpace(eyebrowText);

    var hasCta1 = !string.IsNullOrWhiteSpace(cta1Text) && !string.IsNullOrWhiteSpace(cta1Url);
    var cta1IconHtml = !string.IsNullOrWhiteSpace(cta1Icon)
        ? "<i class=\"" + HttpUtility.HtmlAttributeEncode(cta1Icon) + " mx-2\" aria-hidden=\"true\"></i>"
        : string.Empty;

    var backgroundColorClass = Model.Settings != null && Model.Settings.BackgroundColorClass != null
        ? Convert.ToString(Model.Settings.BackgroundColorClass)
        : string.Empty;

    var marginTop = Model.Settings != null && Model.Settings.MarginTop != null
        ? Convert.ToString(Model.Settings.MarginTop)
        : string.Empty;

    var marginBottom = Model.Settings != null && Model.Settings.MarginBottom != null
        ? Convert.ToString(Model.Settings.MarginBottom)
        : string.Empty;

    var paddingTop = Model.Settings != null && Model.Settings.PaddingTop != null
        ? Convert.ToString(Model.Settings.PaddingTop)
        : string.Empty;

    var paddingBottom = Model.Settings != null && Model.Settings.PaddingBottom != null
        ? Convert.ToString(Model.Settings.PaddingBottom)
        : string.Empty;

    var darkBackgroundClasses = new[]
    {
        "bg-primary",
        "bg-primary-scoped",
        "bg-secondary",
        "bg-secondary-scoped",
        "bg-tertiary",
        "bg-quaternary",
        "bg-h5",
        "bg-h6",
        "bg-success",
        "bg-danger",
        "bg-dark",
        "bg-dark-subtle",
        "bg-forest-green"
    };

    var isDarkBackground = false;

    if (!string.IsNullOrWhiteSpace(backgroundColorClass))
    {
        foreach (var darkClass in darkBackgroundClasses)
        {
            if (string.Equals(backgroundColorClass, darkClass, StringComparison.OrdinalIgnoreCase))
            {
                isDarkBackground = true;
                break;
            }
        }
    }

    var contrastClass = isDarkBackground ? "oc-centered-intro-band--dark" : "oc-centered-intro-band--light";
    var additionalTextCss = isDarkBackground ? "text-dark" : "text-light";

    var sectionClasses = "oc-centered-intro-band w-100 " + contrastClass;

    if (!string.IsNullOrWhiteSpace(backgroundColorClass))
    {
        sectionClasses += " " + backgroundColorClass;
    }

    if (!string.IsNullOrWhiteSpace(marginTop))
    {
        sectionClasses += " " + marginTop;
    }

    if (!string.IsNullOrWhiteSpace(marginBottom))
    {
        sectionClasses += " " + marginBottom;
    }

    if (!string.IsNullOrWhiteSpace(paddingTop))
    {
        sectionClasses += " " + paddingTop;
    }

    if (!string.IsNullOrWhiteSpace(paddingBottom))
    {
        sectionClasses += " " + paddingBottom;
    }
}

@if (!string.IsNullOrWhiteSpace(moduleAnchor))
{
    <div id="@moduleAnchor"></div>
}

@if (hasSectionTitle || hasSectionDescription)
{
    <section class="@sectionClasses" aria-label="Page introduction">
        <div class="container py-4 py-md-5">
            <div class="row justify-content-center text-center">
                <div class="col-12 col-md-10 col-lg-8 col-xl-7">
                    <div class="oc-inner-hero-breadcrumb__content">

                        @if (hasEyebrowText)
                        {
                            <div class="oc-inner-hero__eyebrow-wrap">
                                <span class="oc-inner-hero__eyebrow @(!string.IsNullOrEmpty(additionalTextCss) ? additionalTextCss : string.Empty)">@Html.Raw(HttpUtility.HtmlEncode(eyebrowText))</span>
                            </div>
                        }

                        @if (hasSectionTitle)
                        {
                            <h1 class="oc-centered-intro-band__title text-notransform mb-4 @(!string.IsNullOrEmpty(additionalTextCss) ? additionalTextCss : string.Empty)">@Html.Raw(sectionTitle)</h1>
                        }

                        @if (hasSectionDescription)
                        {
                            <div class="oc-centered-intro-band__description mb-0 @(!string.IsNullOrEmpty(additionalTextCss) ? additionalTextCss : string.Empty)">@Html.Raw(sectionDescription)</div>
                        }

                        @if (hasCta1)
                        {
                            <div class="oc-inner-hero__actions d-felx flex-column align-items-center justify-content-center gap-3">
                                <a href="@cta1Url" class="btn rounded-pill oc-inner-hero__btn oc-inner-hero__btn--primary track-cta">
                                    <span>@Html.Raw(cta1Text)</span>
                                    @Html.Raw(cta1IconHtml)
                                </a>
                            </div>
                        }

                    </div>
                </div>
            </div>
        </div>
    </section>
}