{
  "type": "object",
  "properties": {
    "ContainerWidth": {
      "type": "string",
      "title": "Container Width",
      "enum": ["container", "container-lg", "container-xl", "container-xxl", "container-fluid"],
      "default": "container"
    },
    "MarginTop": {
      "title": "Margin (top)",
      "type": "string",
      "enum": ["", "mt-0", "mt-1", "mt-2", "mt-3", "mt-4", "mt-5", "mt-auto"],
      "default": "mt-0"
    },
    "MarginBottom": {
      "title": "Margin (bottom)",
      "type": "string",
      "enum": ["", "mb-0", "mb-1", "mb-2", "mb-3", "mb-4", "mb-5", "mb-auto"],
      "default": "mb-0"
    },
    "PaddingTop": {
      "title": "Padding (top)",
      "type": "string",
      "enum": ["", "pt-0", "pt-1", "pt-2", "pt-3", "pt-4", "pt-5", "pt-auto"],
      "default": "pt-5"
    },
    "PaddingBottom": {
      "title": "Padding (bottom)",
      "type": "string",
      "enum": ["", "pb-0", "pb-1", "pb-2", "pb-3", "pb-4", "pb-5", "pb-auto"],
      "default": "pb-5"
    },
    "BackgroundColorClass": {
      "type": "string",
      "title": "Background Color",
      "enum": ["", "bg-light", "bg-white", "bg-body", "bg-transparent", "bg-light-subtle", "bg-off-white", "bg-warm-white", "bg-cream", "bg-soft-gray"],
      "default": "bg-white"
    },
    "AccentColor": {
      "type": "string",
      "title": "Input Accent Color",
      "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
      "default": "#ff4057"
    },
    "FormAction": {
      "type": "string",
      "title": "Form Action",
      "default": "/Portals/_default/Handlers/UpendoContactFormSubmit.ashx"
    },
    "FormMethod": {
      "type": "string",
      "title": "Form Method",
      "enum": ["post", "get"],
      "default": "post"
    },
    "NameRequired": {
      "type": "boolean",
      "title": "Name Required",
      "default": true
    },
    "EmailRequired": {
      "type": "boolean",
      "title": "Email Required",
      "default": true
    },
    "RequestRequired": {
      "type": "boolean",
      "title": "Request Required",
      "default": true
    },
    "EnableRecaptcha": {
      "type": "boolean",
      "title": "Enable reCAPTCHA",
      "default": false
    },
    "RecaptchaSiteKey": {
      "type": "string",
      "title": "reCAPTCHA Site Key",
      "dependencies": ["EnableRecaptcha"]
    },
    "RecaptchaTheme": {
      "type": "string",
      "title": "reCAPTCHA Theme",
      "enum": ["light", "dark"],
      "default": "light",
      "dependencies": ["EnableRecaptcha"]
    },
    "RecaptchaSize": {
      "type": "string",
      "title": "reCAPTCHA Size",
      "enum": ["normal", "compact"],
      "default": "normal",
      "dependencies": ["EnableRecaptcha"]
    }
  },
  "dependencies": {
    "RecaptchaSiteKey": ["EnableRecaptcha"],
    "RecaptchaTheme": ["EnableRecaptcha"],
    "RecaptchaSize": ["EnableRecaptcha"]
  }
}
