{
  "fields": {
    "BackgroundColorClass": {
      "type": "select",
      "helper": "Choose a built-in Bootstrap background color class or a custom theme background color for this section.",
      "optionLabels": [
        "None / Theme Default",
        "Primary",
        "Primary (theme)",
        "Secondary",
        "Secondary (theme)",
        "Tertiary (theme)",
        "Quaternary (theme)",
        "H5 (theme)",
        "H6 (theme)",
        "Success",
        "Danger",
        "Warning",
        "Info",
        "Light",
        "Dark",
        "White",
        "Body",
        "Transparent",
        "Primary Subtle",
        "Secondary Subtle",
        "Success Subtle",
        "Danger Subtle",
        "Warning Subtle",
        "Info Subtle",
        "Light Subtle",
        "Dark Subtle",
        "Off White",
        "Warm White",
        "Cream",
        "Soft Beige",
        "Sand",
        "Light Sage",
        "Sage",
        "Pale Green",
        "Mist",
        "Soft Gray",
        "Forest Green"
      ],
      "sort": true,
      "removeDefaultNone": true
    },
    "ContainerClass": {
      "type": "text",
      "helper": "Wrapper class for the content width. Use Bootstrap container classes or a theme-specific container class.",
      "placeholder": "container-xxl"
    },
    "CardImageVisibility": {
      "type": "select",
      "helper": "Show or hide the visual image panel. When visible and no image is selected, a soft placeholder renders.",
      "optionLabels": [
        "Show image area",
        "Hide image area"
      ],
      "removeDefaultNone": true
    },
    "VisualMinHeight": {
      "type": "text",
      "helper": "CSS height for the active visual panel on tablet and desktop. The legacy key is kept as VisualMinHeight for existing saved settings.",
      "placeholder": "26.625rem"
    },
    "AutoplayEnabled": {
      "type": "checkbox",
      "helper": "Automatically advance the active feature and progress bar. Reduced-motion users will not autoplay."
    },
    "AutoplayDuration": {
      "type": "number",
      "helper": "Duration in milliseconds for each active feature before advancing. Values below 1000 are treated as 1000.",
      "placeholder": "4200"
    },
    "AccentColor": {
      "type": "text",
      "helper": "Hex color used by active icons, progress bars, progress tracks, and focus outlines.",
      "placeholder": "#01233F",
      "showMessages": false
    },
    "MarginTop": {
      "title": "Margin (top)",
      "type": "select",
      "optionLabels": [
        "mt-0",
        "mt-1",
        "mt-2",
        "mt-3",
        "mt-4",
        "mt-5",
        "mt-auto"
      ],
      "removeDefaultNone": true
    },
    "MarginBottom": {
      "title": "Margin (bottom)",
      "type": "select",
      "optionLabels": [
        "mb-0",
        "mb-1",
        "mb-2",
        "mb-3",
        "mb-4",
        "mb-5",
        "mb-auto"
      ],
      "removeDefaultNone": true
    },
    "PaddingTop": {
      "title": "Padding (top)",
      "type": "select",
      "optionLabels": [
        "pt-0",
        "pt-1",
        "pt-2",
        "pt-3",
        "pt-4",
        "pt-5"
      ],
      "removeDefaultNone": true
    },
    "PaddingBottom": {
      "title": "Padding (bottom)",
      "type": "select",
      "optionLabels": [
        "pb-0",
        "pb-1",
        "pb-2",
        "pb-3",
        "pb-4",
        "pb-5"
      ],
      "removeDefaultNone": true
    }
  }
}
