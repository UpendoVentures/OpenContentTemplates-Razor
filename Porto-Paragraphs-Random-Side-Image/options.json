{
  "fields": {
    "ModuleTitle": {
      "type": "text",
      "helper": "Used to sync with the system's module title. This does not display to site visitors. It makes it useful to restore and share content, if/when needed.",
      "placeholder": "Try entering anything that's somewhat unique"
    },
    "Paragraph": {
      "type": "ckeditor",
      "configset": "basic"
    },
    "Images": {
      "type": "accordion",
      "helper": "At least one image is required. ",
      "items": {
        "fields": {
          "AltText": {
            "type": "text",
            "placeholder": "Used for SEO"
          },
          "ImagePath": {
            "type": "image",
            "uploadfolder": "Images",
            "typeahead": {
              "Folder": "Images"
            }
          },
          "CssClass": {
            "type": "text",
            "placeholder": "img-fluid"
          }
        }
      }
    }
  }
}