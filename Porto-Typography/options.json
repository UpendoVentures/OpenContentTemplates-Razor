{
  "fields": {
    "ModuleTitle": {
      "type": "text",
      "helper": "Used to sync with the system's module title. This does not display to site visitors. It makes it useful to restore and share content, if/when needed.",
      "placeholder": "Try entering anything that's somewhat unique"
    },
    "ModuleAnchor": {
      "type": "text",
      "helper": "Used to create #anchor-links on the page (numbers, letters, hyphens only).",
      "showMessages": false
    },
    "type": "array",
    "items": {
      "fields": {
        "Text": {
          "type": "textarea"
        },
        "Class": {
          "type": "select",
          "sort": false,
          "optionLabels": [
            "Default",
            "Drop Caps",
            "Drop Caps Style-2"
          ],
          "removeDefaultNone": true
        },
        "AlternativeFont": {
          "type": "text"
        },
        "TextWidthColor": {
          "type": "text"
        },
        "Color": {
          "type": "select",
          "sort": false,
          "optionLabels": [
            "muted",
            "primary",
            "success",
            "info",
            "warning",
            "danger"
          ]
        },
        "Size": {
          "type": "select",
          "sort": false,
          "optionLabels": [
            "h1",
            "h2",
            "h3",
            "h4",
            "h5",
            "h6"
          ]
        },
        "OtherText": {
          "type": "textarea"
        }
      }
    }
  }
}