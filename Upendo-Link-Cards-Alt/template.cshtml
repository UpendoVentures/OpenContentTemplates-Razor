@using System
@using System.Collections.Generic
@using System.Web
@using Upendo.Libraries.RunsOnUpendoCore.Helpers
@inherits Satrabel.OpenContent.Components.OpenContentWebPage

@functions {
    public bool ShouldOpenLinkInNewTab(dynamic linkTarget)
    {
        if (linkTarget == null)
        {
            return false;
        }

        var value = Convert.ToString(linkTarget);

        if (string.IsNullOrWhiteSpace(value))
        {
            return false;
        }

        return value.Equals("NewTab", StringComparison.OrdinalIgnoreCase)
            || value.Equals("New Tab", StringComparison.OrdinalIgnoreCase)
            || value.Equals("_blank", StringComparison.OrdinalIgnoreCase)
            || value.Equals("blank", StringComparison.OrdinalIgnoreCase);
    }

    public string GetLinkAttributes(dynamic linkTarget)
    {
        return ShouldOpenLinkInNewTab(linkTarget)
            ? " target=\"_blank\" rel=\"noopener noreferrer\""
            : string.Empty;
    }

    public string GetLinkUrl(dynamic link)
    {
        if (link == null)
        {
            return string.Empty;
        }

        try
        {
            if (link.Url != null)
            {
                return Convert.ToString(link.Url);
            }
        }
        catch
        {
        }

        return Convert.ToString(link);
    }

    public string GetImageUrl(dynamic image)
    {
        if (image == null)
        {
            return string.Empty;
        }

        try
        {
            if (image.Url != null)
            {
                return Convert.ToString(image.Url);
            }
        }
        catch
        {
        }

        return Convert.ToString(image);
    }

    public string GetCssImageUrl(string imageUrl)
    {
        if (string.IsNullOrWhiteSpace(imageUrl))
        {
            return string.Empty;
        }

        return "url('" + HttpUtility.HtmlAttributeEncode(imageUrl.Replace("'", "%27")) + "')";
    }
}

