{
  "fields": {
    "BackgroundColorClass": {
      "type": "select",
      "helper": "Choose a built-in Bootstrap background color class or one of the custom soft background colors included with this template.",
      "optionLabels": [
        "None / Theme Default",
        "Primary",
        "Primary (theme)",
        "Secondary",
        "Secondary (theme)",
        "Tertiary (theme)",
        "Quaternary (theme)",
        "H5 (theme)",
        "H6 (theme)",
        "Success",
        "Danger",
        "Warning",
        "Info",
        "Light",
        "Dark",
        "White",
        "Body",
        "Transparent",
        "Primary Subtle",
        "Secondary Subtle",
        "Success Subtle",
        "Danger Subtle",
        "Warning Subtle",
        "Info Subtle",
        "Light Subtle",
        "Dark Subtle",
        "Off White",
        "Warm White",
        "Cream",
        "Soft Beige",
        "Sand",
        "Light Sage",
        "Sage",
        "Pale Green",
        "Mist",
        "Soft Gray",
        "Forest Green"
      ],
      "sort": true,
      "removeDefaultNone": true
    },
    "ContainerClass": {
      "type": "select",
      "helper": "Controls the Bootstrap container width for the section.",
      "optionLabels": ["Container", "Container Large", "Container XL", "Container XXL", "Full Width"],
      "removeDefaultNone": true
    },
    "ImagePosition": {
      "type": "select",
      "helper": "Controls whether the image appears before or after the content on desktop. Mobile stacks content, image, then editorial callout.",
      "optionLabels": ["Left", "Right"],
      "removeDefaultNone": true
    },
    "ImageShape": {
      "type": "select",
      "helper": "Controls the image frame shape.",
      "optionLabels": ["Soft Rounded", "Rounded", "Arch", "Square"],
      "removeDefaultNone": true
    },
    "ContentAlignment": {
      "type": "select",
      "helper": "Controls text alignment inside the content column.",
      "optionLabels": ["Left", "Center"],
      "removeDefaultNone": true
    },
    "MaxWidth": {
      "type": "select",
      "helper": "Controls the maximum layout width inside the selected container.",
      "optionLabels": ["Standard", "Wide"],
      "removeDefaultNone": true
    },
    "MarginTop": {
      "title": "Margin (top)",
      "type": "select",
      "optionLabels": ["mt-0", "mt-1", "mt-2", "mt-3", "mt-4", "mt-5", "mt-auto"],
      "removeDefaultNone": true
    },
    "MarginBottom": {
      "title": "Margin (bottom)",
      "type": "select",
      "optionLabels": ["mb-0", "mb-1", "mb-2", "mb-3", "mb-4", "mb-5", "mb-auto"],
      "removeDefaultNone": true
    },
    "PaddingTop": {
      "title": "Padding (top)",
      "type": "select",
      "optionLabels": ["pt-0", "pt-1", "pt-2", "pt-3", "pt-4", "pt-5", "pt-auto"],
      "removeDefaultNone": true
    },
    "PaddingBottom": {
      "title": "Padding (bottom)",
      "type": "select",
      "optionLabels": ["pb-0", "pb-1", "pb-2", "pb-3", "pb-4", "pb-5", "pb-auto"],
      "removeDefaultNone": true
    }
  }
}
