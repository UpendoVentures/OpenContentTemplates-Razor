@using DotNetNuke.Entities.Modules
@using Upendo.Libraries.RunsOnUpendoCore.Helpers
@inherits Satrabel.OpenContent.Components.OpenContentWebPage
@{
    // Update or create the "hideadminborder" setting with the value "True"
    TemplateHelper.HideAdminBorder(Dnn.Module.ModuleID, Dnn.Module.TabID);

    // Get current portal alias and path
    var portalAlias = Dnn.Portal.PortalAlias.HTTPAlias;
    var currentRequest = HttpContext.Current.Request;

    // Ensure protocol and domain are correctly resolved
    var baseUrl = currentRequest.Url.Scheme + "://" + portalAlias;

    // Encode the current path for safety
    var currentPath = HttpUtility.UrlEncode(currentRequest.RawUrl);

    // Build secure login URL (forces lowercase for consistency)
    var loginUrl = (baseUrl + "/login?returnurl=" + currentPath).ToLowerInvariant();

    // Accessibility attributes
    var linkTitle = "Log in to the secure client portal (opens login page)";
}

@if (!string.IsNullOrEmpty(Model.ModuleAnchor))
{
    <div id="@Model.ModuleAnchor"></div>
}
<div class="container">
    <div class="row @Model.Settings.MarginTop @Model.Settings.MarginBottom @Model.Settings.PaddingTop @Model.Settings.PaddingBottom">
        <p class="text-center">
            <a href="@loginUrl" 
                class="footer-link portal-login-link text-decoration-none text-center" 
                title="@linkTitle"
                aria-label="@linkTitle"
                rel="nofollow noopener">
                    <span>Portal Login</span>
                </a>
        </p>
    </div>
</div>
@*
@ObjectInfo.Print(Dnn);
*@