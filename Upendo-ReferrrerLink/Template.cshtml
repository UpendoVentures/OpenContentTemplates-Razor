@using DotNetNuke.Entities.Modules
@using Upendo.Libraries.RunsOnUpendoCore.Helpers
@inherits Satrabel.OpenContent.Components.OpenContentWebPage
@{
    // Update or create the "hideadminborder" setting with the value "True"
    TemplateHelper.HideAdminBorder(Dnn.Module.ModuleID, Dnn.Module.TabID);

    RegisterStyleSheet("Template.css");

    var strUtmSource = Model.UtmSource;
    if (string.IsNullOrEmpty(strUtmSource)){
        strUtmSource = "client";
    }
    strUtmSource = HttpUtility.UrlEncode(strUtmSource);
}

@if (!string.IsNullOrEmpty(Model.ModuleAnchor))
{
    <div id="@Model.ModuleAnchor"></div>
}
<div class="container">
    <div class="row @Model.Settings.MarginTop @Model.Settings.MarginBottom @Model.Settings.PaddingTop @Model.Settings.PaddingBottom">
        <p class="text-muted small mb-0 text-center">
        <em>
            <a href="https://runsonupendo.com/?utm_source=@strUtmSource&utm_medium=website&utm_campaign=referral&utm_content=site-footer&utm_term=site-migration" 
            target="_blank" rel="noopener" class="upendo-footer-link track-referral">
            This website runs on Upendo! 
            <i class="fas fa-heart text-danger ms-1" aria-hidden="true"></i> Yours can too!
            </a>
        </em>
        </p>
    </div>
</div>