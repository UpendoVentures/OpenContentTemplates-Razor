@using System
@using System.Collections.Generic
@using System.Text.RegularExpressions
@using System.Web
@using Upendo.Libraries.RunsOnUpendoCore.Helpers
@inherits Satrabel.OpenContent.Components.OpenContentWebPage

@functions {
    private static object GetDynamicValue(dynamic source, string propertyName)
    {
        if (source == null || string.IsNullOrWhiteSpace(propertyName))
        {
            return null;
        }

        try
        {
            var dictionary = source as IDictionary<string, object>;
            if (dictionary != null && dictionary.ContainsKey(propertyName))
            {
                return dictionary[propertyName];
            }
        }
        catch { }

        try
        {
            return source[propertyName];
        }
        catch { }

        try
        {
            var property = ((object)source).GetType().GetProperty(propertyName);
            return property != null ? property.GetValue(source, null) : null;
        }
        catch
        {
            return null;
        }
    }

    private static string GetDynamicString(dynamic source, string propertyName)
    {
        var value = GetDynamicValue(source, propertyName);
        return value != null ? Convert.ToString(value) : string.Empty;
    }

    private static string GetFileUrl(dynamic file)
    {
        return GetFileUrl(file, 0);
    }

    private static string GetFileUrl(dynamic file, int depth)
    {
        if (file == null || depth > 2)
        {
            return string.Empty;
        }

        var directValue = file as string;
        if (!string.IsNullOrWhiteSpace(directValue))
        {
            return directValue;
        }

        var urlProperties = new[] { "Url", "FileUrl", "FilePath", "Path", "FullPath", "MediaUrl", "RelativeUrl", "RelativePath", "FileName", "Name", "Value" };
        foreach (var propertyName in urlProperties)
        {
            var value = GetDynamicString(file, propertyName);
            if (!string.IsNullOrWhiteSpace(value))
            {
                return value;
            }
        }

        var nestedProperties = new[] { "file", "File", "files", "Files", "item", "Item" };
        foreach (var propertyName in nestedProperties)
        {
            var nestedUrl = GetFileUrl(GetDynamicValue(file, propertyName), depth + 1);
            if (!string.IsNullOrWhiteSpace(nestedUrl))
            {
                return nestedUrl;
            }
        }

        try
        {
            var enumerable = file as System.Collections.IEnumerable;
            if (enumerable != null && !(file is string))
            {
                foreach (var item in enumerable)
                {
                    var itemUrl = GetFileUrl(item, depth + 1);
                    if (!string.IsNullOrWhiteSpace(itemUrl))
                    {
                        return itemUrl;
                    }
                }
            }
        }
        catch { }

        try
        {
            var fallbackValue = Convert.ToString(file);
            return !string.IsNullOrWhiteSpace(fallbackValue) ? fallbackValue : string.Empty;
        }
        catch
        {
            return string.Empty;
        }
    }

    private static string AllowList(string value, string fallback, ISet<string> allowed)
    {
        var normalized = !string.IsNullOrWhiteSpace(value) ? value.Trim() : fallback;
        return allowed.Contains(normalized) ? normalized : fallback;
    }

    private static string SanitizeAnchor(string value)
    {
        return !string.IsNullOrWhiteSpace(value) && Regex.IsMatch(value, "^[a-zA-Z0-9\\-]+$")
            ? value.Trim()
            : string.Empty;
    }

    private static string GetSafeUrl(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        var url = value.Trim();
        if (url.StartsWith("#") || (url.StartsWith("/") && !url.StartsWith("//")))
        {
            return url;
        }

        Uri parsed;
        if (!Uri.TryCreate(url, UriKind.Absolute, out parsed))
        {
            return string.Empty;
        }

        var scheme = parsed.Scheme.ToLowerInvariant();
        return scheme == Uri.UriSchemeHttp || scheme == Uri.UriSchemeHttps || scheme == Uri.UriSchemeMailto || scheme == "tel"
            ? url
            : string.Empty;
    }

    private static string GetSafeImageUrl(dynamic image)
    {
        return GetSafeUrl(GetFileUrl(image));
    }

    private static string BuildLinkAttributes(string target)
    {
        return string.Equals(target, "_blank", StringComparison.OrdinalIgnoreCase)
            ? " target=\"_blank\" rel=\"noopener noreferrer\""
            : string.Empty;
    }

    private static string GetSafeFocalPosition(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "center center";
        }

        var normalized = value.Trim().ToLowerInvariant();
        var allowed = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
        {
            "center center", "center top", "center bottom", "left center", "left top", "left bottom", "right center", "right top", "right bottom"
        };

        return allowed.Contains(normalized) ? normalized : "center center";
    }
}

@{
    TemplateHelper.HideAdminBorder(Model.Context.ModuleId, Model.Context.TabId);
    RegisterStyleSheet("template.css");

    var moduleTitle = Model.ModuleTitle != null ? Convert.ToString(Model.ModuleTitle) : string.Empty;
    var moduleAnchor = SanitizeAnchor(Model.ModuleAnchor != null ? Convert.ToString(Model.ModuleAnchor) : string.Empty);
    var sectionAriaLabel = Model.SectionAriaLabel != null ? Convert.ToString(Model.SectionAriaLabel) : string.Empty;
    var sectionHeading = Model.SectionHeading != null ? Convert.ToString(Model.SectionHeading) : string.Empty;
    var sectionHeadingElementSetting = Model.SectionHeadingElement != null ? Convert.ToString(Model.SectionHeadingElement) : string.Empty;
    var issueLabel = Model.IssueLabel != null ? Convert.ToString(Model.IssueLabel) : string.Empty;
    var introText = Model.IntroText != null ? Convert.ToString(Model.IntroText) : string.Empty;

    var allowedHeadingElements = new HashSet<string>(StringComparer.OrdinalIgnoreCase) { "h2", "h3", "h4" };
    var allowedContainerWidths = new HashSet<string>(StringComparer.OrdinalIgnoreCase) { "container", "container-sm", "container-md", "container-lg", "container-xl", "container-xxl", "container-fluid" };
    var allowedBackgrounds = new HashSet<string>(StringComparer.OrdinalIgnoreCase) { "", "bg-light", "bg-white", "bg-dark", "bg-transparent", "bg-body", "bg-primary", "bg-primary-subtle", "bg-secondary-subtle", "bg-light-subtle", "bg-dark-subtle", "bg-off-white", "bg-warm-white", "bg-cream", "bg-soft-beige", "bg-sand", "bg-light-sage", "bg-sage", "bg-pale-green", "bg-mist", "bg-soft-gray", "bg-forest-green" };
    var allowedSpacing = new HashSet<string>(StringComparer.OrdinalIgnoreCase) { "", "mt-0", "mt-1", "mt-2", "mt-3", "mt-4", "mt-5", "mt-auto", "mb-0", "mb-1", "mb-2", "mb-3", "mb-4", "mb-5", "mb-auto", "pt-0", "pt-1", "pt-2", "pt-3", "pt-4", "pt-5", "pt-auto", "pb-0", "pb-1", "pb-2", "pb-3", "pb-4", "pb-5", "pb-auto" };
    var allowedCardCorners = new HashSet<string>(StringComparer.OrdinalIgnoreCase) { "square", "soft" };
    var allowedSideAccentStyles = new HashSet<string>(StringComparer.OrdinalIgnoreCase) { "primary", "dark", "subtle" };

    var headingElement = AllowList(sectionHeadingElementSetting, "h2", allowedHeadingElements).ToLowerInvariant();
    var backgroundColorClass = AllowList(GetDynamicString(Model.Settings, "BackgroundColorClass"), "bg-light", allowedBackgrounds);
    var cardCorners = AllowList(GetDynamicString(Model.Settings, "CardCorners"), "square", allowedCardCorners).ToLowerInvariant();
    var containerWidth = AllowList(GetDynamicString(Model.Settings, "ContainerWidth"), "container-xxl", allowedContainerWidths);
    var marginBottom = AllowList(GetDynamicString(Model.Settings, "MarginBottom"), "", allowedSpacing);
    var marginTop = AllowList(GetDynamicString(Model.Settings, "MarginTop"), "", allowedSpacing);
    var paddingBottom = AllowList(GetDynamicString(Model.Settings, "PaddingBottom"), "pb-5", allowedSpacing);
    var paddingTop = AllowList(GetDynamicString(Model.Settings, "PaddingTop"), "pt-5", allowedSpacing);
    var sideAccentStyle = AllowList(GetDynamicString(Model.Settings, "SideAccentStyle"), "primary", allowedSideAccentStyles).ToLowerInvariant();

    var sideArticles = new List<dynamic>();
    if (Model.SideArticles != null)
    {
        foreach (var article in Model.SideArticles)
        {
            sideArticles.Add(article);
        }
    }

    var featuredArticle = Model.FeaturedArticle;
    var featuredCategory = GetDynamicString(featuredArticle, "Category");
    var featuredTitle = GetDynamicString(featuredArticle, "Title");
    var featuredDescription = GetDynamicString(featuredArticle, "Description");
    var featuredImageUrl = GetSafeImageUrl(GetDynamicValue(featuredArticle, "Image"));
    var featuredImageAlt = GetDynamicString(featuredArticle, "ImageAlt");
    var featuredImageFocalPosition = GetSafeFocalPosition(GetDynamicString(featuredArticle, "ImageFocalPosition"));
    var featuredCtaText = GetDynamicString(featuredArticle, "CtaText");
    var featuredUrl = GetSafeUrl(GetDynamicString(featuredArticle, "Url"));
    var featuredLinkTarget = GetDynamicString(featuredArticle, "LinkTarget");
    var featuredCtaAriaLabel = GetDynamicString(featuredArticle, "CtaAriaLabel");
    var featuredOpensNewWindow = string.Equals(featuredLinkTarget, "_blank", StringComparison.OrdinalIgnoreCase);
    var featuredLinkLabel = !string.IsNullOrWhiteSpace(featuredCtaAriaLabel) ? featuredCtaAriaLabel : (!string.IsNullOrWhiteSpace(featuredTitle) ? featuredTitle : featuredCtaText);
    var hasFeaturedContent = !string.IsNullOrWhiteSpace(featuredCategory) || !string.IsNullOrWhiteSpace(featuredTitle) || !string.IsNullOrWhiteSpace(featuredDescription) || !string.IsNullOrWhiteSpace(featuredImageUrl) || !string.IsNullOrWhiteSpace(featuredCtaText);

    var hasHeading = !string.IsNullOrWhiteSpace(sectionHeading);
    var hasIntro = !string.IsNullOrWhiteSpace(introText);
    var hasIssue = !string.IsNullOrWhiteSpace(issueLabel);
    var headingId = "oc-tia-heading-" + Model.Context.ModuleId;
    var sectionClasses = "oc-technical-insights oc-tia-corners-" + cardCorners + " oc-tia-side-accent-" + sideAccentStyle;
    if (!string.IsNullOrWhiteSpace(backgroundColorClass)) { sectionClasses += " " + backgroundColorClass; }
    if (!string.IsNullOrWhiteSpace(marginTop)) { sectionClasses += " " + marginTop; }
    if (!string.IsNullOrWhiteSpace(marginBottom)) { sectionClasses += " " + marginBottom; }
    if (!string.IsNullOrWhiteSpace(paddingTop)) { sectionClasses += " " + paddingTop; }
    if (!string.IsNullOrWhiteSpace(paddingBottom)) { sectionClasses += " " + paddingBottom; }

    var fallbackAriaLabel = !string.IsNullOrWhiteSpace(sectionAriaLabel) ? sectionAriaLabel : (!string.IsNullOrWhiteSpace(moduleTitle) ? moduleTitle : "Technical insights articles");
    var moduleAnchorAttribute = !string.IsNullOrWhiteSpace(moduleAnchor) ? " id=\"" + HttpUtility.HtmlAttributeEncode(moduleAnchor) + "\"" : string.Empty;
    var sectionAriaAttribute = hasHeading ? " aria-labelledby=\"" + HttpUtility.HtmlAttributeEncode(headingId) + "\"" : " aria-label=\"" + HttpUtility.HtmlAttributeEncode(fallbackAriaLabel) + "\"";
    var featuredLinkAttributes = BuildLinkAttributes(featuredLinkTarget);
}

@if (hasHeading || hasIntro || hasIssue || hasFeaturedContent || sideArticles.Count > 0)
{
    <section class="@sectionClasses"@Html.Raw(moduleAnchorAttribute)@Html.Raw(sectionAriaAttribute)>
        <div class="@containerWidth">
            @if (hasHeading || hasIntro || hasIssue)
            {
                <div class="oc-tia-header">
                    <div class="oc-tia-header-main">
                        @if (hasHeading)
                        {
                            if (headingElement == "h3")
                            {
                                <h3 id="@headingId" class="oc-tia-heading text-notransform">@sectionHeading</h3>
                            }
                            else if (headingElement == "h4")
                            {
                                <h4 id="@headingId" class="oc-tia-heading text-notransform">@sectionHeading</h4>
                            }
                            else
                            {
                                <h2 id="@headingId" class="oc-tia-heading text-notransform">@sectionHeading</h2>
                            }
                        }
                        @if (hasIntro)
                        {
                            <p class="oc-tia-intro">@introText</p>
                        }
                    </div>
                    <span class="oc-tia-header-rule" aria-hidden="true"></span>
                    @if (hasIssue)
                    {
                        <span class="oc-tia-issue-label">@issueLabel</span>
                    }
                </div>
            }

            <div class="oc-tia-layout">
                @if (hasFeaturedContent)
                {
                    <article class="oc-tia-featured-card">
                        @if (!string.IsNullOrWhiteSpace(featuredUrl))
                        {
                            <a class="oc-tia-featured-link" href="@featuredUrl" aria-label="@featuredLinkLabel"@Html.Raw(featuredLinkAttributes)>
                                @RenderFeaturedInner(featuredImageUrl, featuredImageAlt, featuredImageFocalPosition, featuredCategory, featuredTitle, featuredDescription, featuredCtaText)
                            </a>
                        }
                        else
                        {
                            <div class="oc-tia-featured-link oc-tia-featured-link-static">
                                @RenderFeaturedInner(featuredImageUrl, featuredImageAlt, featuredImageFocalPosition, featuredCategory, featuredTitle, featuredDescription, featuredCtaText)
                            </div>
                        }
                    </article>
                }

                @if (sideArticles.Count > 0)
                {
                    <div class="oc-tia-side-list">
                        @foreach (var article in sideArticles)
                        {
                            var category = GetDynamicString(article, "Category");
                            var title = GetDynamicString(article, "Title");
                            var description = GetDynamicString(article, "Description");
                            var url = GetSafeUrl(GetDynamicString(article, "Url"));
                            var linkTarget = GetDynamicString(article, "LinkTarget");
                            var ctaAriaLabel = GetDynamicString(article, "CtaAriaLabel");
                            var opensNewWindow = string.Equals(linkTarget, "_blank", StringComparison.OrdinalIgnoreCase);
                            var linkLabel = !string.IsNullOrWhiteSpace(ctaAriaLabel) ? ctaAriaLabel : (!string.IsNullOrWhiteSpace(title) ? title : category);
                            var sideLinkAttributes = BuildLinkAttributes(linkTarget);

                            <article class="oc-tia-side-card">
                                @if (!string.IsNullOrWhiteSpace(url))
                                {
                                    <a class="oc-tia-side-link" href="@url" aria-label="@linkLabel"@Html.Raw(sideLinkAttributes)>
                                        @RenderSideInner(category, title, description)
                                    </a>
                                }
                                else
                                {
                                    <div class="oc-tia-side-link oc-tia-side-link-static">
                                        @RenderSideInner(category, title, description)
                                    </div>
                                }
                            </article>
                        }
                    </div>
                }
            </div>
        </div>
    </section>
}

@helper RenderFeaturedInner(string imageUrl, string imageAlt, string imageFocalPosition, string category, string title, string description, string ctaText)
{
    var mediaHidden = string.IsNullOrWhiteSpace(imageUrl).ToString().ToLowerInvariant();

    <span class="oc-tia-featured-media" aria-hidden="@mediaHidden">
        @if (!string.IsNullOrWhiteSpace(imageUrl))
        {
            <img class="oc-tia-featured-image" src="@imageUrl" alt="@imageAlt" style="object-position: @imageFocalPosition;" loading="lazy" />
        }
    </span>
    <span class="oc-tia-featured-overlay" aria-hidden="true"></span>
    <span class="oc-tia-featured-content">
        @if (!string.IsNullOrWhiteSpace(category))
        {
            <span class="oc-tia-category-pill">@category</span>
        }
        @if (!string.IsNullOrWhiteSpace(title))
        {
            <span class="oc-tia-featured-title">@title</span>
        }
        @if (!string.IsNullOrWhiteSpace(description))
        {
            <span class="oc-tia-featured-description">@description</span>
        }
        @if (!string.IsNullOrWhiteSpace(ctaText))
        {
            <span class="oc-tia-featured-cta">@ctaText <span class="oc-tia-featured-cta-arrow" aria-hidden="true"></span></span>
        }
    </span>
}

@helper RenderSideInner(string category, string title, string description)
{
    if (!string.IsNullOrWhiteSpace(category))
    {
        <span class="oc-tia-side-category">@category</span>
    }
    if (!string.IsNullOrWhiteSpace(title))
    {
        <span class="oc-tia-side-title">@title</span>
    }
    if (!string.IsNullOrWhiteSpace(description))
    {
        <span class="oc-tia-side-description">@description</span>
    }
}
