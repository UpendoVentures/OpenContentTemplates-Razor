@using System
@using System.Collections.Generic
@using System.Text.RegularExpressions
@using System.Web
@using Upendo.Libraries.RunsOnUpendoCore.Helpers
@inherits Satrabel.OpenContent.Components.OpenContentWebPage

@functions {
    public class SocialLinkItem
    {
        public string Network { get; set; }
        public string Icon { get; set; }
        public string Label { get; set; }
        public string Url { get; set; }
    }

    public class InfoItem
    {
        public string Icon { get; set; }
        public string Label { get; set; }
        public string Value { get; set; }
    }

    private static string GetString(dynamic value, string fallback = "")
    {
        if (value == null)
        {
            return fallback;
        }

        var text = Convert.ToString(value);
        return string.IsNullOrWhiteSpace(text) ? fallback : text;
    }

    private static object GetDynamicValue(dynamic source, string propertyName)
    {
        if (source == null || string.IsNullOrWhiteSpace(propertyName))
        {
            return null;
        }

        try
        {
            var dictionary = source as IDictionary<string, object>;
            if (dictionary != null && dictionary.ContainsKey(propertyName))
            {
                return dictionary[propertyName];
            }
        }
        catch
        {
        }

        try
        {
            return source[propertyName];
        }
        catch
        {
        }

        try
        {
            var property = ((object)source).GetType().GetProperty(propertyName);
            return property != null ? property.GetValue(source, null) : null;
        }
        catch
        {
            return null;
        }
    }

    private static string GetAllowedString(dynamic value, string fallback, params string[] allowedValues)
    {
        var text = GetString(value, fallback);

        foreach (var allowedValue in allowedValues)
        {
            if (text.Equals(allowedValue, StringComparison.OrdinalIgnoreCase))
            {
                return allowedValue;
            }
        }

        return fallback;
    }

    private static string GetSafeCssClassTokens(dynamic value)
    {
        var text = GetString(value).Trim();

        if (string.IsNullOrWhiteSpace(text) || string.Equals(text, "none", StringComparison.OrdinalIgnoreCase))
        {
            return string.Empty;
        }

        var sanitizedChars = new List<char>();
        var lastWasSpace = false;

        foreach (var character in text)
        {
            var isAllowedTokenCharacter = char.IsLetterOrDigit(character) || character == '-' || character == '_';
            var isSpace = char.IsWhiteSpace(character);

            if (isAllowedTokenCharacter)
            {
                sanitizedChars.Add(character);
                lastWasSpace = false;
            }
            else if (isSpace && !lastWasSpace)
            {
                sanitizedChars.Add(' ');
                lastWasSpace = true;
            }
        }

        return new string(sanitizedChars.ToArray()).Trim();
    }

    private static string GetSafeAnchor(dynamic value)
    {
        var text = GetString(value).Trim();
        return Regex.IsMatch(text, "^[a-zA-Z0-9\\-]+$") ? text : string.Empty;
    }

    private static string GetSafeNetworkToken(dynamic value)
    {
        return GetAllowedString(value, "custom", "instagram", "tiktok", "youtube", "linkedin", "facebook", "twitter", "custom").ToLowerInvariant();
    }

    private static string GetSafeUrl(dynamic value)
    {
        var text = GetString(value).Trim();

        if (string.IsNullOrWhiteSpace(text))
        {
            return string.Empty;
        }

        if (text.StartsWith("//"))
        {
            return string.Empty;
        }

        if (text.StartsWith("#") || text.StartsWith("/") || text.StartsWith("./") || text.StartsWith("../"))
        {
            return text;
        }

        Uri absoluteUri;
        if (Uri.TryCreate(text, UriKind.Absolute, out absoluteUri))
        {
            var scheme = absoluteUri.Scheme.ToLowerInvariant();
            return scheme == "http" || scheme == "https" || scheme == "mailto" || scheme == "tel" ? text : string.Empty;
        }

        return text.Contains(":") ? string.Empty : text;
    }

    private static IHtmlString RenderTextWithLineBreaks(string text)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            return new HtmlString(string.Empty);
        }

        var encoded = HttpUtility.HtmlEncode(text).Replace("\r\n", "\n").Replace("\r", "\n").Replace("\n", "<br />");
        return new HtmlString(encoded);
    }

    private static bool HasSocialContent(SocialLinkItem item)
    {
        return item != null && (!string.IsNullOrWhiteSpace(item.Icon) || !string.IsNullOrWhiteSpace(item.Label));
    }

    private static bool HasInfoContent(InfoItem item)
    {
        return item != null && (
            !string.IsNullOrWhiteSpace(item.Icon) ||
            !string.IsNullOrWhiteSpace(item.Label) ||
            !string.IsNullOrWhiteSpace(item.Value));
    }
}

@{
    TemplateHelper.HideAdminBorder(Model.Context.ModuleId, Model.Context.TabId);
    RegisterStyleSheet("template.css");

    var moduleTitle = GetString(Model.ModuleTitle);
    var moduleAnchor = GetSafeAnchor(Model.ModuleAnchor);
    var sectionAriaLabel = GetString(Model.SectionAriaLabel, moduleTitle);

    var socialHeadingLead = GetString(Model.SocialHeadingLead);
    var socialHeadingText = GetString(Model.SocialHeadingText);
    var contactHeadingLead = GetString(Model.ContactHeadingLead);
    var contactHeadingEmphasis = GetString(Model.ContactHeadingEmphasis);
    var contactIntro = GetString(Model.ContactIntro);
    var hoursHeadingLead = GetString(Model.HoursHeadingLead);
    var hoursHeadingEmphasis = GetString(Model.HoursHeadingEmphasis);

    var socialLinks = new List<SocialLinkItem>();
    if (Model.SocialLinks != null)
    {
        foreach (var socialLink in Model.SocialLinks)
        {
            var item = new SocialLinkItem
            {
                Network = GetSafeNetworkToken(GetDynamicValue(socialLink, "Network")),
                Icon = GetSafeCssClassTokens(GetDynamicValue(socialLink, "Icon")),
                Label = GetString(GetDynamicValue(socialLink, "Label")),
                Url = GetSafeUrl(GetDynamicValue(socialLink, "Url"))
            };

            if (HasSocialContent(item))
            {
                socialLinks.Add(item);
            }
        }
    }

    var contactItems = new List<InfoItem>();
    if (Model.ContactItems != null)
    {
        foreach (var contactItem in Model.ContactItems)
        {
            var item = new InfoItem
            {
                Icon = GetSafeCssClassTokens(GetDynamicValue(contactItem, "Icon")),
                Label = GetString(GetDynamicValue(contactItem, "Label")),
                Value = GetString(GetDynamicValue(contactItem, "Value"))
            };

            if (HasInfoContent(item))
            {
                contactItems.Add(item);
            }
        }
    }

    var hourItems = new List<InfoItem>();
    if (Model.HourItems != null)
    {
        foreach (var hourItem in Model.HourItems)
        {
            var item = new InfoItem
            {
                Icon = GetSafeCssClassTokens(GetDynamicValue(hourItem, "Icon")),
                Label = GetString(GetDynamicValue(hourItem, "Label")),
                Value = GetString(GetDynamicValue(hourItem, "Value"))
            };

            if (HasInfoContent(item))
            {
                hourItems.Add(item);
            }
        }
    }

    var backgroundColorClass = Model.Settings != null ? GetAllowedString(Model.Settings.BackgroundColorClass, "bg-white", "", "bg-light", "bg-white", "bg-body", "bg-transparent", "bg-light-subtle", "bg-off-white", "bg-warm-white", "bg-cream", "bg-soft-gray") : "bg-white";
    var containerWidth = Model.Settings != null ? GetAllowedString(Model.Settings.ContainerWidth, "container", "container", "container-lg", "container-xl", "container-xxl", "container-fluid") : "container";
    var marginTop = Model.Settings != null ? GetAllowedString(Model.Settings.MarginTop, "mt-0", "", "mt-0", "mt-1", "mt-2", "mt-3", "mt-4", "mt-5", "mt-auto") : "mt-0";
    var marginBottom = Model.Settings != null ? GetAllowedString(Model.Settings.MarginBottom, "mb-0", "", "mb-0", "mb-1", "mb-2", "mb-3", "mb-4", "mb-5", "mb-auto") : "mb-0";
    var paddingTop = Model.Settings != null ? GetAllowedString(Model.Settings.PaddingTop, "pt-5", "", "pt-0", "pt-1", "pt-2", "pt-3", "pt-4", "pt-5", "pt-auto") : "pt-5";
    var paddingBottom = Model.Settings != null ? GetAllowedString(Model.Settings.PaddingBottom, "pb-5", "", "pb-0", "pb-1", "pb-2", "pb-3", "pb-4", "pb-5", "pb-auto") : "pb-5";

    var hasSocialHeading = !string.IsNullOrWhiteSpace(socialHeadingLead) || !string.IsNullOrWhiteSpace(socialHeadingText);
    var hasContactHeading = !string.IsNullOrWhiteSpace(contactHeadingLead) || !string.IsNullOrWhiteSpace(contactHeadingEmphasis);
    var hasContactIntro = !string.IsNullOrWhiteSpace(contactIntro);
    var hasHoursHeading = !string.IsNullOrWhiteSpace(hoursHeadingLead) || !string.IsNullOrWhiteSpace(hoursHeadingEmphasis);
    var hasContactBlock = hasContactHeading || hasContactIntro || contactItems.Count > 0;
    var hasHoursBlock = hasHoursHeading || hourItems.Count > 0;
    var hasRenderableContent = hasSocialHeading || socialLinks.Count > 0 || hasContactBlock || hasHoursBlock;

    var contactHeadingId = "oc-dc-contact-heading-" + Model.Context.ModuleId;
    var ariaAttribute = hasContactHeading
        ? "aria-labelledby=\"" + HttpUtility.HtmlAttributeEncode(contactHeadingId) + "\""
        : (!string.IsNullOrWhiteSpace(sectionAriaLabel) ? "aria-label=\"" + HttpUtility.HtmlAttributeEncode(sectionAriaLabel) + "\"" : string.Empty);
    var sectionClass = "oc-direct-channels " + backgroundColorClass;

    if (!string.IsNullOrWhiteSpace(marginTop))
    {
        sectionClass += " " + marginTop;
    }

    if (!string.IsNullOrWhiteSpace(marginBottom))
    {
        sectionClass += " " + marginBottom;
    }

    if (!string.IsNullOrWhiteSpace(paddingTop))
    {
        sectionClass += " " + paddingTop;
    }

    if (!string.IsNullOrWhiteSpace(paddingBottom))
    {
        sectionClass += " " + paddingBottom;
    }
}

@helper RenderSplitHeading(string tagName, string id, string cssClass, string lead, string emphasis)
{
    var hasLead = !string.IsNullOrWhiteSpace(lead);
    var hasEmphasis = !string.IsNullOrWhiteSpace(emphasis);

    if (hasLead || hasEmphasis)
    {
        @Html.Raw("<" + tagName + " id=\"" + HttpUtility.HtmlAttributeEncode(id) + "\" class=\"" + HttpUtility.HtmlAttributeEncode(cssClass) + "\">")
        if (hasLead)
        {
            <span>@lead</span>
        }
        if (hasEmphasis)
        {
            <strong>@emphasis</strong>
        }
        @Html.Raw("</" + tagName + ">")
    }
}

@helper RenderSocialLink(SocialLinkItem item)
{
    var hasIcon = !string.IsNullOrWhiteSpace(item.Icon);
    var hasLabel = !string.IsNullOrWhiteSpace(item.Label);
    var className = "oc-dc-social-link oc-dc-social-network-" + item.Network;

    if (hasIcon || hasLabel)
    {
        if (!string.IsNullOrWhiteSpace(item.Url))
        {
            <a class="@className" href="@item.Url">
                @if (hasIcon)
                {
                    <span class="oc-dc-social-icon @item.Icon" aria-hidden="true"></span>
                }
                @if (hasLabel)
                {
                    <span class="oc-dc-social-label">@item.Label</span>
                }
            </a>
        }
        else
        {
            <span class="@className">
                @if (hasIcon)
                {
                    <span class="oc-dc-social-icon @item.Icon" aria-hidden="true"></span>
                }
                @if (hasLabel)
                {
                    <span class="oc-dc-social-label">@item.Label</span>
                }
            </span>
        }
    }
}

@helper RenderInfoRow(InfoItem item, string rowClass)
{
    var hasIcon = !string.IsNullOrWhiteSpace(item.Icon);
    var hasLabel = !string.IsNullOrWhiteSpace(item.Label);
    var hasValue = !string.IsNullOrWhiteSpace(item.Value);

    if (hasIcon || hasLabel || hasValue)
    {
        <div class="oc-dc-info-row @rowClass">
            @if (hasIcon)
            {
                <span class="oc-dc-info-icon @item.Icon" aria-hidden="true"></span>
            }
            <div class="oc-dc-info-body">
                @if (hasLabel)
                {
                    <p class="oc-dc-info-label">@item.Label</p>
                }
                @if (hasValue)
                {
                    <div class="oc-dc-info-value">@RenderTextWithLineBreaks(item.Value)</div>
                }
            </div>
        </div>
    }
}

@if (!string.IsNullOrWhiteSpace(moduleAnchor))
{
    <div id="@moduleAnchor"></div>
}

@if (hasRenderableContent)
{
    <section class="@sectionClass" @Html.Raw(ariaAttribute)>
        <div class="@containerWidth">
            <div class="oc-dc-content">
                @if (hasSocialHeading || socialLinks.Count > 0)
                {
                    <div class="oc-dc-social-area">
                        @if (hasSocialHeading)
                        {
                            <p class="oc-dc-social-heading">
                                @if (!string.IsNullOrWhiteSpace(socialHeadingLead))
                                {
                                    <strong>@socialHeadingLead</strong>
                                }
                                @if (!string.IsNullOrWhiteSpace(socialHeadingText))
                                {
                                    <span>@socialHeadingText</span>
                                }
                            </p>
                        }

                        @if (socialLinks.Count > 0)
                        {
                            <div class="oc-dc-social-list" role="list" aria-label="Social links">
                                @foreach (var socialLink in socialLinks)
                                {
                                    <div role="listitem">@RenderSocialLink(socialLink)</div>
                                }
                            </div>
                        }
                    </div>
                }

                @if (hasContactBlock)
                {
                    <div class="oc-dc-block oc-dc-contact-block">
                        @if (hasContactHeading)
                        {
                            @RenderSplitHeading("h2", contactHeadingId, "oc-dc-heading text-notransform", contactHeadingLead, contactHeadingEmphasis)
                        }
                        @if (hasContactIntro)
                        {
                            <p class="oc-dc-intro">@RenderTextWithLineBreaks(contactIntro)</p>
                        }
                        @if (contactItems.Count > 0)
                        {
                            <div class="oc-dc-info-list" role="list">
                                @foreach (var contactItem in contactItems)
                                {
                                    <div role="listitem">@RenderInfoRow(contactItem, "oc-dc-contact-row")</div>
                                }
                            </div>
                        }
                    </div>
                }

                @if (hasContactBlock && hasHoursBlock)
                {
                    <hr class="oc-dc-divider" />
                }

                @if (hasHoursBlock)
                {
                    <div class="oc-dc-block oc-dc-hours-block">
                        @if (hasHoursHeading)
                        {
                            @RenderSplitHeading("h3", "oc-dc-hours-heading-" + Model.Context.ModuleId, "oc-dc-subheading text-notransform", hoursHeadingLead, hoursHeadingEmphasis)
                        }
                        @if (hourItems.Count > 0)
                        {
                            <div class="oc-dc-info-list" role="list">
                                @foreach (var hourItem in hourItems)
                                {
                                    <div role="listitem">@RenderInfoRow(hourItem, "oc-dc-hour-row")</div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </section>
}
