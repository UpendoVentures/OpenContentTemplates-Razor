{
  "fields": {
    "ModuleTitle": {
      "type": "text",
      "helper": "Used to sync with the system's module title. This does not display to site visitors. It makes it useful to restore and share content, if/when needed.",
      "placeholder": "Try entering anything that's somewhat unique"
    },
    "ModuleAnchor": {
      "type": "text",
      "helper": "Used to create #anchor-links on the page (numbers, letters, hyphens only).",
      "showMessages": false
    },
    "Sections": {
      "type": "array",
      "items": {
        "fields": {
          "Text": {
            "type": "textarea"
          },
          "WordRotate": {
            "type": "array",
            "items": {
              "fields": {
                "Value": {
                  "type": "text"
                }
              }
            }
          },
          "Color": {
            "type": "select",
            "sort": false,
            "optionLabels": [
              "transparent",
              "primary",
              "secondary",
              "tertiary",
              "quaternary"
            ],
            "removeDefaultNone": true
          },
          "Size": {
            "type": "select",
            "sort": false,
            "optionLabels": [
              "h1",
              "h2",
              "h3",
              "h4",
              "h5",
              "h6"
            ],
            "removeDefaultNone": true
          },
          "OtherText": {
            "type": "textarea"
          }
        }
      }
    }
  }
}