@using DotNetNuke.Entities.Modules
@using Upendo.Libraries.RunsOnUpendoCore.Helpers
@inherits Satrabel.OpenContent.Components.OpenContentWebPage
@{
    // Update or create the "hideadminborder" setting with the value "True"
    TemplateHelper.HideAdminBorder(Model.Context.ModuleId, Model.Context.TabId);
}

@if (!string.IsNullOrEmpty(Model.ModuleAnchor))
{
    <div id="@Model.ModuleAnchor"></div>
}

@if (Model.Context.IsEditMode){
<style>
    .upendo-admin-template-panel { margin: 1rem 0; border: 1px dashed #6b7280; border-left: 4px dashed #111827; border-radius: .5rem; background: #f3f4f6; box-shadow: 0 .125rem .35rem rgba(17, 24, 39, .12); color: #111827; }
    .upendo-admin-template-panel__header { padding: 1rem 1.25rem; background: #e5e7eb; }
    .upendo-admin-template-panel__eyebrow { display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: .75rem; }
    .upendo-admin-template-panel__badge { display: inline-flex; align-items: center; gap: .35rem; padding: .25rem .55rem; border-radius: 999px; font-size: .7rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; }
    .upendo-admin-template-panel__badge--admin { background: #111827; color: #fff; }
    .upendo-admin-template-panel__badge--status { background: #d1d5db; color: #1f2937; }
    .upendo-admin-template-panel__title { display: flex; align-items: center; gap: .6rem; margin: 0; color: #111827; font-size: 1.35rem; }
    .upendo-admin-template-panel__title-icon { color: #374151; }
    .upendo-admin-template-panel__description { margin: .4rem 0 0; color: #374151; }
    .upendo-admin-template-panel__details { display: flex; flex-wrap: wrap; gap: .75rem 1.5rem; margin: .9rem 0 0; }
    .upendo-admin-template-panel__detail { display: flex; gap: .35rem; margin: 0; font-size: .85rem; }
    .upendo-admin-template-panel__detail dt { color: #4b5563; font-weight: 600; }
    .upendo-admin-template-panel__detail dd { margin: 0; font-weight: 700; }
    .upendo-admin-template-panel__body { padding: 1rem 1.25rem; }
    @@media (max-width: 575.98px) { .upendo-admin-template-panel__title { font-size: 1.15rem; } .upendo-admin-template-panel__body, .upendo-admin-template-panel__header { padding: .9rem; } }
</style>

<section class="upendo-admin-template-panel" aria-labelledby="upendo-metadata-admin-title-@Model.Context.ModuleId">
    <div class="upendo-admin-template-panel__header">
        <div class="upendo-admin-template-panel__eyebrow" aria-label="Administrative module status">
            <span class="upendo-admin-template-panel__badge upendo-admin-template-panel__badge--admin" tabindex="0" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Administrative module: configuration is intended for authorized editors."><i class="fa-solid fa-user-shield" aria-hidden="true"></i> Admin module</span>
            <span class="upendo-admin-template-panel__badge upendo-admin-template-panel__badge--status" tabindex="0" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="This panel is shown only while edit mode is active."><i class="fa-solid fa-pen-to-square" aria-hidden="true"></i> Edit mode only</span>
            <span class="upendo-admin-template-panel__badge upendo-admin-template-panel__badge--status" tabindex="0" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="This management panel is hidden from public visitors."><i class="fa-solid fa-eye-slash" aria-hidden="true"></i> Hidden from visitors</span>
        </div>
        <h2 id="upendo-metadata-admin-title-@Model.Context.ModuleId" class="upendo-admin-template-panel__title"><i class="fa-solid fa-tags upendo-admin-template-panel__title-icon" aria-hidden="true"></i> Meta Data Editor</h2>
        <p class="upendo-admin-template-panel__description">Manage metadata and link tags used by the site theme.</p>
        <dl class="upendo-admin-template-panel__details">
            <div class="upendo-admin-template-panel__detail"><dt>Module</dt><dd>@Model.Context.ModuleTitle</dd></div>
            <div class="upendo-admin-template-panel__detail"><dt>Tab ID</dt><dd>@Model.Context.TabId</dd></div>
            <div class="upendo-admin-template-panel__detail"><dt>Module ID</dt><dd>@Model.Context.ModuleId</dd></div>
        </dl>
    </div>
    <div class="upendo-admin-template-panel__body">
        <div class="container-fluid px-0">
            <div class="row @Model.Settings.MarginTop @Model.Settings.MarginBottom @Model.Settings.PaddingTop @Model.Settings.PaddingBottom">
                <div class="col mb-3">
            <button class="btn btn-link p-0 text-decoration-none" 
                    type="button" 
                    data-bs-toggle="collapse" 
                    data-bs-target="#collapseInfo-@Model.Context.ModuleId" 
                    aria-expanded="false" 
                    aria-controls="collapseInfo-@Model.Context.ModuleId">
                <span class="fw-bold">View configured metadata details</span>
                <i class="fas fa-chevron-down ms-2 small"></i>
            </button>

            <div class="collapse mt-2" id="collapseInfo-@Model.Context.ModuleId">
                <div class="card card-body border-0 p-2 bg-light">

                    <div class="alert alert-info" role="alert">
                        <h2 class="alert-heading"><i class="fas fa-tags me-2" aria-hidden="true"></i>Metadata configuration details</h2>
                        <p>
                            The tags defined below will be dynamically injected into the <code>@System.Net.WebUtility.HtmlEncode("<head>")</code> section of your web page.
                            This allows you to easily manage custom <code>@System.Net.WebUtility.HtmlEncode("<meta />")</code> and <code>@System.Net.WebUtility.HtmlEncode("<link />")</code> tags without editing the theme or site settings directly.
                        </p>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <h4>Meta Tags</h4>
                            <p class="text-muted">
                                <small>
                                    <strong>Note:</strong> The <code>@System.Net.WebUtility.HtmlEncode("<meta />")</code> tags are typically used for SEO, social media sharing, and other metadata.
                                    Ensure that the <code>@System.Net.WebUtility.HtmlEncode("name")</code> attribute is set correctly for the intended use.
                                </small>
                            </p>
                            @if (Model.MetaTags != null) {
                                <ul class="list-unstyled mb-3">
                                    @foreach (var tag in Model.MetaTags) {
                                        var meta = new System.Text.StringBuilder();
                                        meta.Append("<meta");
                                        if (!string.IsNullOrEmpty(tag.Name) && tag.Name.ToLower() != "n/a") { meta.AppendFormat(" name=\"{0}\"", tag.Name); }
                                        if (!string.IsNullOrEmpty(tag.Property)) { meta.AppendFormat(" property=\"{0}\"", tag.Property); }
                                        if (!string.IsNullOrEmpty(tag.Content)) { meta.AppendFormat(" content=\"{0}\"", tag.Content); }
                                        meta.Append(" />");

                                        <li><code>@System.Net.WebUtility.HtmlEncode(meta.ToString())</code></li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <div class="alert alert-warning" role="alert">
                                    <p class="mb-0">No meta tags found.</p>
                                </div>
                            }
                        </div>
                        <div class="col-md-6">
                            <h4>Link Tags</h4>
                            <p class="text-muted">
                                <small>
                                    <strong>Note:</strong> The <code>@System.Net.WebUtility.HtmlEncode("<link />")</code> tags are typically used for stylesheets, icons, and other resources.
                                    Ensure that the <code>@System.Net.WebUtility.HtmlEncode("rel")</code> attribute is set correctly for the intended use.
                                </small>
                            </p>
                            @if (Model.LinkTags != null) {
                                <ul class="list-unstyled mb-3">
                                    @foreach (var tag in Model.LinkTags) {
                                        var link = new System.Text.StringBuilder();
                                        link.Append("<link");
                                        if (!string.IsNullOrEmpty(tag.Rel)) { link.AppendFormat(" rel=\"{0}\"", tag.Rel); }
                                        if (!string.IsNullOrEmpty(tag.Href)) { link.AppendFormat(" href=\"{0}\"", tag.Href); }
                                        if (!string.IsNullOrEmpty(tag.Type)) { link.AppendFormat(" type=\"{0}\"", tag.Type); }
                                        if (!string.IsNullOrEmpty(tag.Hreflang)) { link.AppendFormat(" hreflang=\"{0}\"", tag.Hreflang); }
                                        if (!string.IsNullOrEmpty(tag.Sizes)) { link.AppendFormat(" sizes=\"{0}\"", tag.Sizes); }
                                        link.Append(" />");

                                        <li><code>@System.Net.WebUtility.HtmlEncode(link.ToString())</code></li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <div class="alert alert-warning" role="alert">
                                    <p class="mb-0">No link tags found.</p>
                                </div>
                            }
                        </div>
                    </div>

                    <hr />
                    <p class="text-center">
                        <a href="@Model.Context.EditUrl" noopener class="btn btn-lg btn-secondary">Edit Meta Data</a>
                    </p>
                    <blockquote>
                        <p class="text-muted fs-6">
                            <strong>Please Note:</strong> This template will only save the values. You will also need to 
                            <a href="https://github.com/UpendoVentures/OpenContentHelper#readme" target="_blank">install 
                            the Upendo OpenContentHelper theme object</a> and then <a href="https://github.com/UpendoVentures/OpenContentHelper/wiki#-getting-started" target="_blank">add it to your theme</a>.  
                        </p>
                    </blockquote>

                </div>
            </div>
                </div>
            </div>
        </div>
    </div>
</section>
<script>
    (function () {
        function initializeAdminPanelTooltip() {
            if (!window.bootstrap || !window.bootstrap.Tooltip) return;
            var tooltips = document.querySelectorAll('.upendo-admin-template-panel__badge[data-bs-toggle="tooltip"]');
            for (var i = 0; i < tooltips.length; i++) window.bootstrap.Tooltip.getOrCreateInstance(tooltips[i], { placement: 'top', trigger: 'hover focus' });
        }
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initializeAdminPanelTooltip);
        else initializeAdminPanelTooltip();
    }());
</script>
}

@*
@ObjectInfo.Print(Model)
*@
