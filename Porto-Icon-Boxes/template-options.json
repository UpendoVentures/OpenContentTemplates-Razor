      "removeDefaultNone": true,
      "helper": "Choose the padding (top) from the available options."
    },
    "PaddingBottom": {
      "title": "Padding (bottom)",
      "type": "select",
      "optionLabels": [
        "pb-0",
        "pb-1",
        "pb-2",
        "pb-3",
        "pb-4",
        "pb-5",
        "pb-auto"
      ],
      "removeDefaultNone": true,
      "helper": "Choose the padding (bottom) from the available options."
    }
