{
  "type": "object",
  "properties": {
    "ContainerWidth": {
      "type": "string",
      "title": "Container Width",
      "enum": ["container", "container-lg", "container-xl", "container-xxl", "container-fluid"],
      "default": "container-xxl"
    },
    "ImagePosition": {
      "type": "string",
      "title": "Image Position",
      "enum": ["right", "left", "hidden-desktop"],
      "default": "right"
    },
    "MarginTop": {
      "title": "Margin (top)",
      "type": "string",
      "enum": ["", "mt-0", "mt-1", "mt-2", "mt-3", "mt-4", "mt-5", "mt-auto"],
      "default": "mt-0"
    },
    "MarginBottom": {
      "title": "Margin (bottom)",
      "type": "string",
      "enum": ["", "mb-0", "mb-1", "mb-2", "mb-3", "mb-4", "mb-5", "mb-auto"],
      "default": "mb-0"
    },
    "PaddingTop": {
      "title": "Padding (top)",
      "type": "string",
      "enum": ["", "pt-0", "pt-1", "pt-2", "pt-3", "pt-4", "pt-5", "pt-auto"],
      "default": "pt-5"
    },
    "PaddingBottom": {
      "title": "Padding (bottom)",
      "type": "string",
      "enum": ["", "pb-0", "pb-1", "pb-2", "pb-3", "pb-4", "pb-5", "pb-auto"],
      "default": "pb-5"
    },
    "BackgroundColorClass": {
      "type": "string",
      "title": "Background Color",
      "enum": [
        "",
        "bg-primary",
        "bg-primary-scoped",
        "bg-secondary",
        "bg-secondary-scoped",
        "bg-tertiary",
        "bg-quaternary",
        "bg-h5",
        "bg-h6",
        "bg-success",
        "bg-danger",
        "bg-warning",
        "bg-info",
        "bg-light",
        "bg-dark",
        "bg-white",
        "bg-body",
        "bg-transparent",
        "bg-primary-subtle",
        "bg-secondary-subtle",
        "bg-success-subtle",
        "bg-danger-subtle",
        "bg-warning-subtle",
        "bg-info-subtle",
        "bg-light-subtle",
        "bg-dark-subtle",
        "bg-off-white",
        "bg-warm-white",
        "bg-cream",
        "bg-soft-beige",
        "bg-sand",
        "bg-light-sage",
        "bg-sage",
        "bg-pale-green",
        "bg-mist",
        "bg-soft-gray",
        "bg-forest-green"
      ],
      "default": "bg-light"
    },
    "ImageTreatment": {
      "type": "string",
      "title": "Image Treatment",
      "enum": ["grayscale", "color"],
      "default": "grayscale"
    }
  }
}
