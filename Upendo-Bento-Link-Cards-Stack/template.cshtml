@using System
@using System.Collections
@using System.Collections.Generic
@using System.Text.RegularExpressions
@using Upendo.Libraries.RunsOnUpendoCore.Helpers
@inherits Satrabel.OpenContent.Components.OpenContentWebPage

@functions {
    private static object GetDynamicValue(dynamic source, string propertyName)
    {
        if (source == null || string.IsNullOrWhiteSpace(propertyName))
        {
            return null;
        }

        try
        {
            var dictionary = source as IDictionary<string, object>;
            if (dictionary != null && dictionary.ContainsKey(propertyName))
            {
                return dictionary[propertyName];
            }
        }
        catch
        {
        }

        try
        {
            return source[propertyName];
        }
        catch
        {
        }

        try
        {
            var property = ((object)source).GetType().GetProperty(propertyName);
            return property != null ? property.GetValue(source, null) : null;
        }
        catch
        {
            return null;
        }
    }

    private static string GetDynamicString(dynamic source, string propertyName)
    {
        var value = GetDynamicValue(source, propertyName);
        return value != null ? Convert.ToString(value) : string.Empty;
    }

    private static string AllowList(string value, string fallback, params string[] allowedValues)
    {
        if (!string.IsNullOrWhiteSpace(value))
        {
            foreach (var allowedValue in allowedValues)
            {
                if (string.Equals(value, allowedValue, StringComparison.OrdinalIgnoreCase))
                {
                    return allowedValue;
                }
            }
        }

        return fallback;
    }

    private static string GetSafeIconClass(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        var iconClass = value.Trim();
        return Regex.IsMatch(iconClass, @"^[A-Za-z0-9_ -]+$") ? iconClass : string.Empty;
    }
}

@{
    TemplateHelper.HideAdminBorder(Model.Context.ModuleId, Model.Context.TabId);
    RegisterStyleSheet("template.css");

    var moduleTitle = GetDynamicString(Model, "ModuleTitle");
    var moduleAnchor = GetDynamicString(Model, "ModuleAnchor");
    if (!Regex.IsMatch(moduleAnchor ?? string.Empty, @"^[A-Za-z0-9-]+$"))
    {
        moduleAnchor = string.Empty;
    }

    var sectionTitle = GetDynamicString(Model, "SectionTitle");
    var sectionDescription = GetDynamicString(Model, "SectionDescription");
    var sectionFooter = GetDynamicString(Model, "SectionFooter");
    var settings = Model.Settings;

    var backgroundColors = new[]
    {
        "", "bg-primary", "bg-primary-scoped", "bg-secondary", "bg-secondary-scoped", "bg-tertiary",
        "bg-quaternary", "bg-h5", "bg-h6", "bg-success", "bg-danger", "bg-warning", "bg-info",
        "bg-light", "bg-dark", "bg-black", "bg-white", "bg-body", "bg-transparent", "bg-primary-subtle",
        "bg-secondary-subtle", "bg-success-subtle", "bg-danger-subtle", "bg-warning-subtle", "bg-info-subtle",
        "bg-light-subtle", "bg-dark-subtle", "bg-off-white", "bg-warm-white", "bg-cream", "bg-soft-beige",
        "bg-sand", "bg-light-sage", "bg-sage", "bg-pale-green", "bg-mist", "bg-soft-gray", "bg-forest-green"
    };
    var cardBackgroundColors = new List<string>(backgroundColors);
    cardBackgroundColors.Remove("");

    var backgroundColorClass = AllowList(GetDynamicString(settings, "BackgroundColorClass"), string.Empty, backgroundColors);
    var cardBackgroundColorClass = AllowList(GetDynamicString(settings, "CardBackgroundColorClass"), "bg-white", cardBackgroundColors.ToArray());
    var stackPosition = AllowList(GetDynamicString(settings, "StackPosition"), "right", "left", "right");
    var animationLevel = AllowList(GetDynamicString(settings, "AnimationLevel"), "light", "none", "light", "medium", "high");
    var animationName = animationLevel == "high" ? "zoomIn" : (animationLevel == "medium" ? "fadeInUp" : "fadeIn");
    var animationStep = animationLevel == "high" ? 160 : (animationLevel == "medium" ? 100 : 60);
    var animationClass = animationLevel == "none" ? string.Empty : " appear-animation";

    var marginTop = AllowList(GetDynamicString(settings, "MarginTop"), string.Empty, "", "mt-0", "mt-1", "mt-2", "mt-3", "mt-4", "mt-5", "mt-auto");
    var marginBottom = AllowList(GetDynamicString(settings, "MarginBottom"), string.Empty, "", "mb-0", "mb-1", "mb-2", "mb-3", "mb-4", "mb-5", "mb-auto");
    var paddingTop = AllowList(GetDynamicString(settings, "PaddingTop"), "pt-5", "", "pt-0", "pt-1", "pt-2", "pt-3", "pt-4", "pt-5", "pt-auto");
    var paddingBottom = AllowList(GetDynamicString(settings, "PaddingBottom"), "pb-5", "", "pb-0", "pb-1", "pb-2", "pb-3", "pb-4", "pb-5", "pb-auto");

    var iconColors = new[]
    {
        "default", "primary", "primary-scoped", "secondary", "secondary-scoped", "tertiary", "quaternary",
        "h1", "h2", "h3", "h4", "h5", "h6", "body", "body-secondary", "body-tertiary", "dark",
        "black", "black-50", "light", "white", "white-50", "muted", "success", "danger", "warning", "info", "teal"
    };

    var cards = new List<dynamic>();
    var cardValues = GetDynamicValue(Model, "BentoCards") as IEnumerable;
    if (cardValues != null)
    {
        foreach (var cardValue in cardValues)
        {
            if (cards.Count >= 4)
            {
                break;
            }

            cards.Add(cardValue);
        }
    }

    var sectionId = "oc-bento-stack-" + Model.Context.ModuleId;
    var headingId = sectionId + "-heading";
    var sectionLabel = !string.IsNullOrWhiteSpace(moduleTitle) ? moduleTitle : "Bento link cards";
    var sectionClass = "oc-bento-stack w-100 " + backgroundColorClass + " " + marginTop + " " + marginBottom + " " + paddingTop + " " + paddingBottom;
    var headerClass = "oc-bento-stack__header text-center mx-auto" + animationClass;
    var footerClass = "oc-bento-stack__footer text-center mx-auto" + animationClass;
    var hasHeader = !string.IsNullOrWhiteSpace(sectionTitle) || !string.IsNullOrWhiteSpace(sectionDescription);
    var hasContent = hasHeader || cards.Count > 0 || !string.IsNullOrWhiteSpace(sectionFooter);
}

@if (!string.IsNullOrWhiteSpace(moduleAnchor))
{
    <div id="@moduleAnchor"></div>
}

@if (hasContent)
{
    <section id="@sectionId"
             class="@sectionClass"
             data-animation-level="@animationLevel"
             data-stack-position="@stackPosition"
             @if (!string.IsNullOrWhiteSpace(sectionTitle)) { <text>aria-labelledby="@headingId"</text> } else { <text>aria-label="@sectionLabel"</text> }>
        <div class="container-xxl">
            @if (hasHeader)
            {
                <div class="@headerClass"
                     data-appear-animation="@(animationLevel == "none" ? null : animationName)">
                    @if (!string.IsNullOrWhiteSpace(sectionTitle))
                    {
                        <h3 id="@headingId" class="oc-bento-stack__section-title text-notransform">@Html.Raw(sectionTitle)</h3>
                    }
                    @if (!string.IsNullOrWhiteSpace(sectionDescription))
                    {
                        <div class="oc-bento-stack__section-description">@Html.Raw(sectionDescription)</div>
                    }
                </div>
            }

            @if (cards.Count > 0)
            {
                <div class="oc-bento-stack__grid" role="list">
                    @for (var cardIndex = 0; cardIndex < cards.Count; cardIndex++)
                    {
                        var card = cards[cardIndex];
                        var cardNumber = cardIndex + 1;
                        var cardTitle = GetDynamicString(card, "CardTitle");
                        var cardDescription = GetDynamicString(card, "CardDescription");
                        var cardIcon = GetSafeIconClass(GetDynamicString(card, "CardIcon"));
                        var cardIconColor = AllowList(GetDynamicString(card, "CardIconColor"), "default", iconColors);
                        var imageUrl = GetDynamicString(card, "Image");
                        var imageAltText = GetDynamicString(card, "ImageAltText");
                        var learnMoreText = GetDynamicString(card, "LearnMoreText");
                        var learnMoreUrl = GetDynamicString(card, "LearnMoreUrl");
                        var hasLearnMoreUrl = UrlValidationHelper.IsLocalOrExternalHttpUrl(learnMoreUrl);
                        var hasImage = UrlValidationHelper.IsLocalOrExternalHttpUrl(imageUrl);
                        var cardId = sectionId + "-card-" + cardNumber;
                        var cardTitleId = cardId + "-title";
                        var linkTextId = cardId + "-link-text";
                        var linkLabelledBy = !string.IsNullOrWhiteSpace(cardTitle) ? cardTitleId + " " + linkTextId : linkTextId;
                        var cardDelay = cardNumber * animationStep;
                        var linkedClass = hasLearnMoreUrl ? " oc-bento-stack__card--linked" : string.Empty;
                        var iconColorClass = cardIconColor == "default" ? "oc-bento-stack__icon--default" : "text-" + cardIconColor;
                        var valuePropositions = new List<string>();

                        if (cardNumber == 4)
                        {
                            var propositionValues = GetDynamicValue(card, "ValuePropositions") as IEnumerable;
                            if (propositionValues != null)
                            {
                                var propositionIndex = 0;
                                foreach (var propositionValue in propositionValues)
                                {
                                    if (propositionIndex >= 4)
                                    {
                                        break;
                                    }

                                    var proposition = propositionValue != null ? Convert.ToString(propositionValue) : string.Empty;
                                    if (!string.IsNullOrWhiteSpace(proposition))
                                    {
                                        valuePropositions.Add(proposition);
                                    }

                                    propositionIndex++;
                                }
                            }
                        }

                        <article class="oc-bento-stack__card oc-bento-stack__card--@cardNumber @cardBackgroundColorClass@linkedClass@animationClass"
                                 role="listitem"
                                 data-appear-animation="@(animationLevel == "none" ? null : animationName)"
                                 data-appear-animation-delay="@(animationLevel == "none" ? null : Convert.ToString(cardDelay))">
                            <div class="oc-bento-stack__card-layout@(valuePropositions.Count > 0 ? " oc-bento-stack__card-layout--split" : string.Empty)">
                                <div class="oc-bento-stack__content">
                                    @if (!string.IsNullOrWhiteSpace(cardIcon))
                                    {
                                        <div class="oc-bento-stack__icon @iconColorClass" aria-hidden="true">
                                            <i class="@cardIcon"></i>
                                        </div>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(cardTitle))
                                    {
                                        <h4 id="@cardTitleId" class="oc-bento-stack__card-title text-notransform">@Html.Raw(cardTitle)</h4>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(cardDescription))
                                    {
                                        <div class="oc-bento-stack__card-description">@Html.Raw(cardDescription)</div>
                                    }

                                    @if (hasLearnMoreUrl)
                                    {
                                        <a class="oc-bento-stack__link stretched-link"
                                           href="@learnMoreUrl"
                                           aria-labelledby="@linkLabelledBy">
                                            <span id="@linkTextId">@Html.Raw(string.IsNullOrWhiteSpace(learnMoreText) ? "Learn more" : learnMoreText)</span>
                                            <i class="fas fa-arrow-right" aria-hidden="true"></i>
                                        </a>
                                    }
                                </div>

                                @if (cardNumber == 4 && valuePropositions.Count > 0)
                                {
                                    <div class="oc-bento-stack__value-wrap">
                                        <ul class="oc-bento-stack__values">
                                            @foreach (var proposition in valuePropositions)
                                            {
                                                <li><i class="fas fa-check-circle" aria-hidden="true"></i><span>@Html.Raw(proposition)</span></li>
                                            }
                                        </ul>
                                    </div>
                                }
                            </div>

                            @if (cardNumber == 1 && hasImage)
                            {
                                <div class="oc-bento-stack__image-wrap">
                                    <img class="oc-bento-stack__image"
                                         src="@imageUrl"
                                         alt="@imageAltText"
                                         loading="lazy"
                                         decoding="async" />
                                </div>
                            }
                        </article>
                    }
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(sectionFooter))
            {
                <div class="@footerClass"
                     data-appear-animation="@(animationLevel == "none" ? null : animationName)">@Html.Raw(sectionFooter)</div>
            }
        </div>
    </section>
}
