@using DotNetNuke.Entities.Modules
@using Upendo.Libraries.RunsOnUpendoCore.Helpers
@inherits Satrabel.OpenContent.Components.OpenContentWebPage
@{
    // Update or create the "hideadminborder" setting with the value "True"
    TemplateHelper.HideAdminBorder(Dnn.Module.ModuleID, Dnn.Module.TabID);

    // Build the title line: "Text & Text1" only when both exist; otherwise show the one that exists.
    var hasText = !string.IsNullOrWhiteSpace(Model.Text);
    var hasText1 = !string.IsNullOrWhiteSpace(Model.Text1);

    string titleLine = null;

    if (hasText && hasText1)
    {
        titleLine = Model.Text + " &amp; " + Model.Text1;
    }
    else if (hasText)
    {
        titleLine = Model.Text;
    }
    else if (hasText1)
    {
        titleLine = Model.Text1;
    }
}

@if (!string.IsNullOrEmpty(Model.ModuleAnchor))
{
    <div id="@Model.ModuleAnchor"></div>
}
<div class="@string.Format("testimonial {0} {1}", Model.Settings.Color, Model.Settings.Style)">
    <blockquote>
        <p>@Model.Content</p>
    </blockquote>
    <div class="testimonial-arrow-down"></div>
    @if (Model.Settings.Style == "testimonial-style-5")
    {
        <div class="testimonial-author">
            <p>
                <strong>@Model.Fullname</strong>
                @if (!string.IsNullOrEmpty(titleLine))
                {
                    <span>@Html.Raw(titleLine)</span>
                }
            </p>
        </div>
    }
    else
    {
        <div class="testimonial-author">
            @if (Model.Settings.Style == "testimonial-style-2")
            {
                <img alt="Client-2" src="@Model.Image" class="img-fluid rounded-circle" />
            }
            else
            {
                <div class="testimonial-author-thumbnail img-thumbnail">
                    <img alt="Image" src="@Model.Image" />
                </div>
            }
            <p>
                <strong>@Model.Fullname</strong>
                @if (!string.IsNullOrEmpty(titleLine))
                {
                    <span>@Html.Raw(titleLine)</span>
                }
            </p>
        </div>
    }
</div>
