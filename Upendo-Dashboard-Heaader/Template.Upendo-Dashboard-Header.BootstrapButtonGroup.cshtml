@using DotNetNuke.Entities.Controllers
@using DotNetNuke.Entities.Users
@using System
@using System.Text.RegularExpressions
@using System.Web
@{
    var ticketsUrlRaw = HostController.Instance.GetString("Upendo.Support.TicketsUrl", string.Empty);
    var supportEmailRaw = HostController.Instance.GetString("Upendo.Support.Email", string.Empty);
    var docsUrlRaw = HostController.Instance.GetString("Upendo.Support.DocsUrl", string.Empty);

    var ticketsUrl = string.IsNullOrWhiteSpace(ticketsUrlRaw) ? string.Empty : ticketsUrlRaw.Trim();
    var supportEmail = string.IsNullOrWhiteSpace(supportEmailRaw) ? string.Empty : supportEmailRaw.Trim();
    var docsUrl = string.IsNullOrWhiteSpace(docsUrlRaw) ? string.Empty : docsUrlRaw.Trim();

    if (string.IsNullOrWhiteSpace(ticketsUrl))
    {
        ticketsUrl = "#";
    }

    if (string.IsNullOrWhiteSpace(docsUrl))
    {
        docsUrl = "#";
    }

    var host = Context.Request.Url.Host;
    var domainName = host.StartsWith("www.", StringComparison.OrdinalIgnoreCase)
        ? host.Substring(4)
        : host;

    var user = (Dnn != null && Dnn.User != null) ? Dnn.User : UserController.Instance.GetCurrentUserInfo();
    var displayName = (user != null && !string.IsNullOrWhiteSpace(user.FirstName))
        ? user.FirstName.Trim()
        : (user != null && !string.IsNullOrWhiteSpace(user.DisplayName) ? user.DisplayName.Trim() : "there");

    DateTime lastVisit = DateTime.MinValue;
    try
    {
        if (user != null)
        {
            var lastLoginDateProp = user.GetType().GetProperty("LastLoginDate");
            if (lastLoginDateProp != null)
            {
                object valObj = lastLoginDateProp.GetValue(user, null);
                if (valObj is DateTime)
                {
                    DateTime valDt = (DateTime)valObj;
                    if (valDt != DateTime.MinValue)
                    {
                        lastVisit = valDt;
                    }
                }
            }

            if (lastVisit == DateTime.MinValue && user.Membership.LastLoginDate != DateTime.MinValue)
            {
                lastVisit = user.Membership.LastLoginDate;
            }

            if (lastVisit == DateTime.MinValue && user.Membership.LastActivityDate != DateTime.MinValue)
            {
                lastVisit = user.Membership.LastActivityDate;
            }
        }
    }
    catch
    {
    }

    var lastVisitText = lastVisit != DateTime.MinValue
        ? lastVisit.ToLocalTime().ToString("MMM d, yyyy h:mm tt")
        : "--";

    var moduleId = (Dnn != null && Dnn.Module != null) ? Dnn.Module.ModuleID : 0;
    var uniqueSuffix = moduleId > 0 ? moduleId.ToString() : DateTime.UtcNow.Ticks.ToString();
    var componentId = "uv-dashboard-header-" + uniqueSuffix;
    var headingId = componentId + "-heading";

    var moduleAnchorRaw = Model.ModuleAnchor as string;
    var moduleAnchor = string.Empty;
    if (!string.IsNullOrWhiteSpace(moduleAnchorRaw))
    {
        moduleAnchor = Regex.Replace(moduleAnchorRaw.Trim(), "[^a-zA-Z0-9-]", string.Empty);
    }

    var supportHref = string.Empty;
    if (!string.IsNullOrWhiteSpace(supportEmail))
    {
        supportHref = "mailto:" + supportEmail + "?subject=" + HttpUtility.UrlEncode(domainName + ": Support Inquiry");
    }

    var referSubject = HttpUtility.UrlEncode("Quick intro: Will at Upendo Ventures");
    var referBody = HttpUtility.UrlEncode("Hi [Friend's first name],\r\n\r\nThought of you for this. I work with Upendo Ventures, a local, small-business friendly team. They help with websites, support, and everyday tech questions.\r\n\r\nIf you decide to sign up, you'll also get 15% off their site migration service with the code: FRIENDSOFUPENDO.\r\n\r\nThanks!\r\n[Your name]");
    var referLink = "mailto:?cc=solutions@upendoventures.com&subject=" + referSubject + "&body=" + referBody;
}

@if (!string.IsNullOrWhiteSpace(moduleAnchor))
{
    <span id="@moduleAnchor" class="uv-dashboard-header-anchor" aria-hidden="true"></span>
}

<style>
    #@componentId {
        margin: 0 0 2rem;
    }

    #@componentId,
    #@componentId * {
        box-sizing: border-box;
    }

    #@componentId .uv-dashboard-header__notice {
        margin-bottom: 2rem;
    }

    #@componentId .uv-dashboard-header__notice-body {
        display: table;
        width: 100%;
    }

    #@componentId .uv-dashboard-header__notice-icon,
    #@componentId .uv-dashboard-header__notice-copy,
    #@componentId .uv-dashboard-header__notice-action {
        display: table-cell;
        vertical-align: middle;
    }

    #@componentId .uv-dashboard-header__notice-icon {
        width: 2rem;
        padding-right: 0.75rem;
        font-size: 1.25rem;
    }

    #@componentId .uv-dashboard-header__notice-copy {
        line-height: 1.45;
    }

    #@componentId .uv-dashboard-header__notice-action {
        width: 1%;
        padding-left: 1rem;
        white-space: nowrap;
    }

    #@componentId .uv-dashboard-header__panel {
        display: table;
        width: 100%;
        padding: 0 0 1.5rem;
        border-bottom: 1px solid rgba(0, 0, 0, 0.16);
    }

    #@componentId .uv-dashboard-header__summary,
    #@componentId .uv-dashboard-header__actions {
        display: table-cell;
        vertical-align: middle;
    }

    #@componentId .uv-dashboard-header__summary {
        width: 45%;
        padding-right: 1.5rem;
    }

    #@componentId .uv-dashboard-header__actions {
        width: 55%;
        text-align: right;
    }

    #@componentId .uv-dashboard-header__title {
        margin-top: 0;
        margin-bottom: 0.25rem;
        font-size: 1.15rem;
        line-height: 1.3;
    }

    #@componentId .uv-dashboard-header__title-icon {
        margin-right: 0.45rem;
        color: #dc3545;
    }

    #@componentId .uv-dashboard-header__meta {
        margin: 0;
        color: #777;
        line-height: 1.35;
    }

    #@componentId .uv-dashboard-header__meta-icon {
        margin-right: 0.45rem;
        color: #999;
    }

    #@componentId .uv-dashboard-header__actions .btn-group {
        max-width: 100%;
        white-space: nowrap;
    }

    #@componentId .uv-dashboard-header__actions .btn {
        float: none;
    }

    #@componentId .uv-dashboard-header__actions .btn .fa {
        margin-right: 0.45rem;
    }

    #@componentId .uv-dashboard-header__notice-action .btn .fa {
        margin-right: 0.45rem;
    }

    @@media (max-width: 767px) {
        #@componentId .uv-dashboard-header__notice-body,
        #@componentId .uv-dashboard-header__notice-icon,
        #@componentId .uv-dashboard-header__notice-copy,
        #@componentId .uv-dashboard-header__notice-action,
        #@componentId .uv-dashboard-header__panel,
        #@componentId .uv-dashboard-header__summary,
        #@componentId .uv-dashboard-header__actions {
            display: block;
            width: auto;
        }

        #@componentId .uv-dashboard-header__notice-icon {
            float: left;
            width: auto;
            padding-right: 0.75rem;
        }

        #@componentId .uv-dashboard-header__notice-action {
            padding-top: 0.85rem;
            padding-left: 0;
            white-space: normal;
        }

        #@componentId .uv-dashboard-header__summary {
            padding-right: 0;
            margin-bottom: 1rem;
        }

        #@componentId .uv-dashboard-header__actions {
            text-align: left;
        }

        #@componentId .uv-dashboard-header__actions .btn-group {
            display: block;
            width: 100%;
        }

        #@componentId .uv-dashboard-header__actions .btn-group > .btn,
        #@componentId .uv-dashboard-header__actions .btn-group > .btn:first-child,
        #@componentId .uv-dashboard-header__actions .btn-group > .btn:last-child {
            display: block;
            width: 100%;
            margin: 0 0 0.5rem;
            border-radius: 0.25rem;
        }
    }
</style>

<section id="@componentId" class="uv-dashboard-header" aria-labelledby="@headingId">
    <div class="alert alert-success uv-dashboard-header__notice" role="status" aria-label="Referral program">
        <div class="uv-dashboard-header__notice-body">
            <div class="uv-dashboard-header__notice-icon" aria-hidden="true">
                <i class="fa fa-info-circle"></i>
            </div>

            <div class="uv-dashboard-header__notice-copy">
                Know of someone who could benefit from our services? If you
                <a href="@referLink"
                   class="alert-link track-client"
                   data-toggle="tooltip"
                   data-placement="top"
                   data-bs-toggle="tooltip"
                   data-bs-placement="top"
                   title="Open a prefilled email to make referring to us easy.">refer them</a>
                and they become a client, we'll give you <strong>a month of service free!</strong>
            </div>

            <div class="uv-dashboard-header__notice-action">
                <a href="@referLink"
                   class="btn btn-sm btn-primary track-client"
                   data-toggle="tooltip"
                   data-placement="top"
                   data-bs-toggle="tooltip"
                   data-bs-placement="top"
                   title="Open a prefilled referral email.">
                    <i class="fa fa-envelope" aria-hidden="true"></i>Refer a Friend
                </a>
            </div>
        </div>
    </div>

    <div class="uv-dashboard-header__panel">
        <div class="uv-dashboard-header__summary">
            <h2 id="@headingId" class="uv-dashboard-header__title">
                <i class="fa fa-heart uv-dashboard-header__title-icon" aria-hidden="true"></i>
                Welcome back, <strong>@displayName</strong>
            </h2>
            <p class="uv-dashboard-header__meta">
                <i class="fa fa-clock-o uv-dashboard-header__meta-icon" aria-hidden="true"></i>
                Last visit: <span aria-live="polite">@lastVisitText</span>
            </p>
        </div>

        <nav class="uv-dashboard-header__actions" aria-label="Support quick links">
            <div class="btn-group btn-group-sm" role="group" aria-label="Support quick links">
                @if (!string.IsNullOrWhiteSpace(supportEmail))
                {
                    <a class="btn btn-primary track-client"
                       href="@supportHref"
                       aria-label="Email support at @supportEmail"
                       data-toggle="tooltip"
                       data-placement="top"
                       data-bs-toggle="tooltip"
                       data-bs-placement="top"
                       title="Email our support team directly for help.">
                        <i class="fa fa-envelope" aria-hidden="true"></i>Email Support
                    </a>
                }
                else
                {
                    <button type="button"
                            class="btn btn-secondary track-client"
                            disabled="disabled"
                            aria-disabled="true"
                            data-toggle="tooltip"
                            data-placement="top"
                            data-bs-toggle="tooltip"
                            data-bs-placement="top"
                            title="Support email is not configured. Please contact your administrator.">
                        <i class="fa fa-envelope" aria-hidden="true"></i>Support email not configured
                    </button>
                }

                <a class="btn btn-secondary track-client"
                   href="https://upendoventures.com/Schedule-Us"
                   target="_blank"
                   rel="noopener noreferrer"
                   aria-label="Schedule a meeting with Upendo Support"
                   data-toggle="tooltip"
                   data-placement="top"
                   data-bs-toggle="tooltip"
                   data-bs-placement="top"
                   title="Schedule a meeting with us right away.">
                    <i class="fa fa-calendar" aria-hidden="true"></i>Need to Meet?
                </a>

                <a class="btn btn-secondary track-client"
                   href="https://upendoventures.wetransfer.com/"
                   target="_blank"
                   rel="noopener noreferrer"
                   aria-label="Send files via WeTransfer"
                   data-toggle="tooltip"
                   data-placement="top"
                   data-bs-toggle="tooltip"
                   data-bs-placement="top"
                   title="Securely send us files through WeTransfer.">
                    <i class="fa fa-upload" aria-hidden="true"></i>Send Files
                </a>

                <a class="btn btn-secondary"
                   href="@docsUrl"
                   target="_blank"
                   rel="noopener noreferrer"
                   aria-label="View documentation in a new tab"
                   data-toggle="tooltip"
                   data-placement="top"
                   data-bs-toggle="tooltip"
                   data-bs-placement="top"
                   title="Browse our documentation to find answers quickly.">
                    <i class="fa fa-book" aria-hidden="true"></i>Documentation
                </a>
            </div>
        </nav>
    </div>
</section>
