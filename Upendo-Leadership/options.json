{
  "fields": {
    "ModuleTitle": {
      "type": "text",
      "helper": "Used to sync with the system's module title. This does not display to site visitors. It makes it useful to restore content, if/when needed.",
      "placeholder": "Try entering anything that's somewhat unique"
    },
    "ModuleAnchor": {
      "type": "text",
      "helper": "Used to create #anchor-links on the page (numbers, letters, hyphens only)."
    },
    "Leaders": {
      "type": "accordion",
      "helper": "Must have at least one.",
      "items": {
        "fields": {
          "FullName": {
            "type": "text",
            "helper": "first & last name"
          },
          "CompanyName": {
            "type": "text"
          },
          "Title": {
            "type": "text"
          },
          "Image": {
            "type": "image",
            "uploadfolder": "/Images/Members/",
            "typeahead": {
              "Folder": "/Images/Members/"
            }
          },
          "Email": {
            "type": "email"
          },
          "MemberPage": {
            "type": "url"
          }
        }
      }
    }
  }
}