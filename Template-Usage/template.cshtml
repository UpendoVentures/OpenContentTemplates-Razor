@inherits Satrabel.OpenContent.Components.OpenContentWebPage

@{
    var moduleId = Dnn.Module.ModuleID;
    var tabId = Dnn.Module.TabID;
    var initialScope = Model.Settings != null && Model.Settings.ThisPortal ? "portal" : "instance";

    var marginTop = Model.Settings != null && Model.Settings.MarginTop != null ? Convert.ToString(Model.Settings.MarginTop) : "mt-5";
    var marginBottom = Model.Settings != null && Model.Settings.MarginBottom != null ? Convert.ToString(Model.Settings.MarginBottom) : "mb-5";
    var paddingTop = Model.Settings != null && Model.Settings.PaddingTop != null ? Convert.ToString(Model.Settings.PaddingTop) : "pt-3";
    var paddingBottom = Model.Settings != null && Model.Settings.PaddingBottom != null ? Convert.ToString(Model.Settings.PaddingBottom) : "pb-3";
    var outerSectionClass = "";
    if (!string.IsNullOrWhiteSpace(marginTop)) { outerSectionClass += " " + marginTop; }
    if (!string.IsNullOrWhiteSpace(marginBottom)) { outerSectionClass += " " + marginBottom; }
    if (!string.IsNullOrWhiteSpace(paddingTop)) { outerSectionClass += " " + paddingTop; }
    if (!string.IsNullOrWhiteSpace(paddingBottom)) { outerSectionClass += " " + paddingBottom; }
}

<link rel="stylesheet" href="https://cdn.datatables.net/3.1.4/css/dataTables.dataTables.css" />
<section id="oc-template-usage-@moduleId" class="oc-template-usage @outerSectionClass" data-template-usage data-module-id="@moduleId" data-tab-id="@tabId" data-scope="@initialScope" aria-labelledby="oc-template-usage-title-@moduleId">
    <div class="oc-template-usage__header">
        <div class="px-3">
            <p class="oc-template-usage__eyebrow"><span class="fa fa-screwdriver-wrench" aria-hidden="true"></span> Administrative inventory</p>
            <h2 id="oc-template-usage-title-@moduleId">OpenContent <strong>Template Usage</strong></h2>
            <p class="oc-template-usage__intro">Search template references, website templates, and shared <code>_default</code> templates without loading the entire report into the page.</p>
        </div>
        <div class="oc-template-usage__actions">
            <div class="oc-template-usage__scope-control" data-template-usage-scope-control hidden>
                <div class="oc-template-usage__scope-label">
                    <label for="oc-template-usage-scope-@moduleId">Inventory scope</label>
                    <button type="button" class="btn btn-link btn-sm p-0" data-bs-toggle="tooltip" data-bs-placement="top" title="Choose the current website to review one website, or the entire installation to review every website." aria-label="Inventory scope help"><span class="fa fa-circle-question" aria-hidden="true"></span></button>
                </div>
                <select id="oc-template-usage-scope-@moduleId" class="form-select form-select-sm" data-template-usage-scope></select>
            </div>
            <select class="form-select form-select-sm" data-template-usage-source aria-label="Template source filter"><option value="">All sources</option><option value="Portal">Website templates</option><option value="_default">Shared default templates</option></select>
            <select class="form-select form-select-sm" data-template-usage-status-filter aria-label="Template status filter"><option value="">All statuses</option><option value="in-use">In use</option><option value="unused">Unused</option><option value="missing">Missing</option></select>
            <button type="button" class="btn btn-primary btn-sm" data-template-usage-refresh data-bs-toggle="tooltip" data-bs-placement="top" title="Reload the summary and both inventory tables."><span class="fa fa-rotate" aria-hidden="true"></span> Refresh</button>
            <button type="button" class="btn btn-outline-secondary btn-sm" data-template-usage-candidates data-bs-toggle="tooltip" data-bs-placement="top" title="Show read-only findings for missing references and unused physical templates."><span class="fa fa-broom" aria-hidden="true"></span> Review findings</button>
            <button type="button" class="btn btn-outline-secondary btn-sm" data-template-usage-export data-bs-toggle="tooltip" data-bs-placement="top" title="Download the filtered physical-template inventory as a CSV file."><span class="fa fa-download" aria-hidden="true"></span> Export inventory</button>
            <button type="button" class="btn btn-outline-secondary btn-sm" data-template-usage-candidate-export data-bs-toggle="tooltip" data-bs-placement="top" title="Download the read-only findings as a CSV file."><span class="fa fa-file-arrow-down" aria-hidden="true"></span> Export findings</button>
        </div>
    </div>
    <div class="oc-template-usage__status alert alert-info py-2 mb-3" data-template-usage-status role="status" aria-live="polite">Loading summary…</div>
    <div class="oc-template-usage__summary" data-template-usage-summary></div>
    <div class="oc-template-usage__tabs">
        <ul class="nav nav-tabs" role="tablist">
            <li class="nav-item" role="presentation"><button class="nav-link active" id="oc-template-usage-templates-tab-@moduleId" data-bs-toggle="tab" data-bs-target="#oc-template-usage-templates-pane-@moduleId" type="button" role="tab" aria-controls="oc-template-usage-templates-pane-@moduleId" aria-selected="true" data-template-usage-tab="templates">Physical Templates</button></li>
            <li class="nav-item" role="presentation"><button class="nav-link" id="oc-template-usage-usages-tab-@moduleId" data-bs-toggle="tab" data-bs-target="#oc-template-usage-usages-pane-@moduleId" type="button" role="tab" aria-controls="oc-template-usage-usages-pane-@moduleId" aria-selected="false" tabindex="-1" data-template-usage-tab="usages">Module Usage</button></li>
        </ul>
        <div class="tab-content">
            <section class="oc-template-usage__panel tab-pane fade show active" id="oc-template-usage-templates-pane-@moduleId" role="tabpanel" aria-labelledby="oc-template-usage-templates-tab-@moduleId" tabindex="0">
                <h3 id="oc-template-usage-templates-title-@moduleId">Physical Templates</h3>
                <p class="text-muted">Search and filter physical templates and missing references. Results are loaded page by page.</p>
                <div class="table-responsive"><table id="oc-template-usage-templates-@moduleId" class="table table-sm table-striped align-middle" style="width:100%">
                    <thead><tr><th>Source</th><th>Website</th><th>Template</th><th>Status</th><th>Uses</th></tr></thead>
                </table></div>
            </section>
            <section class="oc-template-usage__panel tab-pane fade" id="oc-template-usage-usages-pane-@moduleId" role="tabpanel" aria-labelledby="oc-template-usage-usages-tab-@moduleId" tabindex="0">
                <h3 id="oc-template-usage-usages-title-@moduleId">Module Usage</h3>
                <p class="text-muted">Every OpenContent module instance using a configured template.</p>
                <div class="table-responsive"><table id="oc-template-usage-usages-@moduleId" class="table table-sm table-striped align-middle" style="width:100%">
                    <thead><tr><th>Template</th><th>Website</th><th>Page</th><th>Module</th></tr></thead>
                </table></div>
            </section>
        </div>
    </div>
    <section class="oc-template-usage__candidates" data-template-usage-candidate-panel hidden aria-labelledby="oc-template-usage-candidates-title-@moduleId">
        <h3 id="oc-template-usage-candidates-title-@moduleId">Review findings</h3>
        <p class="text-muted">These are read-only findings. Review them before making manual file or module changes.</p>
        <div class="table-responsive"><table class="table table-sm table-striped align-middle">
            <thead><tr><th>Status</th><th>Source</th><th>Website</th><th>Template</th><th>Uses</th><th>Reason</th></tr></thead>
            <tbody data-template-usage-candidates></tbody>
        </table></div>
    </section>
</section>
<script src="https://cdn.datatables.net/3.1.4/js/dataTables.js"></script>
<script>
(function () {
    var script = document.currentScript, root = script, moduleId, tabId, scopeControl, scopeSelect, sourceSelect, statusSelect, status, summary, candidatePanel, candidates, scope, websiteId, templatesTable, usagesTable, tabs, stateKey, state = {}, scopeOptions = null;
    while (root && (!root.hasAttribute || !root.hasAttribute('data-template-usage'))) { root = root.previousElementSibling; }
    if (!root) return;
    moduleId = root.getAttribute('data-module-id');
    tabId = root.getAttribute('data-tab-id');
    scopeControl = root.querySelector('[data-template-usage-scope-control]');
    scopeSelect = root.querySelector('[data-template-usage-scope]');
    sourceSelect = root.querySelector('[data-template-usage-source]');
    statusSelect = root.querySelector('[data-template-usage-status-filter]');
    status = root.querySelector('[data-template-usage-status]');
    summary = root.querySelector('[data-template-usage-summary]');
    candidatePanel = root.querySelector('[data-template-usage-candidate-panel]');
    candidates = root.querySelector('[data-template-usage-candidates]');
    scope = 'current';
    websiteId = 0;
    tabs = root.querySelectorAll('[data-template-usage-tab]');
    stateKey = 'opencontent-template-usage:' + tabId + ':' + moduleId;
    function readState() {
        try { state = JSON.parse(window.sessionStorage.getItem(stateKey) || '{}') || {}; } catch (error) { state = {}; }
        scope = state.scope || 'current';
        sourceSelect.value = state.source || '';
        statusSelect.value = state.status || '';
    }
    function saveState() {
        try { window.sessionStorage.setItem(stateKey, JSON.stringify(state)); } catch (error) { }
    }
    function setStatus(message, style) {
        status.textContent = message;
        status.className = 'oc-template-usage__status alert py-2 mb-3 alert-' + (style || 'info');
    }
    function initTooltips() {
        if (!window.bootstrap || !window.bootstrap.Tooltip) return;
        root.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function (element) { window.bootstrap.Tooltip.getOrCreateInstance(element, { placement: 'top' }); });
    }
    function getServicesFramework() {
        try {
            if (window.jQuery && window.jQuery.ServicesFramework) return window.jQuery.ServicesFramework(moduleId);
            if (window.$ && window.$.ServicesFramework) return window.$.ServicesFramework(moduleId);
        } catch (error) { return null; }
        return null;
    }
    function getHeaders() {
        var headers = { 'Accept': 'application/json', 'ModuleId': moduleId, 'TabId': tabId };
        var sf = getServicesFramework();
        if (sf && sf.getAntiForgeryValue) headers.RequestVerificationToken = sf.getAntiForgeryValue();
        return headers;
    }
    function apiUrl(path) {
        var url = '/DesktopModules/OpenContentHelper/API/TemplateUsage/' + path + '?scope=' + encodeURIComponent(scope);
        if (websiteId > 0) url += '&websiteId=' + encodeURIComponent(websiteId);
        return url;
    }
    function renderSummary(data) {
        var items = [
            ['Referenced templates', data.DistinctReferencedTemplates, 'Distinct template paths currently referenced by OpenContent modules.'],
            ['OpenContent instances', data.OpenContentModuleInstances, 'OpenContent module instances using a configured template.'],
            ['Website templates', data.PhysicalPortalTemplates, 'Physical templates found in the selected website folders.'],
            ['Shared default templates', data.PhysicalDefaultTemplates, 'Physical templates found in the shared default folder.'],
            ['Unused physical', data.UnusedPhysicalTemplates, 'Physical templates with no matching module usage in the selected scope.'],
            ['Missing references', data.MissingTemplateReferences, 'Template references without a matching physical folder.']
        ];
        summary.innerHTML = '';
        items.forEach(function (item) {
            var card = document.createElement('div'); card.className = 'oc-template-usage__metric'; card.setAttribute('tabindex', '0'); card.setAttribute('data-bs-toggle', 'tooltip'); card.setAttribute('data-bs-placement', 'top'); card.setAttribute('title', item[2]);
            var value = document.createElement('strong'); value.textContent = '0';
            var label = document.createElement('span'); label.textContent = item[0]; card.appendChild(value); card.appendChild(label); summary.appendChild(card);
            animateCount(value, Number(item[1]) || 0);
        });
        initTooltips();
    }
    function animateCount(element, target) {
        if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) { element.textContent = target; return; }
        var start = Date.now(), duration = 900;
        function step() { var progress = Math.min(1, (Date.now() - start) / duration); element.textContent = Math.round(target * progress); if (progress < 1 && window.requestAnimationFrame) window.requestAnimationFrame(step); }
        if (window.requestAnimationFrame) window.requestAnimationFrame(step); else element.textContent = target;
    }
    function applyScope(value) {
        scope = value || 'current';
        websiteId = scope.indexOf('website:') === 0 ? Number(scope.substring('website:'.length)) || 0 : 0;
        state.scope = scope;
        if (scopeSelect) scopeSelect.value = scope;
        saveState();
    }
    function fetchScopeOptions() {
        return fetch('/DesktopModules/OpenContentHelper/API/TemplateUsage/GetScopeOptions', { credentials: 'same-origin', headers: getHeaders() }).then(function (response) { if (!response.ok) throw new Error('The website scope request failed.'); return response.json(); }).then(function (data) {
            scopeOptions = data || {};
            if (!scopeOptions.CanSelectWebsite) {
                scopeControl.hidden = true;
                applyScope('current');
                return;
            }
            scopeSelect.innerHTML = '';
            (scopeOptions.Options || []).forEach(function (option) { var element = document.createElement('option'); element.value = option.Value; element.textContent = option.Label; scopeSelect.appendChild(element); });
            scopeControl.hidden = false;
            var requested = state.scope && Array.prototype.some.call(scopeSelect.options, function (option) { return option.value === state.scope; }) ? state.scope : 'current';
            applyScope(requested);
        });
    }
    function fetchSummary() {
        return fetch(apiUrl('GetSummary'), { credentials: 'same-origin', headers: getHeaders() }).then(function (response) { if (!response.ok) throw new Error('The inventory summary request failed.'); return response.json(); }).then(function (data) { renderSummary(data || {}); });
    }
    function tableRequest(path, d) {
        var params = new URLSearchParams(); params.set('scope', scope); if (websiteId > 0) params.set('websiteId', websiteId); params.set('draw', d.draw); params.set('start', d.start); params.set('length', d.length); params.set('searchValue', d.search && d.search.value ? d.search.value : ''); params.set('orderColumn', d.order && d.order.length ? d.order[0].column : 0); params.set('orderDir', d.order && d.order.length ? d.order[0].dir : 'asc'); params.set('source', sourceSelect.value); params.set('status', statusSelect.value);
        return fetch('/DesktopModules/OpenContentHelper/API/TemplateUsage/' + path + '?' + params.toString(), { credentials: 'same-origin', headers: getHeaders() }).then(function (response) { if (!response.ok) throw new Error('The inventory table request failed.'); return response.json(); });
    }
    function restoreTableState(table, name) {
        var saved = state[name] || {};
        if (saved.search) table.search(saved.search);
        if (saved.length) table.page.len(saved.length);
        if (saved.order) table.order(saved.order);
        if (saved.page != null) table.page(saved.page);
    }
    function persistTableState(table, name) {
        state[name] = { search: table.search(), length: table.page.len(), page: table.page(), order: table.order() }; saveState();
    }
    function linkFor(row) { return '/default.aspx?tabid=' + encodeURIComponent(row.TabId) + '#' + encodeURIComponent(row.ModuleId); }
    function shortValue(value, title) { var text = value == null || value === '' ? '' : String(value); return '<span class="text-truncate d-inline-block oc-template-usage__truncated" title="' + escapeHtml(title || text) + '">' + escapeHtml(text) + '</span>'; }
    function sourceLabel(source) { return source === 'Portal' ? 'Website' : source === '_default' ? 'Shared default' : source; }
    function statusBadge(data) { var label = !data.Exists ? 'Missing' : data.UsageCount > 0 ? 'In use' : 'Unused'; var color = label === 'Missing' ? 'danger' : label === 'In use' ? 'success' : 'warning'; var textClass = color === 'warning' ? ' text-dark' : ''; return '<span class="badge bg-' + color + textClass + '">' + label + '</span>'; }
    function initTables() {
        templatesTable = new DataTable('#oc-template-usage-templates-' + moduleId, { processing: true, serverSide: true, pageLength: 25, searching: true, order: [[2, 'asc']], ajax: function (d, callback) { tableRequest('GetTemplates', d).then(normalizeDataTableResponse).then(callback).catch(function (error) { setStatus(error.message, 'danger'); callback({ draw: d.draw, recordsTotal: 0, recordsFiltered: 0, data: [] }); }); }, columns: [{ data: 'Source', render: function (data, type) { return type === 'display' ? sourceLabel(data) : data; } }, { data: 'PortalName', render: function (data, type) { return type === 'display' ? shortValue(data, data) : data; } }, { data: 'TemplatePath' }, { data: null, render: function (data, type) { return type === 'display' ? statusBadge(data) : (!data.Exists ? 'Missing' : data.UsageCount > 0 ? 'In use' : 'Unused'); } }, { data: 'UsageCount' }] });
        usagesTable = new DataTable('#oc-template-usage-usages-' + moduleId, { processing: true, serverSide: true, pageLength: 25, searching: true, order: [[0, 'asc']], ajax: function (d, callback) { tableRequest('GetUsages', d).then(normalizeDataTableResponse).then(callback).catch(function (error) { setStatus(error.message, 'danger'); callback({ draw: d.draw, recordsTotal: 0, recordsFiltered: 0, data: [] }); }); }, columns: [{ data: 'TemplatePath', render: function (data, type, row) { return type === 'display' ? '<a href="' + linkFor(row) + '" target="_blank">' + shortValue(data, data) + '</a>' : data; } }, { data: 'PortalName', render: function (data, type) { return type === 'display' ? shortValue(data, data) : data; } }, { data: 'TabName', render: function (data, type, row) { var label = (data || '') + (row.TabPath ? ' (' + row.TabPath + ')' : ''); return type === 'display' ? '<a href="' + linkFor(row) + '" target="_blank">' + shortValue(label, label) + '</a>' : label; } }, { data: null, render: function (data, type, row) { var title = row.ModuleTitle || '(no title)'; var label = title + ' (' + row.ModuleId + ')'; return type === 'display' ? shortValue(label, label) : label; } }] });
        restoreTableState(templatesTable, 'templates'); restoreTableState(usagesTable, 'usages');
        templatesTable.on('draw', function () { persistTableState(templatesTable, 'templates'); initTooltips(); }); usagesTable.on('draw', function () { persistTableState(usagesTable, 'usages'); initTooltips(); });
    }
    function escapeHtml(value) {
        return String(value == null ? '' : value).replace(/[&<>'"]/g, function (character) {
            switch (character) {
                case '&': return '&amp;';
                case '<': return '&lt;';
                case '>': return '&gt;';
                case '"': return '&quot;';
                case "'": return String.fromCharCode(38, 35, 51, 57, 59);
                default: return character;
            }
        });
    }
    function normalizeDataTableResponse(payload) { return { draw: payload.draw || payload.Draw, recordsTotal: payload.recordsTotal || payload.RecordsTotal, recordsFiltered: payload.recordsFiltered || payload.RecordsFiltered, data: payload.data || payload.Data || [] }; }
    function loadCandidates() {
        candidatePanel.hidden = false; candidates.innerHTML = '<tr><td colspan="6">Loading findings…</td></tr>';
        fetch(apiUrl('GetCleanupCandidates'), { credentials: 'same-origin', headers: getHeaders() }).then(function (response) { if (!response.ok) throw new Error('The findings request failed.'); return response.json(); }).then(function (items) { candidates.innerHTML = ''; (items || []).forEach(function (item) { var row = document.createElement('tr'); [item.Status, sourceLabel(item.Source), item.PortalName, item.TemplatePath, item.UsageCount, item.Reason].forEach(function (value) { var cell = document.createElement('td'); cell.textContent = value == null ? '' : value; row.appendChild(cell); }); candidates.appendChild(row); }); if (!candidates.children.length) candidates.innerHTML = '<tr><td colspan="6">No findings were found.</td></tr>'; }).catch(function (error) { candidates.innerHTML = '<tr><td colspan="6">' + escapeHtml(error.message) + '</td></tr>'; });
    }
    function exportReport(report, fileName) {
        fetch(apiUrl('Export') + '&report=' + encodeURIComponent(report) + '&searchValue=' + encodeURIComponent(templatesTable ? templatesTable.search() : '') + '&source=' + encodeURIComponent(sourceSelect.value) + '&status=' + encodeURIComponent(statusSelect.value), { credentials: 'same-origin', headers: getHeaders() }).then(function (response) { if (!response.ok) throw new Error('The CSV export failed.'); return response.blob(); }).then(function (blob) { var link = document.createElement('a'); var url = URL.createObjectURL(blob); link.href = url; link.download = fileName; document.body.appendChild(link); link.click(); link.remove(); URL.revokeObjectURL(url); }).catch(function (error) { status.textContent = error.message; });
    }
    function load(resetPaging) {
        applyScope(scope); candidatePanel.hidden = true; setStatus('Loading inventory…', 'info');
        fetchSummary().then(function () { templatesTable.ajax.reload(null, resetPaging === true); usagesTable.ajax.reload(null, resetPaging === true); setStatus('Inventory loaded. Tables support search, sorting, and paging.', 'success'); }).catch(function (error) { setStatus(error.message, 'danger'); summary.innerHTML = ''; });
    }
    function adjustTables() { if (templatesTable) templatesTable.columns.adjust(); if (usagesTable) usagesTable.columns.adjust(); }
    function activateTab(name) { tabs.forEach(function (tab) { var active = tab.getAttribute('data-template-usage-tab') === name; tab.classList.toggle('active', active); tab.setAttribute('aria-selected', active ? 'true' : 'false'); tab.setAttribute('tabindex', active ? '0' : '-1'); }); state.tab = name; saveState(); window.setTimeout(adjustTables, 0); }
    tabs.forEach(function (tab) { tab.addEventListener('shown.bs.tab', function () { activateTab(tab.getAttribute('data-template-usage-tab')); }); tab.addEventListener('click', function () { activateTab(tab.getAttribute('data-template-usage-tab')); }); });
    sourceSelect.addEventListener('change', function () { state.source = sourceSelect.value; saveState(); templatesTable.page(0).ajax.reload(null, false); }); statusSelect.addEventListener('change', function () { state.status = statusSelect.value; saveState(); templatesTable.page(0).ajax.reload(null, false); });
    scopeSelect.addEventListener('change', function () { applyScope(scopeSelect.value); load(true); }); root.querySelector('[data-template-usage-refresh]').addEventListener('click', function () { load(false); }); root.querySelector('[data-template-usage-candidates]').addEventListener('click', loadCandidates); root.querySelector('[data-template-usage-export]').addEventListener('click', function () { exportReport('inventory', 'opencontent-template-inventory.csv'); }); root.querySelector('[data-template-usage-candidate-export]').addEventListener('click', function () { exportReport('candidates', 'opencontent-template-cleanup-candidates.csv'); });
    readState(); initTooltips(); fetchScopeOptions().catch(function () { scopeControl.hidden = true; applyScope('current'); }).then(function () { initTables(); if (state.tab === 'usages' && window.bootstrap && window.bootstrap.Tab) { window.bootstrap.Tab.getOrCreateInstance(tabs[1]).show(); } load(false); });
}());
</script>

